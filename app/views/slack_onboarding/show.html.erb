<%# The way into the Patchwork Labs Slack (slack.patchworklabs.org redirects here).
    @step is the next thing this person must do; see User#slack_onboarding_step. %>
<% content_for :title, "Join the Slack" %>
<%
  steps = [
    [:sign_up, "Create your Weave account"],
    ([:add_birthday, t("birthday.step_label")] if @step == :add_birthday),
    ([:under_minimum_age, t("birthday.under_minimum_age_title")] if @step == :under_minimum_age),
    ([:guardian_consent, "Get consent from a parent or guardian"] if current_user&.minor?),
    [:request_invite, "Get your Slack invite"],
    [:accept_invite, "Accept the invite from Slack"],
    [:accept_code_of_conduct, "Accept the Code of Conduct"],
    [:member, "You're a full member"]
  ].compact
  # awaiting_promotion is the Code of Conduct step, finishing up.
  current_index = steps.index { |key, _| key == (@step == :awaiting_promotion ? :accept_code_of_conduct : @step) }
  consent = current_user.current_guardian_consent if @step == :guardian_consent
%>

<%# While the next step can happen in Slack, check now and then and reload
    when it does. %>
<%= tag.div class: "min-h-full flex items-center justify-center p-6",
      data: (if current_user && %i[guardian_consent accept_invite accept_code_of_conduct awaiting_promotion].include?(@step)
               { controller: "onboarding-status", onboarding_status_url_value: status_slack_onboarding_path, onboarding_status_step_value: @step }
             end) do %>
  <div class="patch patch-bound patch-tilt-r w-full max-w-lg">
    <div class="quilt-binding"></div>
    <div class="p-8 sm:p-9 space-y-6">
      <div class="text-center space-y-2">
        <%= render "shared/wordmark", size: :lg, href: nil %>
        <h1 class="font-display text-2xl font-bold text-ink">Join the Patchwork Labs Slack</h1>
        <p class="text-ink-soft text-sm">The Slack is where the community lives. Here's how to get in.</p>
      </div>

      <ol class="steps" aria-label="Steps to join the Slack">
        <% steps.each_with_index do |(_key, label), index| %>
          <% state = index < current_index ? :done : (index == current_index ? :current : :todo) %>
          <%= tag.li class: ["step", ("is-done" if state == :done), ("is-current" if state == :current)],
                aria: { current: ("step" if state == :current) } do %>
            <span class="step-marker">
              <%= state == :done ? icon(:check, size: 14) : index + 1 %>
            </span>
            <span><%= label %></span>
          <% end %>
        <% end %>
      </ol>

      <div class="well space-y-4 text-center">
        <% case @step %>
        <% when :sign_up %>
          <p class="text-sm text-ink">
            Membership starts with a Weave account. Sign up with your email and
            we'll send your Slack invite as soon as you confirm it.
          </p>
          <%= link_to "Request an invite", signup_path, class: "btn btn-primary btn-block" %>
          <p class="text-sm text-ink-soft">
            Already have an account? <%= link_to "Sign in", login_path, class: "link" %>
          </p>

        <% when :add_birthday %>
          <p class="text-sm text-ink"><%= t("birthday.intro") %></p>
          <%= form_with url: birthday_path, method: :post, class: "space-y-4 text-left" do |form| %>
            <div class="field-group">
              <%= form.label :birthday, t("birthday.label"), class: "field-label" %>
              <%= form.date_field :birthday, value: params[:birthday].presence || current_user.slack_birthday,
                    required: true, max: Date.current, autocomplete: "bday",
                    aria: { describedby: "birthday_hint", invalid: (true if @form_errors&.key?(:birthday)) },
                    class: "field" %>
              <p id="birthday_hint" class="field-hint"><%= t("birthday.once", email: Weave.mail_address) %></p>
              <% if @form_errors&.key?(:birthday) %>
                <p class="field-error"><%= @form_errors[:birthday] %></p>
              <% end %>
            </div>
            <%= form.submit t("birthday.submit"), class: "btn btn-primary btn-block" %>
          <% end %>

        <% when :under_minimum_age %>
          <p class="text-sm text-ink"><%= t("birthday.under_minimum_age", email: Weave.mail_address) %></p>

        <% when :guardian_consent %>
          <% if consent&.pending? && params[:change].blank? && @form_errors.blank? %>
            <p class="text-sm text-ink">
              <%= t("guardian_consent.form.pending", email: consent.guardian_email) %>
            </p>
            <p class="text-sm text-ink-faint"><%= t("guardian_consent.form.pending_hint") %></p>
            <%= button_to t("guardian_consent.form.resend"), resend_guardian_consent_request_path,
                  class: "btn btn-secondary btn-block" %>
            <p class="text-sm">
              <%= link_to t("guardian_consent.form.change"), slack_onboarding_path(change: 1), class: "link" %>
            </p>
          <% else %>
            <p class="text-sm text-ink"><%= t("guardian_consent.form.intro") %></p>
            <p class="text-sm text-ink-soft"><%= t("guardian_consent.form.honesty") %></p>
            <p class="text-sm"><%= link_to t("data_handling.data_page_link"), Weave.data_page_url, target: "_blank", rel: "noopener noreferrer", class: "text-grape underline decoration-dashed underline-offset-2" %></p>
            <%= form_with url: guardian_consent_request_path, method: :post, class: "space-y-4 text-left" do |form| %>
              <% [[:guardian_name, :text_field], [:guardian_email, :email_field]].each do |field, input| %>
                <div class="field-group">
                  <%= form.label field, t("guardian_consent.form.#{field}"), class: "field-label" %>
                  <%= form.public_send input, field, value: params[field], required: true, maxlength: 100, autocomplete: "off",
                        aria: { describedby: ("guardian_email_hint" if field == :guardian_email), invalid: (true if @form_errors&.key?(field)) },
                        class: "field" %>
                  <% if field == :guardian_email %>
                    <p id="guardian_email_hint" class="field-hint"><%= t("guardian_consent.form.guardian_email_hint") %></p>
                  <% end %>
                  <% if @form_errors&.key?(field) %>
                    <p class="field-error"><%= @form_errors[field] %></p>
                  <% end %>
                </div>
              <% end %>
              <%= form.submit t("guardian_consent.form.submit"), class: "btn btn-primary btn-block" %>
            <% end %>
          <% end %>

        <% when :request_invite %>
          <p class="text-sm text-ink">
            We'll invite <strong class="break-all"><%= current_user.email %></strong> to the Slack.
          </p>
          <%= button_to "Send my invite", slack_onboarding_path, class: "btn btn-primary btn-block" %>

        <% when :accept_invite %>
          <p class="text-sm text-ink">
            Slack sent an invite to <strong class="break-all"><%= current_user.email %></strong>.
            Open it and join the workspace. This page moves on once you're in.
          </p>
          <p class="text-sm text-ink-faint">Can't find it? Check your spam folder first.</p>
          <%= button_to "Resend my invite", slack_onboarding_path, class: "btn btn-secondary btn-block" %>

        <% when :accept_code_of_conduct %>
          <% if current_user.slack_member? %>
            <p class="text-sm text-ink">
              Everyone in the Patchwork Labs Slack now accepts our Code of Conduct.
              Please read it and accept it here.
            </p>
          <% else %>
            <p class="text-sm text-ink">
              You're in the Slack as a guest. To get full access, accept our Code of
              Conduct. We sent it to you as a Slack DM, or you can accept it here.
            </p>
          <% end %>
          <% if SlackService.code_of_conduct_url.present? %>
            <p class="text-sm">
              <%= link_to "Read the Code of Conduct", SlackService.code_of_conduct_url,
                    target: "_blank", rel: "noopener noreferrer", class: "link" %>
            </p>
          <% end %>
          <%= form_with url: accept_code_of_conduct_slack_onboarding_path, method: :post, class: "space-y-4 text-left" do |form| %>
            <% if current_user.name_missing? %>
              <p class="text-sm text-ink"><%= t("code_of_conduct_form.name_why") %></p>
              <% CodeOfConductSlackViews::NAME_FIELDS.each do |field, options| %>
                <div class="field-group">
                  <%= form.label field, "#{options[:label]}#{' (optional)' if options[:optional]}", class: "field-label" %>
                  <%= form.text_field field, value: params[field], required: !options[:optional], maxlength: options.fetch(:max_length, 100),
                        autocomplete: { first_name: "given-name", last_name: "family-name", slack_name: "nickname" }.fetch(field, "off"),
                        aria: { describedby: "#{options.fetch(:hint_for, field)}_hint", invalid: (true if @form_errors&.key?(field)) },
                        class: "field" %>
                  <% if options[:hint] %>
                    <p id="<%= field %>_hint" class="field-hint"><%= t("code_of_conduct_form.#{options[:hint]}") %></p>
                  <% end %>
                  <% if @form_errors&.key?(field) %>
                    <p class="field-error"><%= @form_errors[field] %></p>
                  <% end %>
                </div>
              <% end %>
            <% end %>
            <div class="field-group">
              <label class="choice">
                <%= check_box_tag :accept, "1", params[:accept] == "1", required: true, class: "checkbox" %>
                <span><%= t("code_of_conduct_form.accept_label") %></span>
              </label>
              <% if @form_errors&.key?(:accept) %>
                <p class="field-error"><%= @form_errors[:accept] %></p>
              <% end %>
            </div>
            <%= form.submit "I accept the Code of Conduct", class: "btn btn-primary btn-block" %>
            <div class="text-xs text-ink-faint">
              <p class="font-semibold"><%= t("code_of_conduct_form.data_use_title") %></p>
              <p class="mt-1"><%= t("code_of_conduct_form.data_use") %></p>
            </div>
          <% end %>

        <% when :awaiting_promotion %>
          <p class="text-sm text-ink">
            You accepted the Code of Conduct. We're upgrading your Slack account to
            full access. This usually takes a few seconds, so refresh the page soon.
          </p>
          <%= button_to "Try again", accept_code_of_conduct_slack_onboarding_path,
                class: "btn btn-secondary btn-block" %>

        <% when :member %>
          <p class="text-sm text-ink">You're a full member of the Patchwork Labs Slack. Welcome!</p>
          <% if SlackService.workspace_url.present? %>
            <%= link_to SlackService.workspace_url, class: "btn btn-primary btn-block" do %>
              <%= icon(:external_link) %>Open Slack
            <% end %>
          <% end %>
        <% end %>
      </div>

      <% if current_user %>
        <p class="text-center text-sm">
          <%= link_to "Go to your account", profile_path, class: "link" %>
        </p>
      <% end %>
    </div>
  </div>
<% end %>

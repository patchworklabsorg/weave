<%# The member's data export page (see TakeoutsController). %>
<% content_for :title, t("data_handling.takeout.title") %>

<div class="page page-narrow space-y-6">
  <%= page_header(t("data_handling.takeout.title"), lede: t("data_handling.takeout.intro")) %>

  <section class="card">
    <div class="card-body space-y-4 text-sm text-ink">
      <p><%= t("data_handling.takeout.download_window", days: DataRetention.takeout_download_window.in_days.to_i) %></p>
      <p class="text-ink-soft"><%= t("data_handling.takeout.not_included") %></p>
      <p>
        <%= link_to t("data_handling.data_page_link"), Weave.data_page_url, class: "link", target: "_blank", rel: "noopener noreferrer" %>
      </p>
      <%= button_to takeout_path, method: :post, class: "btn btn-primary btn-block" do %>
        <%= icon(:download) %><%= t("data_handling.takeout.button") %>
      <% end %>
    </div>
  </section>

  <% if @takeouts.any? %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title"><%= t("data_handling.takeout.history") %></h2>
      </div>
      <div class="card-body">
        <div class="record-list">
          <% @takeouts.each do |takeout| %>
            <div class="record flex-wrap">
              <div class="record-main">
                <div class="record-title"><%= time_label(takeout.created_at) %></div>
                <div class="record-meta"><%= t("data_handling.takeout.statuses.#{takeout.status}", date: takeout.expires_at&.to_date&.strftime(TimeHelper::FORMATS[:date])) %></div>
              </div>
              <% if takeout.downloadable? %>
                <div class="record-actions">
                  <%= link_to t("data_handling.takeout.download"), download_takeout_path(takeout), class: "btn btn-secondary btn-sm" %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <p class="text-sm text-center"><%= link_to t("data_handling.profile.delete"), deletion_request_path, class: "link" %></p>
</div>

<% content_for :title, "Confirm your email" %>
<%# The landing page for anyone signed in but not yet confirmed.
    ApplicationController#authenticate_user! sends every such request here, so
    without this template the app answers 406 to *every* page — including this
    one — and an unconfirmed account is locked out with nothing to act on. %>
<div class="min-h-full flex items-center justify-center p-6">
  <div class="patch patch-bound patch-tilt-l w-full max-w-md">
    <div class="quilt-binding"></div>
    <div class="p-8 sm:p-9 space-y-6">
      <div class="text-center space-y-2">
        <%= render "shared/wordmark", size: :lg, href: nil %>
        <h1 class="font-display text-2xl font-bold text-ink">Confirm your email</h1>
        <p class="text-ink-soft text-sm">One more step before you can use Weave.</p>
      </div>

      <div class="callout callout-grape">
        <%= icon(:mail, size: 18) %>
        <div class="callout-body">
          <p>
            We sent a confirmation link to
            <strong class="break-all"><%= @user.email %></strong>.
            Open it and you'll be signed in and ready to go.
          </p>
        </div>
      </div>

      <p class="text-sm text-ink-faint text-center">
        Can't find it? Check your spam folder before asking for another.
      </p>

      <%= render "resend_section", user: @user %>

      <div class="text-center text-sm">
        <%= button_to "Sign out",
              logout_path,
              method: :delete,
              class: "link cursor-pointer" %>
      </div>
    </div>
  </div>
</div>

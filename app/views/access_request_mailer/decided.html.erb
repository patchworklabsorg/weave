<% if @request.approved? %>
  <h2 style="margin: 0 0 16px 0; color: #2a2050; font-size: 20px; font-weight: 700;">You have access to <%= @application.name %></h2>
<% else %>
  <h2 style="margin: 0 0 16px 0; color: #2a2050; font-size: 20px; font-weight: 700;">Your access request was not approved</h2>
<% end %>

<p style="margin: 0 0 16px 0; color: #2a2050;">Hi <%= @user.first_name %>,</p>

<% if @request.approved? %>
  <p style="margin: 0 0 16px 0; color: #2a2050;">Your request for access to <strong><%= @application.name %></strong> was approved. Sign in to the app with your Patchwork Labs account.</p>
<% else %>
  <p style="margin: 0 0 16px 0; color: #2a2050;">Your request for access to <strong><%= @application.name %></strong> was not approved. If you think this is a mistake, reply to this email.</p>
<% end %>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 8px 0 24px 0;">
  <tr>
    <td style="border-radius: 8px; background-color: #6c3ec1;">
      <a href="<%= @profile_url %>" style="display: inline-block; padding: 12px 28px; background-color: #6c3ec1; color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 700; font-size: 15px; font-family: 'Geist', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
        Go to your apps
      </a>
    </td>
  </tr>
</table>

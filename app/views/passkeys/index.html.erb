<% content_for :title, "Passkeys" %>

<div class="page page-narrow space-y-6">
  <%= page_header("Passkeys", lede: "Sign in with your fingerprint, face, or device PIN instead of an email link.") %>

  <section class="card">
    <div class="card-header">
      <div>
        <h2 class="card-title">Add a passkey</h2>
        <p class="card-lede">
          Your device or password manager keeps the passkey. You can add one for each device you use.
          Email links still work if you lose a passkey.
        </p>
      </div>
    </div>
    <div class="card-body">
      <% if impersonating? %>
        <p class="text-sm text-ink-faint">You can't add passkeys while impersonating a user.</p>
      <% else %>
        <%= form_with url: passkeys_path, method: :post, local: true,
              data: { turbo: false, controller: "passkey-register", passkey_register_options_url_value: options_passkeys_path, action: "submit->passkey-register#register:prevent" },
              class: "space-y-4" do %>
          <%= hidden_field_tag :credential, "", data: { passkey_register_target: "credential" } %>

          <div class="field-group">
            <%= label_tag :nickname, class: "field-label" do %>
              Name <span class="optional">(optional)</span>
            <% end %>
            <%= text_field_tag :nickname, nil,
                  maxlength: User::Passkey::NICKNAME_MAX_LENGTH,
                  placeholder: "For example: Work laptop",
                  autocomplete: "off",
                  class: "field" %>
          </div>

          <p class="field-error" role="alert" data-passkey-register-target="error" hidden></p>
          <p class="field-hint" data-passkey-register-target="unsupported" hidden>
            This browser can't make passkeys. Try a recent version of Safari, Chrome, Edge, or Firefox.
          </p>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary" data-passkey-register-target="button">
              <%= icon(:fingerprint) %>Add a passkey
            </button>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Your passkeys</h2>
    </div>
    <% if @passkeys.any? %>
      <div class="card-body">
        <div class="record-list">
          <% @passkeys.each do |passkey| %>
            <div class="record">
              <div class="record-main">
                <div class="record-title flex flex-wrap items-center gap-2">
                  <span class="min-w-0 break-words"><%= passkey.display_name %></span>
                  <%= badge("Turned off", tone: :danger) if passkey.compromised? %>
                </div>
                <div class="record-meta">
                  Added <%= time_label(passkey.created_at) %> ·
                  <% if passkey.last_used_at %>last used <%= time_label(passkey.last_used_at, :relative) %><% else %>not used yet<% end %>
                </div>
                <% if passkey.compromised? %>
                  <div class="callout callout-warning mt-2">
                    <%= icon(:triangle_alert, size: 18) %>
                    <div class="callout-body">
                      <p>This passkey may have been copied, so it can't sign in. Remove it and add a new one.</p>
                    </div>
                  </div>
                <% end %>
              </div>
              <% unless impersonating? %>
                <div class="record-actions">
                  <%= button_to "Remove", passkey_path(passkey), method: :delete,
                        class: "btn btn-danger btn-sm",
                        data: { turbo_confirm: "Remove this passkey? It will no longer sign in to your account." } %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <%= empty_state("No passkeys yet", body: "Add one above to sign in without an email link.", icon: :fingerprint) %>

    <% end %>
  </section>
</div>

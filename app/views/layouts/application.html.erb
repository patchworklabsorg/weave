<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [content_for(:title), "Weave"].compact_blank.join(" · ") %></title>
    <link rel="canonical" href="<%= Weave.url %>/">
    <%= render "shared/head" %>
  </head>

  <body class="bg-quilt text-ink font-sans min-h-dvh flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <%= render "shared/staging_badge" %>
    <%= render "shared/impersonation_banner" %>
    <%= render "shared/topbar" %>

    <main id="main" class="flex-1" tabindex="-1">

      <%= yield %>
    </main>

    <footer class="page pt-0 pb-8 text-xs text-ink-faint flex flex-wrap gap-x-4 gap-y-1" data-testid="data-footer">
      <span>Weave is the Patchwork Labs identity provider.</span>
      <span><%= t("data_handling.footer") %></span>
      <%= link_to t("data_handling.data_page_link"), Weave.data_page_url, class: "link-quiet", target: "_blank", rel: "noopener noreferrer" %>
      <a href="https://github.com/patchworklabsorg/weave" class="link-quiet" target="_blank" rel="noopener noreferrer">Source</a>
      <a href="mailto:security@patchworklabs.org" class="link-quiet">Report a security issue</a>
    </footer>

    <div id="flash"><%= render "shared/flash" %></div>
    <%= render "shared/command_bar" %>
  </body>
</html>

<%# The focus layout: one centered patch on the quilt. Sign in, sign up,
    confirmations, consent and onboarding render here. %>
<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= [content_for(:title), "Weave"].compact_blank.join(" · ") %></title>
    <%= render "shared/head" %>
    <%# defer: the fingerprint controller waits for it (see fingerprint_controller.js). %>
    <script src="https://cdn.jsdelivr.net/npm/@fingerprintjs/fingerprintjs@4/dist/fp.min.js" defer></script>
  </head>

  <body class="h-full quilt-bg text-ink font-sans">
    <a href="#main" class="skip-link">Skip to content</a>
    <%= render "shared/staging_badge" %>
    <%# Gate pages (email confirmation, birthday, consent) render here, so an
        admin who impersonates a member stopped at a gate needs the way out too. %>
    <%= render "shared/impersonation_banner" %>
    <div id="flash"><%= render "shared/flash" %></div>

    <main id="main" class="focus-main relative" tabindex="-1">

      <%= yield %>
    </main>

    <%= render "shared/data_footer" %>

    <%= render "shared/theme_toggle", floating: true %>
  </body>
</html>

<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#2F2F2F" />
    <meta name="msapplication-TileColor" content="#2F2F2F" />
    <meta name="apple-mobile-web-app-title" content="Weave Admin" />
    <meta name="application-name" content="Weave Admin" />
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <title><%= content_for(:title) || "Admin" %> - Weave</title>

    <%= yield :head %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Brand fonts (Geist + Shantell Sans) are self-hosted and declared via
        @font-face in the compiled Tailwind stylesheet below — no external link. %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style nonce="<%= content_security_policy_nonce %>">
      body {
        background-color: #f7f5fb; /* quilt paper — matches patchworklabs.org */
        margin: 0;
        padding: 0;
        min-height: 100vh;
      }

      .gradient-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
      }

      .admin-container {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: 80vh;
        padding: 10px;
        position: relative;
      }

      .admin-card {
        background: rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-radius: 20px;
        border: 1px solid rgba(199, 183, 226, 0.4);
        box-shadow: 0 8px 32px rgba(108, 62, 193, 0.15);
        width: 100%;
        max-width: 1200px;
        margin-top: 20px;
        overflow: hidden;
      }

      .admin-header {
        background: linear-gradient(135deg, rgba(199, 183, 226, 0.3) 0%, rgba(255, 255, 255, 0.5) 100%);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        color: #2a2050;
        padding: 20px 30px;
        border-bottom: 1px solid rgba(199, 183, 226, 0.4);
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.5);
      }

      .admin-nav {
        background: rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        border-bottom: 2px solid rgba(199, 183, 226, 0.3);
        padding: 0;
      }

      .admin-nav-list {
        display: flex;
        flex-wrap: wrap;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .admin-nav-item {
        margin: 0;
        border-right: 1px solid rgba(199, 183, 226, 0.4);
      }

      .admin-nav-item:first-child {
        border-left: 2px solid transparent;
        border-color: rgba(199, 183, 226, 0.4);
      }

      .admin-nav-item:last-child {
        border-right: 2px solid transparent;
        border-color: rgba(199, 183, 226, 0.4);
      }

      .admin-nav-link {
        display: block;
        padding: 12px 24px;
        color: #2a2050;
        text-decoration: none;
        border-bottom: 3px solid transparent;
        transition: all 0.3s ease;
        font-weight: 500;
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.2);
        position: relative;
      }

      .admin-nav-link::after {
        content: '';
        position: absolute;
        right: 0;
        top: 10%;
        height: 80%;
        width: 1px;
        background: rgba(199, 183, 226, 0.3);
        transition: all 0.3s ease;
      }

      .admin-nav-item:last-child .admin-nav-link::after {
        display: none;
      }

      .admin-nav-link:hover,
      .admin-nav-link.active {
        color: #2a2050;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.8) 0%, rgba(199, 183, 226, 0.1) 100%);
        border-bottom-color: #6c3ec1;
        box-shadow: 0 2px 8px rgba(108, 62, 193, 0.1);
      }

      .admin-nav-link:hover::after,
      .admin-nav-link.active::after {
        background: rgba(199, 183, 226, 0.5);
        box-shadow: 0 0 4px rgba(108, 62, 193, 0.2);
      }

      .admin-content {
        padding: 30px;
        background: rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
        color: #2a2050;
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.5);
      }

      /* Make content elements more readable on glass background */
      .admin-content h1,
      .admin-content h2,
      .admin-content h3,
      .admin-content h4,
      .admin-content h5,
      .admin-content h6 {
        color: #2a2050;
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.7);
      }

      .admin-content table {
        background: rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.5);
        overflow: hidden;
      }

      .admin-content th {
        background: rgba(255, 255, 255, 0.5);
        color: #2a2050;
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.7);
        font-weight: 700;
      }

      .admin-content td {
        color: #2a2050;
        border-color: rgba(255, 255, 255, 0.3);
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.5);
      }

      /* Semantic status colors (red=error, orange=warning) are kept for legibility;
         success/neutral badges use the quilt soft-pill tokens directly and don't
         need an override since they already render as solid pastels. */
      .admin-content .text-red-600 {
        color: #dc2626 !important;
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.5);
        font-weight: 600;
      }

      .admin-content .text-orange-600 {
        color: #ea580c !important;
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.5);
        font-weight: 600;
      }

      /* Improved button styling for glass effect */
      .glass-button {
        background: rgba(255, 255, 255, 0.4) !important;
        backdrop-filter: blur(5px) !important;
        -webkit-backdrop-filter: blur(5px) !important;
        border: 2px solid #6c3ec1 !important;
        color: #2a2050 !important;
        text-shadow: 0 1px 2px rgba(255, 255, 255, 0.7) !important;
        transition: all 0.3s ease !important;
        position: relative !important;
        z-index: 10 !important;
        font-weight: 600 !important;
      }

      .glass-button:hover {
        background: linear-gradient(135deg, #6c3ec1 0%, #2a2050 100%) !important;
        border-color: #c7b7e2 !important;
        transform: translateY(-1px) !important;
        box-shadow: 0 6px 16px rgba(108, 62, 193, 0.3) !important;
        color: #fefdff !important;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2) !important;
      }

      .admin-user-info {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
      }

      .admin-user-details {
        flex: 1;
      }

      .admin-user-name {
        font-size: 18px;
        font-weight: 600;
        margin: 0;
      }

      .admin-user-role {
        font-size: 14px;
        opacity: 0.9;
        margin: 0;
      }

      @media (max-width: 768px) {
        .admin-container {
          padding: 10px;
        }

        .admin-card {
          margin-top: 10px;
        }

        .admin-header {
          padding: 15px 20px;
        }

        .admin-content {
          padding: 20px;
        }
      }
    </style>
  </head>

  <body class="quilt-bg text-ink font-sans">
    <div class="gradient-overlay"></div>

    <% if Rails.env.staging? %>
      <div class="bg-red-600 text-white text-center py-2 fixed top-0 left-0 w-full z-50">
        <strong>STAGING ENVIRONMENT</strong> - Do not use for production
      </div>
    <% end %>

    <% if impersonating? %>
      <div class="bg-orange-500 text-white text-center py-2 px-4 flex items-center justify-between fixed top-0 left-0 w-full z-40" style="<%= Rails.env.staging? ? 'top: 48px;' : '' %>">
        <div class="flex-1 text-center">
          <strong>⚠️ IMPERSONATING:</strong> You are impersonating <%= current_user.full_name %>
          (logged in as <%= admin_user.full_name %>)
        </div>
        <%= button_to "Stop Impersonating", stop_impersonating_admin_users_path,
            method: :delete,
            class: "bg-orange-600 hover:bg-orange-700 text-white px-4 py-1 rounded text-sm",
            form: { class: "inline" } %>
      </div>
    <% end %>

    <div class="admin-container" style="<%= (Rails.env.staging? || impersonating?) ? 'padding-top: 60px;' : '' %>">
      <div class="admin-card">
        <!-- Header -->
        <div class="admin-header">
          <div class="admin-user-info">
            <div class="admin-user-details">
              <h1 class="admin-user-name">Weave Admin</h1>
              <p class="admin-user-role">Logged in as <%= current_user.full_name %> (<%= current_user.role.titleize %>)</p>
            </div>
            <div>
              <% if impersonating? %>
                <%= button_to "Stop Impersonating", stop_impersonating_admin_users_path,
                    method: :delete,
                    class: "glass-button px-4 py-2 rounded text-sm cursor-pointer" %>
              <% else %>
                <%= button_to "Sign Out", logout_path,
                    method: :delete,
                    form_class: "inline-block",
                    class: "glass-button px-4 py-2 rounded text-sm cursor-pointer" %>
              <% end %>
            </div>

            <%# link back to user pages (home) %>
            <%= link_to "Back to User Pages", root_path,
                class: "glass-button px-4 py-2 rounded text-sm cursor-pointer" %>

          </div>
        </div>

        <!-- Navigation -->
        <nav class="admin-nav">
          <ul class="admin-nav-list">
            <li class="admin-nav-item">
              <%= link_to admin_root_path,
                  class: "admin-nav-link #{controller_name == 'dashboard' ? 'active' : ''}" do %>
                Dashboard
              <% end %>
            </li>
            <li class="admin-nav-item">
              <%= link_to admin_users_path,
                  class: "admin-nav-link #{controller_name == 'users' ? 'active' : ''}" do %>
                Users
              <% end %>
            </li>
            <li class="admin-nav-item">
              <%= link_to admin_oauth_applications_path,
                  class: "admin-nav-link #{controller_name == 'oauth_applications' ? 'active' : ''}" do %>
                OAuth Apps
              <% end %>
            </li>
            <li class="admin-nav-item">
              <%= link_to '/admin/jobs',
                  class: "admin-nav-link #{controller_name == 'jobs' ? 'active' : ''}" do %>
                Jobs
              <% end %>
            </li>
            <li class="admin-nav-item">
              <%= link_to '/admin/flipper',
                  class: "admin-nav-link #{controller_name == 'flipper' ? 'active' : ''}" do %>
                Flipper
              <% end %>
            </li>
            <li class="admin-nav-item">
              <%= link_to '/admin/blazer',
                  class: "admin-nav-link #{controller_name == 'blazer' ? 'active' : ''}" do %>
                Blazer
              <% end %>
            </li>
            <li class="admin-nav-item">
              <%= link_to '/admin/console',
                  class: "admin-nav-link #{controller_name == 'console' ? 'active' : ''}" do %>
                Console Audits
              <% end %>
            </li>

          </ul>
        </nav>

        <!-- Main Content -->
        <div class="admin-content">
          <%= yield %>
        </div>
      </div>
    </div>

    <%= render 'shared/flash' %>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [content_for(:title), "Admin", "Weave"].compact_blank.join(" · ") %></title>
    <meta name="robots" content="noindex">
    <%= render "shared/head" %>
  </head>

  <body class="bg-quilt text-ink font-sans">
    <a href="#main" class="skip-link">Skip to content</a>
    <%= render "shared/staging_badge" %>

    <div class="admin-shell" data-controller="drawer" data-action="keydown@window->drawer#keydown">
      <%= render "shared/sidebar" %>
      <div class="sidebar-scrim" data-drawer-target="scrim" data-action="click->drawer#close" aria-hidden="true"></div>

      <%# data-drawer-target="content" goes inert while the drawer is open. %>
      <div class="admin-main" data-drawer-target="content">
        <%= render "shared/impersonation_banner" %>

        <header class="admin-topbar">
          <button type="button" class="btn btn-quiet btn-sm btn-icon sidebar-menu-btn" aria-label="Open navigation" aria-expanded="false"
                  data-drawer-target="button" data-action="drawer#toggle">
            <%= icon(:menu, size: 18) %>
          </button>
          <div class="admin-topbar-crumb">
            <%= link_to (controller_path.start_with?("identity/") ? "Identity" : "Admin"), admin_home_path, class: "link-quiet" %>
            <% if content_for?(:title) %>
              <span class="mx-1 text-ink-faint">/</span>
              <strong><%= content_for(:title) %></strong>
            <% end %>
          </div>
          <div class="admin-topbar-end">
            <button type="button" class="cmdk-trigger" data-command-bar-trigger aria-label="Search users, groups and apps, or jump to a page">
              <%= icon(:search) %>
              <span class="cmdk-trigger-label">Search or jump to…</span>
              <span class="kbd">⌘K</span>
            </button>
            <%= render "shared/theme_toggle" %>
          </div>
        </header>

        <main id="main" class="page page-wide" tabindex="-1">

          <%= yield %>
        </main>
        <%= render "shared/data_footer" %>
      </div>
    </div>

    <div id="flash"><%= render "shared/flash" %></div>
    <%= render "shared/command_bar" %>
  </body>
</html>

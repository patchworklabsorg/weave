<%# Doorkeeper's consent, code and error pages: the same focus layout as sessions. %>
<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= [content_for(:title) || "Authorize", "Weave"].compact_blank.join(" · ") %></title>
    <%= render "shared/head" %>
  </head>

  <body class="h-full quilt-bg text-ink font-sans">
    <%= render "shared/staging_badge" %>
    <%= render "shared/flash" %>

    <main class="h-full relative">
      <%= yield %>
    </main>

    <%= render "shared/theme_toggle", floating: true %>
  </body>
</html>

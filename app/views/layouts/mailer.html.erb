<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      /* Email styles need to be inline */
    </style>
  </head>

  <body>
    <%= yield %>

    <hr style="margin: 2em 0; border: none; border-top: 1px solid #ddd;">
    <p style="color: #666; font-size: 0.875em; font-style: italic;">
      Please note: This email is sent from an automated system. We do not actively monitor replies to this address.
      If you need assistance, please visit our support resources.
    </p>
  </body>
</html>

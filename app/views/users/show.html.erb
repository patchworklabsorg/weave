<% content_for :title, "Your account" %>

<div class="page">
  <% if @user.onboarding_pending? %>
    <div class="callout callout-grape mb-6 items-center">
      <%= icon(:sparkles, size: 18) %>
      <div class="callout-body">
        <% if @user.birthday.nil? %>
          <p class="callout-title"><%= t("birthday.banner_title") %></p>
          <p><%= t("birthday.banner_body") %></p>
        <% elsif @user.guardian_consent_missing? %>
          <p class="callout-title"><%= t("guardian_consent.form.title") %></p>
          <p><%= t("guardian_consent.form.intro") %></p>
        <% elsif @user.slack_member? %>
          <p class="callout-title">Accept the Code of Conduct</p>
          <p>Everyone in the Patchwork Labs Slack now accepts the Code of Conduct. It takes a few seconds.</p>
        <% else %>
          <p class="callout-title">Finish joining the Patchwork Labs Slack</p>
          <p>You become a full member once you're in the Slack and have accepted the Code of Conduct.</p>
        <% end %>
      </div>
      <%= link_to "Continue", slack_onboarding_path, class: "btn btn-primary btn-sm shrink-0" %>
    </div>
  <% end %>

  <%# page_header markup by hand: the avatar and badges sit inside the heading. %>
  <header class="page-header">
    <div class="flex items-center gap-4 min-w-0">
      <%= avatar(@user, size: :xl) %>
      <div class="min-w-0">
        <h1 class="page-title"><%= @user.full_name %></h1>
        <div class="flex flex-wrap items-center gap-2 mt-2">
          <%= badge(@user.community_member? ? "Community member" : @user.role.humanize, tone: :grape) %>
          <%= badge("Board", tone: :teal) if @user.is_board? %>
          <%= badge("Staff", tone: :sky) if @user.is_staff? %>
          <%= badge("Contractor", tone: :violet) if @user.is_contractor? %>
          <% if @user.email_verified? %>
            <%= badge("Email verified", tone: :success) %>
          <% else %>
            <%= badge("Email unverified", tone: :warning) %>
          <% end %>
        </div>
        <% if @user.slack_title.present? %>
          <p class="page-lede"><%= @user.slack_title %></p>
        <% end %>
      </div>
    </div>
    <div class="page-actions">
      <%= link_to edit_profile_path, class: "btn btn-primary" do %>
        <%= icon(:pencil) %>Edit profile
      <% end %>
    </div>
  </header>

  <%# Identity verification gates program resources only, never the community. %>
  <section class="card mb-6">
    <div class="card-header">
      <div class="min-w-0 flex-1">
        <h2 class="card-title flex flex-wrap items-center gap-2">
          <%= t("verification.page.title") %>
          <%= badge(t("verification.statuses.#{@user.verification_status}"), tone: @user.verification_status == "verified" ? :success : :grape) %>
        </h2>
        <p class="card-lede">
          <%= t("verification.page.intro") %>
          <%= link_to t("verification.data_page_link"), Weave.data_page_url, class: "link", target: "_blank", rel: "noopener" %>
        </p>
      </div>
      <%= link_to verification_path, class: "btn btn-secondary shrink-0" do %>
        <%= icon(:id_card) %><%= t("verification.page.title") %>
      <% end %>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Account</h2>
      </div>
      <div class="card-body">
        <dl class="dl">
          <%= dl_row "Weave ID", @user.p_id %>
          <%= dl_row "Email", @user.email %>
          <% if @user.phone_number.present? || @user.slack_phone.present? %>
            <%= dl_row "Phone", @user.phone_number.presence || @user.slack_phone %>
          <% end %>
          <% if @user.pronouns.present? %>
            <%= dl_row "Pronouns", @user.pronouns %>
          <% end %>
          <% if @user.birthday.present? %>
            <%= dl_row "Birthday", @user.birthday.strftime("%B %-d") %>
          <% end %>
          <%= dl_row "Member since", @user.created_at.strftime("%B %-d, %Y") %>
          <%= dl_row "Active sessions", @user.user_sessions.not_expired.count %>
        </dl>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Community profile</h2>
      </div>
      <div class="card-body">
        <% if @user.slack_id.present? %>
          <% dept = [@user.slack_department, @user.slack_division, @user.slack_organization].compact_blank.join(" · ") %>
          <% location = [@user.slack_city, @user.slack_state, @user.slack_country].compact_blank.join(", ") %>
          <% links = { "Website" => @user.slack_website, "GitHub" => @user.slack_github, "LinkedIn" => @user.slack_linkedin }.select { |_, v| v.present? } %>
          <dl class="dl">
            <% if @user.slack_display_name.present? %>
              <%= dl_row "Slack handle", "@#{@user.slack_display_name}" %>
            <% end %>
            <% if dept.present? %>
              <%= dl_row "Team", dept %>
            <% end %>
            <% if location.present? %>
              <%= dl_row "Location", location %>
            <% end %>
            <% if @user.slack_start_date.present? %>
              <%= dl_row "Started", @user.slack_start_date.strftime("%B %Y") %>
            <% end %>
            <% if links.any? %>
              <%= dl_row("Links") do %>
                <span class="flex flex-wrap gap-3">
                  <% links.each do |label, url| %>
                    <%= external_link label, url %>
                  <% end %>
                </span>
              <% end %>
            <% end %>
          </dl>
        <% else %>
          <p class="text-sm text-ink-soft">Your Patchwork Labs Slack profile isn't linked yet. Once you <%= link_to "join the Slack", slack_onboarding_path, class: "link" %>, your community details will show up here automatically.</p>
        <% end %>
      </div>
    </section>
  </div>

  <%# Takeout and deletion (see Takeout and DeletionReview). %>
  <section class="card mt-6">
    <div class="card-header">
      <div class="min-w-0 flex-1">
        <h2 class="card-title"><%= t("data_handling.profile.title") %></h2>
        <p class="card-lede">
          <%= t("data_handling.profile.intro") %>
          <%= link_to t("data_handling.data_page_link"), Weave.data_page_url, class: "link", target: "_blank", rel: "noopener noreferrer" %>
        </p>
      </div>
      <div class="btn-row shrink-0">
        <%= link_to takeout_path, class: "btn btn-secondary" do %>
          <%= icon(:download) %><%= t("data_handling.profile.export") %>
        <% end %>
        <%= link_to deletion_request_path, class: "btn btn-danger" do %>
          <%= icon(:trash_2) %><%= t("data_handling.profile.delete") %>
        <% end %>
      </div>
    </div>
  </section>

  <p class="text-xs text-ink-faint mt-6 text-center">This is a read-only view of your account. Some details sync automatically from Slack.</p>
</div>

<div class="space-y-4">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :contact_first_name, "First Name", class: "block text-sm font-medium text-ink" %>
      <%= form.text_field :contact_first_name,
          class: "mt-1 w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
    </div>

    <div>
      <%= form.label :contact_last_name, "Last Name", class: "block text-sm font-medium text-ink" %>
      <%= form.text_field :contact_last_name,
          class: "mt-1 w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :contact_email, "Email", class: "block text-sm font-medium text-ink" %>
      <%= form.email_field :contact_email,
          class: "mt-1 w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
    </div>

    <div>
      <%= form.label :contact_phone_number, "Phone Number", class: "block text-sm font-medium text-ink" %>
      <%= form.telephone_field :contact_phone_number,
          class: "mt-1 w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
    </div>
  </div>

  <div>
    <%= form.label :line1, "Address Line 1", class: "block text-sm font-medium text-ink" %>
    <%= form.text_field :line1,
        class: "mt-1 w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
  </div>

  <div>
    <%= form.label :line2, "Address Line 2 (Optional)", class: "block text-sm font-medium text-ink" %>
    <%= form.text_field :line2,
        class: "mt-1 w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div>
      <%= form.label :city, "City", class: "block text-sm font-medium text-ink" %>
      <%= form.text_field :city,
          class: "mt-1 w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
    </div>

    <div>
      <%= form.label :state, "State/Province", class: "block text-sm font-medium text-ink" %>
      <%= form.text_field :state,
          class: "mt-1 w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
    </div>

    <div>
      <%= form.label :postal_code, "ZIP/Postal Code", class: "block text-sm font-medium text-ink" %>
      <%= form.text_field :postal_code,
          class: "mt-1 w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
    </div>
  </div>

  <div>
    <%= form.label :country, "Country", class: "block text-sm font-medium text-ink" %>
    <%= form.text_field :country,
        placeholder: "e.g., US, GB, CA",
        class: "mt-1 w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
  </div>

  <!-- the real meat and potatoes -->
  <% if address_type == "shipping" %>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <label class="inline-flex items-center">
          <%= form.check_box :residential, class: "rounded border-2 border-neutral-300 text-grape focus:ring-grape h-4 w-4" %>
          <span class="ml-2 text-sm text-ink-soft">Residential address</span>
        </label>
      </div>

      <div>
        <label class="inline-flex items-center">
          <%= form.check_box :supports_weekend_deliveries, class: "rounded border-2 border-neutral-300 text-grape focus:ring-grape h-4 w-4" %>
          <span class="ml-2 text-sm text-ink-soft">Weekend deliveries OK</span>
        </label>
      </div>
    </div>

    <div>
      <%= form.label :shipping_notes, "Shipping Notes", class: "block text-sm font-medium text-ink" %>
      <p class="text-xs text-ink-faint mb-1">Special instructions for delivery (door codes, gate access, etc.)</p>
      <%= form.text_area :shipping_notes,
          rows: 3,
          placeholder: "e.g., Ring doorbell twice, use gate code 1234, leave at side door",
          class: "mt-1 w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
    </div>
  <% end %>
</div>

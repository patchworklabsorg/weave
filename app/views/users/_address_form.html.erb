<div class="form-grid form-grid-2">
  <div class="field-group">
    <%= form.label :contact_first_name, "First name", class: "field-label" %>
    <%= form.text_field :contact_first_name, class: "field" %>
  </div>
  <div class="field-group">
    <%= form.label :contact_last_name, "Last name", class: "field-label" %>
    <%= form.text_field :contact_last_name, class: "field" %>
  </div>
  <div class="field-group">
    <%= form.label :contact_email, "Email", class: "field-label" %>
    <%= form.email_field :contact_email, class: "field" %>
  </div>
  <div class="field-group">
    <%= form.label :contact_phone_number, "Phone number", class: "field-label" %>
    <%= form.telephone_field :contact_phone_number, class: "field" %>
  </div>
  <div class="field-group span-2">
    <%= form.label :line1, "Address line 1", class: "field-label" %>
    <%= form.text_field :line1, class: "field" %>
  </div>
  <div class="field-group span-2">
    <%= form.label :line2, class: "field-label" do %>
      Address line 2 <span class="optional">(optional)</span>
    <% end %>
    <%= form.text_field :line2, class: "field" %>
  </div>
  <div class="field-group">
    <%= form.label :city, "City", class: "field-label" %>
    <%= form.text_field :city, class: "field" %>
  </div>
  <div class="field-group">
    <%= form.label :state, "State or province", class: "field-label" %>
    <%= form.text_field :state, class: "field" %>
  </div>
  <div class="field-group">
    <%= form.label :postal_code, "ZIP or postal code", class: "field-label" %>
    <%= form.text_field :postal_code, class: "field" %>
  </div>
  <div class="field-group">
    <%= form.label :country, "Country", class: "field-label" %>
    <%= form.text_field :country, placeholder: "e.g., US, GB, CA", class: "field" %>
  </div>

  <%# Only the shipping address carries delivery details. %>
  <% if address_type == "shipping" %>
    <label class="choice">
      <%= form.check_box :residential, class: "checkbox" %>
      <span>Residential address</span>
    </label>
    <label class="choice">
      <%= form.check_box :supports_weekend_deliveries, class: "checkbox" %>
      <span>Weekend deliveries OK</span>
    </label>
    <div class="field-group span-2">
      <%= form.label :shipping_notes, "Shipping notes", class: "field-label" %>
      <%= form.text_area :shipping_notes, rows: 3,
            placeholder: "e.g., Ring doorbell twice, use gate code 1234, leave at side door",
            class: "field" %>
      <p class="field-hint">Instructions for the courier, such as a door code or a gate.</p>
    </div>
  <% end %>
</div>

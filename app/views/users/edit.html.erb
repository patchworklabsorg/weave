<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto">
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="font-display text-2xl font-bold text-ink">Edit Profile</h1>
        <p class="text-ink-soft">Update your account information and addresses</p>
      </div>
      <%= link_to 'Back to Profile', profile_path, class: 'btn-stitch-ghost' %>
    </div>

    <%= form_with(model: @user, url: profile_path, method: :patch, local: true, class: "space-y-6") do |form| %>
      <%= form.hidden_field :billing_same_as_shipping %>
      <% if @user.errors.any? %>
        <div class="patch border-2 border-orchid bg-orchid-soft/40 text-ink p-4">
          <h3 class="text-sm font-medium text-ink">There were <%= pluralize(@user.errors.count, "error") %> with your submission:</h3>
          <div class="mt-2 text-sm text-ink-soft">
            <ul role="list" class="list-disc space-y-1 pl-5">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <div class="patch p-6">
        <h2 class="font-display text-lg font-medium text-ink mb-4">Personal Information</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= form.label :first_name, class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :first_name,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :last_name, class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :last_name,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :email, class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.email_field :email,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <% if @user.birthday.blank? %>
            <div>
              <%= form.label :birthday, class: "block text-sm font-medium text-ink mb-1" %>
              <%= form.date_field :birthday,
                  class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
              <p class="mt-1 text-xs text-ink-faint">Birthday can only be set once. Contact an administrator to change it later.</p>
            </div>
          <% else %>
            <div>
              <label class="block text-sm font-medium text-ink mb-1">Birthday</label>
              <div class="w-full rounded-lg border-2 border-neutral-300 bg-quilt px-4 py-3 text-sm text-ink-soft">
                <%= @user.birthday.strftime("%B %d, %Y") %>
              </div>
              <p class="mt-1 text-xs text-ink-faint">Birthday cannot be changed. Contact an administrator if you need to update it.</p>
            </div>
          <% end %>
        </div>
      </div>

      <div class="patch p-6">
        <h2 class="font-display text-lg font-medium text-ink mb-4">Shipping Address</h2>
        <%= form.fields_for :shipping_address, (@user.shipping_address || @user.build_shipping_address) do |address_form| %>
          <%= render "address_form", form: address_form, address_type: "shipping" %>
        <% end %>
      </div>

      <div class="patch p-6">
        <h2 class="font-display text-lg font-medium text-ink mb-4">Billing Address</h2>
        <div class="mb-4">
          <label class="inline-flex items-center">
            <input type="checkbox" id="sameas" class="rounded border-2 border-neutral-300 text-grape focus:ring-grape h-4 w-4">
            <span class="ml-2 text-sm text-ink-soft">Billing address same as shipping</span>
          </label>
        </div>
        <%= form.fields_for :billing_address, (@user.billing_address || @user.build_billing_address) do |address_form| %>
          <%= render "address_form", form: address_form, address_type: "billing" %>
        <% end %>
      </div>

      <div class="flex justify-end space-x-3">
        <%= link_to 'Cancel', profile_path, class: 'btn-stitch-ghost' %>
        <%= form.submit "Save", class: 'btn-stitch' %>
      </div>
    <% end %>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
document.addEventListener('DOMContentLoaded', function() {
  // inline js fuck logic
  const sameas = document.getElementById('sameas');
  const sin = document.querySelectorAll('[name*="shipping_address"]');
  const bin = document.querySelectorAll('[name*="billing_address"]');
  const originalNames = Array.from(bin).map(bi => bi.name);

  sameas.addEventListener('change', function() {
    document.getElementById('user_billing_same_as_shipping').value = this.checked ? '1' : '0';
    if (this.checked) {
      bin.forEach((bi, index) => {
        bi.name = '';
        bi.readOnly = true;
        bi.classList.add('bg-quilt');
      });
    } else {
      bin.forEach((bi, index) => {
        bi.name = originalNames[index];
        bi.readOnly = false;
        bi.classList.remove('bg-quilt');
      });
    }
  });

  let allSame = true;
  sin.forEach((si, index) => {
    const bi = bin[index];
    if (bi && si.value !== bi.value) {
      allSame = false;
    }
  });
  if (allSame && sin.length > 0) {
    sameas.checked = true;
    document.getElementById('user_billing_same_as_shipping').value = '1';
    sameas.dispatchEvent(new Event('change'));
  }
});
</script>

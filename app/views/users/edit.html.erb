<% content_for :title, "Edit profile" %>

<div class="page page-narrow">
  <%= page_header("Edit profile", lede: "Update your account information and addresses") %>

  <%= form_with(model: @user, url: profile_path, method: :patch, local: true, class: "space-y-6", data: { controller: "address-sync" }) do |form| %>
    <%= form.hidden_field :billing_same_as_shipping, data: { address_sync_target: "flag" } %>
    <%= form_errors(@user) %>

    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Personal information</h2>
      </div>
      <div class="card-body">
        <div class="form-grid form-grid-2">
          <div class="field-group">
            <%= form.label :first_name, "Preferred first name", class: "field-label" %>
            <%= form.text_field :first_name, class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :last_name, "Preferred last name", class: "field-label" %>
            <%= form.text_field :last_name, class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :legal_first_name, class: "field-label" %>
            <%= form.text_field :legal_first_name, maxlength: 100, placeholder: "Same as preferred name", class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :legal_last_name, class: "field-label" %>
            <%= form.text_field :legal_last_name, maxlength: 100, placeholder: "Same as preferred name", class: "field" %>
          </div>
          <p class="field-hint span-2 -mt-2">Leave the legal name fields blank if they match your preferred name. Your legal name is only used where it's legally required.</p>
          <div class="field-group">
            <span class="field-label">Email</span>
            <span class="field-static"><%= @user.email %></span>
            <p class="field-hint">Manage your email addresses in the section below.</p>
          </div>
          <div class="field-group">
            <%= form.label :phone_number, class: "field-label" %>
            <%= form.telephone_field :phone_number, placeholder: "(802) 555-0123", class: "field" %>
            <p class="field-hint">Include your area code. International numbers need a country code (e.g. +44).</p>
          </div>
          <div class="field-group">
            <%= form.label :pronouns, class: "field-label" %>
            <%= form.text_field :pronouns, placeholder: "e.g. they/them", maxlength: User::PRONOUNS_MAX_LENGTH, class: "field" %>
            <p class="field-hint">Shared with your Slack profile. To remove your pronouns, clear them here. Clearing them in Slack does not clear them here.</p>
          </div>
          <% if @user.birthday.blank? %>
            <div class="field-group">
              <%= form.label :birthday, class: "field-label" %>
              <%= form.date_field :birthday, class: "field" %>
              <p class="field-hint">Birthday can only be set once. Contact an administrator to change it later.</p>
            </div>
          <% else %>
            <div class="field-group">
              <span class="field-label">Birthday</span>
              <span class="field-static"><%= @user.birthday.strftime("%B %d, %Y") %></span>
              <p class="field-hint">Birthday cannot be changed. Contact an administrator if you need to update it.</p>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Shipping address</h2>
      </div>
      <div class="card-body">
        <%= form.fields_for :shipping_address, (@user.shipping_address || @user.build_shipping_address) do |address_form| %>
          <%= render "address_form", form: address_form, address_type: "shipping" %>
        <% end %>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Billing address</h2>
      </div>
      <div class="card-body space-y-4">
        <%# No name attribute: the toggle is not posted; the hidden flag above is. %>
        <label class="choice">
          <input type="checkbox" class="checkbox" data-address-sync-target="toggle" data-action="change->address-sync#sync">
          <span>Billing address same as shipping</span>
        </label>
        <%= form.fields_for :billing_address, (@user.billing_address || @user.build_billing_address) do |address_form| %>
          <%= render "address_form", form: address_form, address_type: "billing" %>
        <% end %>
      </div>
    </section>

    <div class="form-actions">
      <%= link_to "Cancel", profile_path, class: "btn btn-secondary" %>
      <%= form.submit "Save", class: "btn btn-primary" %>
    </div>
  <% end %>

  <section class="card mt-6">
    <div class="card-header">
      <div>
        <h2 class="card-title">Email addresses</h2>
        <p class="card-lede">You can sign in with any confirmed email. Your primary email is where we send account notifications.</p>
      </div>
    </div>
    <div class="card-body space-y-4">
      <div class="record-list">
        <% @user.email_addresses.order(is_primary: :desc, created_at: :asc).each do |email_address| %>
          <div class="record flex-wrap">
            <div class="record-main">
              <div class="record-title flex flex-wrap items-center gap-2">
                <span class="min-w-0 break-all"><%= email_address.email %></span>
                <%= badge("Primary", tone: :solid) if email_address.primary? %>
                <% if email_address.confirmed? %>
                  <%= badge("Confirmed", tone: :success) %>
                <% else %>
                  <%= badge("Unconfirmed", tone: :neutral) %>
                <% end %>
              </div>
            </div>
            <div class="record-actions">
              <% unless email_address.confirmed? %>
                <%= button_to "Resend confirmation", resend_confirmation_email_address_path(email_address), method: :post, class: "btn btn-quiet btn-sm" %>
              <% end %>
              <% if email_address.confirmed? && !email_address.primary? %>
                <%= button_to "Make primary", make_primary_email_address_path(email_address), method: :patch, class: "btn btn-quiet btn-sm" %>
              <% end %>
              <% unless email_address.primary? %>
                <%= button_to "Remove", email_address_path(email_address), method: :delete,
                      data: { turbo_confirm: "Remove #{email_address.email} from your account?" },
                      class: "btn btn-danger btn-sm" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <%= form_with url: email_addresses_path, scope: :email_address, method: :post, class: "flex flex-wrap gap-2" do |email_form| %>
        <%= email_form.label :email, "Add an email address", class: "sr-only" %>
        <%= email_form.email_field :email, placeholder: "you@example.com", required: true, class: "field flex-1 min-w-0 basis-56" %>
        <%= email_form.submit "Add email", class: "btn btn-secondary" %>
      <% end %>
    </div>
  </section>
</div>

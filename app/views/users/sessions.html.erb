<% content_for :title, "Sessions" %>
<% session_map_data = @sessions.filter_map(&:map_data) %>

<div class="page space-y-6">
  <%= page_header("Sessions", lede: "View and manage your active login sessions") do %>
    <% if @sessions.not_expired.count > 1 %>
      <%= button_to destroy_all_sessions_path, method: :delete,
            class: "btn btn-danger",
            data: { turbo_confirm: "Are you sure you want to sign out of all other sessions?" } do %>
        <%= icon(:log_out) %>Sign out all other sessions
      <% end %>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="card stat">
      <span class="stat-label">Active sessions</span>
      <span class="stat-value"><%= @sessions.not_expired.count %></span>
    </div>
    <div class="card stat">
      <span class="stat-label">Total sessions</span>
      <span class="stat-value"><%= @sessions.count %></span>
    </div>
    <div class="card stat">
      <span class="stat-label">Unique locations</span>
      <span class="stat-value"><%= session_map_data.size %></span>
    </div>
  </div>

  <% if session_map_data.any? %>
    <section class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title">Session locations</h2>
          <p class="card-lede">Geographic locations of your login sessions</p>
        </div>
      </div>
      <div class="card-body">
        <% content_for :head, javascript_include_tag("mapkick.bundle") %>
        <%= js_map session_map_data, height: "400px", zoom: 2 %>
        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-soft">
          <span class="inline-flex items-center gap-2"><span class="size-2.5 rounded-full bg-success"></span>Active sessions</span>
          <span class="inline-flex items-center gap-2"><span class="size-2.5 rounded-full bg-warning"></span>Impersonated sessions</span>
          <span class="inline-flex items-center gap-2"><span class="size-2.5 rounded-full bg-ink-faint"></span>Expired sessions</span>
        </div>
      </div>
    </section>
  <% end %>

  <section class="card card-flush">
    <div class="card-header">
      <h2 class="card-title">Session details</h2>
    </div>
    <% if @sessions.any? %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Status</th>
              <th>Device</th>
              <th>Operating System</th>
              <th>Location</th>
              <th>Login Time</th>
              <th>Last Activity</th>
              <th class="actions"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @sessions.each do |session| %>
              <% is_current = session == current_user_session %>
              <tr class="<%= "is-current" if is_current %>">
                <td>
                  <div class="flex flex-wrap gap-1">
                    <% if session.expired? || session.signed_out_at %>
                      <%= badge("Expired", tone: :neutral) %>
                    <% else %>
                      <%= badge(is_current ? "Current" : "Active", tone: :success) %>
                    <% end %>
                    <%= badge("Impersonated", tone: :warning) if session.impersonated? %>
                  </div>
                </td>
                <td><%= session.device_info || "Unknown" %></td>
                <td class="text-ink-soft"><%= session.os_info || "Unknown" %></td>
                <td class="text-ink-soft">
                  <%= session.ip || "Unknown" %>
                  <% if session.latitude.present? && session.longitude.present? %>
                    <span class="table-sub"><%= session.location_name %></span>
                  <% end %>
                  <% if session.timezone.present? %>
                    <span class="table-sub"><%= session.timezone %></span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap text-ink-soft"><%= time_label(session.created_at, :datetime) %></td>
                <td class="whitespace-nowrap text-ink-soft">
                  <% if session.last_seen_at %>
                    <%= time_label(session.last_seen_at, :relative) %>
                  <% else %>
                    Never
                  <% end %>
                </td>
                <td class="actions">
                  <% if is_current %>
                    <span class="text-ink-faint">Current Session</span>
                  <% elsif !session.expired? && !session.signed_out_at %>
                    <%= button_to "Revoke", session_path(session), method: :delete,
                          class: "btn btn-danger btn-sm",
                          data: { turbo_confirm: "Are you sure you want to revoke this session?" } %>
                  <% else %>
                    <span class="text-ink-faint">Expired</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state("No sessions found.", icon: :monitor) %>
    <% end %>
  </section>
</div>

<%# app/views/users/new.html.erb — public signup (rendered in the "sessions" layout) %>
<% content_for :title, "Sign up" %>

<div class="min-h-full flex items-center justify-center p-6">
  <div class="patch patch-bound patch-tilt-r w-full max-w-lg">
    <div class="quilt-binding"></div>
    <div class="p-8 sm:p-9 space-y-6">
      <div class="text-center space-y-2">
        <%= render "shared/wordmark", size: :lg, href: nil %>
        <h1 class="font-display text-2xl font-bold text-ink">Join Patchwork Labs</h1>
        <p class="text-ink-soft text-sm">Create your account to get started.</p>
      </div>

      <%= form_with(model: @user, url: signup_path, method: :post, local: true, class: "space-y-6") do |form| %>
        <%= form_errors(@user) %>

        <div class="form-grid form-grid-2">
          <div class="field-group">
            <%= form.label :first_name, class: "field-label" %>
            <%= form.text_field :first_name, autofocus: true, autocomplete: "given-name", class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :last_name, class: "field-label" %>
            <%= form.text_field :last_name, autocomplete: "family-name", class: "field" %>
          </div>
          <div class="field-group span-2">
            <%= form.label :email, class: "field-label" %>
            <%= form.email_field :email, autocomplete: "email", class: "field" %>
          </div>
          <div class="field-group span-2">
            <%= form.label :birthday, class: "field-label" %>
            <%= form.date_field :birthday, required: true, max: Date.current, autocomplete: "bday", class: "field" %>
            <p class="field-hint"><%= t("birthday.hint") %></p>
          </div>
          <div class="field-group span-2">
            <%= form.label :referral_source, class: "field-label" do %>
              How did you hear about Patchwork? <span class="optional">(optional)</span>
            <% end %>
            <%= form.select :referral_source, User::REFERRAL_SOURCES.invert, { include_blank: "Choose one" }, class: "field" %>
          </div>
          <div class="field-group span-2">
            <%= form.label :referral_source_detail, class: "field-label" do %>
              Tell us more <span class="optional">(optional)</span>
            <% end %>
            <%= form.text_field :referral_source_detail, maxlength: User::REFERRAL_SOURCE_DETAIL_MAX_LENGTH, placeholder: "Who referred you, or which event?", class: "field" %>
          </div>
        </div>

        <p class="text-sm text-ink-soft text-center">
          We'll email you a secure sign-in link — no password to remember.
        </p>

        <p class="text-xs text-ink-faint text-center mb-3">
          <%= link_to t("data_handling.data_page_link"), Weave.data_page_url, target: "_blank", rel: "noopener noreferrer", class: "link" %>
        </p>
        <%= form.submit "Create account", class: "btn btn-primary btn-block" %>
      <% end %>

      <p class="text-center text-sm text-ink-soft">
        Already have an account?
        <%= link_to "Sign in", login_path, class: "link" %>
      </p>
    </div>
  </div>
</div>

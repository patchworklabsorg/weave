<%# app/views/users/new.html.erb — public signup (rendered in the "sessions" layout) %>
<% content_for :title, "Sign up" %>

<div class="min-h-full flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-lg">
    <div class="text-center mb-8">
      <h1 class="font-display text-3xl font-bold text-ink">Join Patchwork Labs</h1>
      <p class="mt-2 text-ink-soft">Create your account to get started.</p>
    </div>

    <%= form_with(model: @user, url: signup_path, method: :post, local: true, class: "space-y-6") do |form| %>
      <% if @user.errors.any? %>
        <div class="patch border-2 border-orchid bg-orchid-soft/40 text-ink p-4">
          <h3 class="text-sm font-medium text-ink">There were <%= pluralize(@user.errors.count, "error") %> with your submission:</h3>
          <div class="mt-2 text-sm text-ink-soft">
            <ul role="list" class="list-disc space-y-1 pl-5">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <div class="patch p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= form.label :first_name, class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :first_name, autofocus: true, autocomplete: "given-name",
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :last_name, class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :last_name, autocomplete: "family-name",
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div class="md:col-span-2">
            <%= form.label :email, class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.email_field :email, autocomplete: "email",
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div class="md:col-span-2">
            <%= form.label :birthday, "Birthday (optional)", class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.date_field :birthday,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
            <p class="mt-1 text-xs text-ink-faint">Birthday can only be set once. You can add it later from your profile.</p>
          </div>
        </div>
      </div>

      <p class="text-sm text-ink-soft text-center">
        We'll email you a secure sign-in link — no password to remember.
      </p>

      <%= form.submit "Create account", class: "btn-stitch w-full justify-center cursor-pointer" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-ink-soft">
      Already have an account?
      <%= link_to "Sign in", login_path, class: "font-medium text-grape hover:underline" %>
    </p>
  </div>
</div>

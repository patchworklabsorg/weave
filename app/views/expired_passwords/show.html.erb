<% content_for :title, "Choose a new password" %>

<div class="absolute inset-0 flex items-center justify-center p-6">
  <div class="patch patch-bound patch-tilt-l w-full max-w-md">
    <div class="quilt-binding"></div>

    <div class="p-9 pb-5 text-center">
      <h1 class="font-display text-3xl font-bold text-ink">Weave</h1>
      <p class="text-ink-soft mt-2">Your password has expired. Choose a new one.</p>
    </div>

    <div class="px-9 pb-9 space-y-6">
      <%= form_with url: expired_password_path, method: :patch, local: true, data: { turbo: false }, class: "space-y-4" do %>
        <%= render "passwords/password_fields", ask_current: true %>
        <%= submit_tag "Change password", class: "btn-stitch w-full" %>
      <% end %>

      <p class="text-sm text-ink-soft text-center">
        <%= link_to "Use an email link instead", login_path, class: "text-grape hover:text-ink font-medium underline decoration-dashed underline-offset-2" %>
      </p>
    </div>
  </div>
</div>

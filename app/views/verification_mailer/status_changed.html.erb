<h2 style="margin: 0 0 16px 0; color: #2a2050; font-size: 20px; font-weight: 700;"><%= t("verification.mailer.#{@key}.subject") %></h2>

<p style="margin: 0 0 16px 0; color: #2a2050;"><%= @body %></p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 8px 0 24px 0;">
  <tr>
    <td style="border-radius: 8px; background-color: #6c3ec1;">
      <a href="<%= @status_url %>" style="display: inline-block; padding: 12px 28px; background-color: #6c3ec1; color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 700; font-size: 15px; font-family: 'Geist', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
        <%= t("verification.mailer.action") %>
      </a>
    </td>
  </tr>
</table>

<p style="margin: 0 0 16px 0; color: #2a2050;"><a href="<%= @data_page_url %>" style="color: #6c3ec1;"><%= t("verification.data_page_link") %></a></p>

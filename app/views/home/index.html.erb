<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title>Patchwork Labs</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="h-full quilt-bg text-ink font-sans">
    <main class="min-h-full flex items-center justify-center p-6">
      <div class="patch patch-bound patch-tilt-r w-full max-w-2xl text-center">
        <div class="quilt-binding"></div>
        <div class="p-10 sm:p-14">
        <p class="font-display text-grape text-sm font-semibold tracking-wide mb-3"><span class="rosette"></span> Weave · Patchwork Labs</p>
        <h1 class="font-display text-4xl sm:text-5xl font-bold text-ink text-balance leading-tight">You've found the front door.</h1>

        <p class="text-ink-soft text-lg leading-relaxed max-w-prose mx-auto mt-5">
          This is where Patchwork Labs members sign in to the tools, the Slack, and everything stitched to their account. If you landed here by mistake, head back to wherever sent you.
        </p>

        <% if current_user %>
          <div class="mt-8 mb-6">
            <p class="font-semibold text-ink"><%= current_user.full_name %></p>
            <p class="text-ink-faint text-sm">ID: <%= current_user.flipper_id %></p>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-3">
            <% if current_user.admin? %>
              <%= link_to "Admin panel", admin_root_path, class: "btn-stitch" %>
            <% end %>
            <% if impersonating? %>
              <%= button_to "Stop impersonating", stop_impersonating_admin_users_path, method: :delete, class: "btn-stitch-ghost", form_class: "inline-block" %>
            <% else %>
              <%= button_to "Sign out", logout_path, method: :delete, class: "btn-stitch-ghost", form_class: "inline-block" %>
            <% end %>
          </div>
        <% else %>
          <div class="mt-9">
            <%= link_to "Sign in", login_path, class: "btn-stitch" %>
          </div>
        <% end %>
        </div>
      </div>
    </main>
  </body>
</html>

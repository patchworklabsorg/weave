<% content_for :title, "Patchwork Labs" %>

<div class="min-h-full flex items-center justify-center p-6">
  <div class="patch patch-bound patch-tilt-r w-full max-w-2xl text-center">
    <div class="quilt-binding"></div>
    <div class="p-8 sm:p-14 space-y-6">
      <%= render "shared/wordmark", size: :lg, href: nil %>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-ink text-balance leading-tight">You've found the front door.</h1>

      <p class="text-ink-soft text-lg leading-relaxed max-w-prose mx-auto">
        This is where Patchwork Labs members sign in to the tools, the Slack, and everything stitched to their account. If you landed here by mistake, head back to wherever sent you.
      </p>

      <div class="btn-row justify-center pt-2">
        <%= link_to "Sign in", login_path, class: "btn btn-primary btn-lg" %>
        <%= link_to "Join the Slack", slack_onboarding_path, class: "btn btn-secondary btn-lg" %>
      </div>
    </div>
  </div>
</div>

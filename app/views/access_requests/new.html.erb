<% content_for :title, "Request access to #{@application.name}" %>

<div class="page page-narrow">
  <%= page_header("Request access", lede: "Ask for access to #{@application.name}.") %>

  <section class="card">
    <div class="card-header">
      <div class="flex items-center gap-3 min-w-0">
        <%= app_icon(@application) %>
        <div class="min-w-0">
          <h2 class="card-title"><%= @application.name %></h2>
          <% if @application.launcher_description.present? %>
            <p class="card-lede"><%= @application.launcher_description %></p>
          <% end %>
        </div>
      </div>
    </div>
    <div class="card-body">
      <%= render "access_requests/form", access_request: @access_request, application: @application %>
    </div>
  </section>
</div>

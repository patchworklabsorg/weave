<% content_for :title, "Password" %>

<div class="page page-narrow space-y-6">
  <% if @mode == :directory %>
    <%= page_header("Password", lede: "Your password is for Weave and for every Patchwork service that signs in through Weave, such as Google.") %>
  <% else %>
    <%= page_header("Password", lede: "Change the password you use to sign in to Weave.") %>
  <% end %>

  <% if impersonating? %>
    <div class="callout callout-info">
      <%= icon(:info, size: 18) %>
      <div class="callout-body">
        <p>You can't change a password while impersonating a user.</p>
      </div>
    </div>
  <% elsif @mode == :directory || @mode == :local %>
    <section class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title">Change your password</h2>
          <p class="card-lede">
            <% if @mode == :directory %>
              The Patchwork directory keeps your password. It must meet the password policy, and you can't use a recent password again.
            <% else %>
              Use at least 8 characters, with an uppercase letter, a lowercase letter, a number and a special character.
            <% end %>
          </p>
        </div>
      </div>
      <div class="card-body">
        <%= form_with url: password_path, method: :patch, local: true, data: { turbo: false }, class: "space-y-4" do %>
          <%= render "passwords/password_fields", ask_current: true %>
          <div class="form-actions">
            <%= submit_tag "Change password", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </section>

    <% if @mode == :directory %>
      <section class="card">
        <div class="card-header">
          <div>
            <h2 class="card-title">Forgot your password?</h2>
            <% if @reset_allowed %>
              <p class="card-lede">You signed in a few minutes ago, so you can set a new password without the current one.</p>
            <% end %>
          </div>
        </div>
        <div class="card-body">
          <% if @reset_allowed %>
            <%= form_with url: password_path, method: :patch, local: true, data: { turbo: false }, class: "space-y-4" do %>
              <%= render "passwords/password_fields", ask_current: false %>
              <div class="form-actions">
                <%= submit_tag "Set a new password", class: "btn btn-secondary" %>
              </div>
            <% end %>
          <% else %>
            <p class="text-sm text-ink-soft">
              Sign out, then sign in again with an email link or a passkey. For 15 minutes after that, you can set a new password here without the current one.
            </p>
          <% end %>
        </div>
      </section>
    <% end %>
  <% elsif @mode == :unavailable %>
    <div class="callout callout-warning">
      <%= icon(:triangle_alert, size: 18) %>
      <div class="callout-body">
        <p>Weave can't reach the Patchwork directory now, so you can't change your password. Try again later.</p>
      </div>
    </div>
  <% else %>
    <section class="card">
      <div class="card-body space-y-4">
        <p class="text-sm text-ink">Your account has no password. You sign in with email links and passkeys.</p>
        <%= link_to passkeys_path, class: "btn btn-secondary" do %>
          <%= icon(:fingerprint) %>Manage passkeys
        <% end %>
      </div>
    </section>
  <% end %>
</div>

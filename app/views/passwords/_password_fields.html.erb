<% input_class = "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
<% if ask_current %>
  <div class="space-y-2">
    <%= label_tag :current_password, "Current password", class: "block text-sm font-medium text-ink" %>
    <%= password_field_tag :current_password, nil, autocomplete: "current-password", required: true, class: input_class %>
  </div>
<% end %>
<div class="space-y-2">
  <%= label_tag :password, "New password", class: "block text-sm font-medium text-ink" %>
  <%= password_field_tag :password, nil, autocomplete: "new-password", required: true, class: input_class %>
</div>
<div class="space-y-2">
  <%= label_tag :password_confirmation, "Confirm the new password", class: "block text-sm font-medium text-ink" %>
  <%= password_field_tag :password_confirmation, nil, autocomplete: "new-password", required: true, class: input_class %>
</div>

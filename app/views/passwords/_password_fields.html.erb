<% if ask_current %>
  <div class="field-group">
    <%= label_tag :current_password, "Current password", class: "field-label" %>
    <%= password_field_tag :current_password, nil, autocomplete: "current-password", required: true, class: "field" %>
  </div>
<% end %>
<div class="field-group">
  <%= label_tag :password, "New password", class: "field-label" %>
  <%= password_field_tag :password, nil, autocomplete: "new-password", required: true, class: "field" %>
</div>
<div class="field-group">
  <%= label_tag :password_confirmation, "Confirm the new password", class: "field-label" %>
  <%= password_field_tag :password_confirmation, nil, autocomplete: "new-password", required: true, class: "field" %>
</div>

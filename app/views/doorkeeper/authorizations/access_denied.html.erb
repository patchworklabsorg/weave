<% content_for :title, "No access" %>

<div class="min-h-full flex items-center justify-center p-6">
  <div class="patch patch-bound patch-tilt-l w-full max-w-md">
    <div class="quilt-binding"></div>
    <div class="p-8 sm:p-9 space-y-6">
      <div class="text-center space-y-2">
        <%= render "shared/wordmark", size: :lg, href: nil %>
        <h1 class="font-display text-2xl font-bold text-ink">You don't have access</h1>
      </div>

      <div class="callout callout-danger">
        <%= icon(:lock, size: 18) %>
        <div class="callout-body">
          <p>Your account can't use <strong><%= @application.name %></strong>.</p>
        </div>
      </div>

      <% if @decision&.reason == :under_minimum_age %>
        <p class="text-sm text-ink-soft text-center">
          <%= t("birthday.under_minimum_age", email: Weave.mail_address) %>
        </p>
      <% elsif @decision&.reason == :guardian_consent %>
        <p class="text-sm text-ink-soft text-center">
          Members under 18 need consent from a parent or guardian before they can use Patchwork Labs apps.
        </p>

        <%= link_to "Ask a parent or guardian", slack_onboarding_path, class: "btn btn-primary btn-block" %>
      <% elsif @decision&.reason == :code_of_conduct %>
        <p class="text-sm text-ink-soft text-center">
          Patchwork Labs apps are for members who have accepted the Code of Conduct.
        </p>

        <%= link_to "Accept the Code of Conduct", slack_onboarding_path, class: "btn btn-primary btn-block" %>
      <% elsif @decision&.reason == :email_domain %>
        <p class="text-sm text-ink-soft text-center">
          <%= @application.name %> needs a confirmed address on <%= @application.email_domains.to_sentence(two_words_connector: " or ", last_word_connector: " or ") %> in your Weave account. Ask a Weave admin for help.
        </p>

        <%= link_to "Go to your Weave account", root_path, class: "btn btn-secondary btn-block" %>
      <% else %>
        <p class="text-sm text-ink-soft text-center">
          Access to this app is limited to some people and groups. If you need it, ask a Weave admin to give you access.
        </p>

        <%= link_to "Go to your Weave account", root_path, class: "btn btn-secondary btn-block" %>
      <% end %>
    </div>
  </div>
</div>

<% content_for :title, t("doorkeeper.authorizations.error.title") %>

<div class="min-h-full flex items-center justify-center p-6">
  <div class="patch patch-bound patch-tilt-r w-full max-w-md">
    <div class="quilt-binding"></div>
    <div class="p-8 sm:p-9 space-y-6">
      <div class="text-center space-y-2">
        <%= render "shared/wordmark", size: :lg, href: nil %>
        <h1 class="font-display text-2xl font-bold text-ink"><%= t("doorkeeper.authorizations.error.title") %></h1>
      </div>

      <div class="callout callout-danger" role="alert">
        <%= icon(:circle_x, size: 18) %>
        <div class="callout-body">
          <p><%= (local_assigns[:error_response] ? error_response : @pre_auth.error_response).body[:error_description] %></p>
        </div>
      </div>

      <p class="text-xs text-ink-faint text-center">
        Something went wrong with this authorization request. Contact the application's developer or try again from the app that sent you here.
      </p>
    </div>
  </div>
</div>

<% content_for :title, t(".title") %>

<div class="min-h-full flex items-center justify-center p-6">
  <div class="patch patch-bound patch-tilt-l w-full max-w-md">
    <div class="quilt-binding"></div>
    <div class="p-8 sm:p-9 space-y-6">
      <div class="text-center space-y-2">
        <%= render "shared/wordmark", size: :lg, href: nil %>
        <h1 class="font-display text-2xl font-bold text-ink"><%= t(".title") %></h1>
        <p class="text-ink-soft text-sm">Copy this code back into the application to finish signing in.</p>
      </div>

      <code id="authorization_code" class="code-block text-center text-lg select-all"><%= params[:code] %></code>
    </div>
  </div>
</div>

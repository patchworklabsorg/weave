<% content_for :title, t(".title") %>

<div class="absolute inset-0 flex items-center justify-center p-6">
  <div class="patch patch-tilt-r w-full max-w-md">
    <!-- Card Header -->
    <div class="p-9 pb-5 text-center">
      <p class="text-sm font-medium text-ink-faint uppercase tracking-wide">Weave &middot; Patchwork Labs</p>
      <h1 class="font-display text-3xl font-bold text-ink mt-2"><%= t(".title") %></h1>
      <p class="text-ink-soft mt-3">
        <%= raw t(".prompt", client_name: content_tag(:strong, class: "text-grape") { @pre_auth.client.name }) %>
      </p>
    </div>

    <!-- Card Content -->
    <div class="px-9 pb-9 space-y-6">
      <% if @pre_auth.scopes.count > 0 %>
        <div id="oauth-permissions" class="patch border-2 border-grape bg-grape-soft/40 p-5">
          <p class="text-sm font-medium text-ink"><%= t(".able_to") %>:</p>
          <ul class="mt-3 space-y-2">
            <% @pre_auth.scopes.each do |scope| %>
              <li class="flex items-start gap-2 text-sm text-ink">
                <svg class="w-4 h-4 mt-0.5 shrink-0 text-grape" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                <%= t scope, scope: [:doorkeeper, :scopes], default: scope.to_s.humanize %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-3">
        <%= form_tag oauth_authorization_path, method: :post do %>
          <%= render "pre_auth_fields" %>
          <%= submit_tag t("doorkeeper.authorizations.buttons.authorize"), class: "btn-stitch w-full" %>
        <% end %>
        <%= form_tag oauth_authorization_path, method: :delete do %>
          <%= render "pre_auth_fields" %>
          <%= submit_tag t("doorkeeper.authorizations.buttons.deny"), class: "btn-stitch-ghost w-full" %>
        <% end %>
      </div>

      <% redirect_host = URI.parse(@pre_auth.redirect_uri).host rescue nil %>
      <% if redirect_host.present? %>
        <p class="text-xs text-ink-faint text-center">
          Authorizing will redirect you to <span class="font-medium text-ink-soft"><%= redirect_host %></span>
        </p>
      <% end %>
    </div>
  </div>
</div>

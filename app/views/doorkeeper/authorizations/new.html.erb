<% content_for :title, t(".title") %>

<div class="min-h-full flex items-center justify-center p-6">
  <div class="patch patch-bound patch-tilt-r w-full max-w-md">
    <div class="quilt-binding"></div>
    <div class="p-8 sm:p-9 space-y-6">
      <div class="text-center space-y-2">
        <%= render "shared/wordmark", size: :lg, href: nil %>
        <h1 class="font-display text-2xl font-bold text-ink"><%= t(".title") %></h1>
        <p class="text-ink-soft text-sm">
          <%= raw t(".prompt", client_name: content_tag(:strong, class: "text-grape") { @pre_auth.client.name }) %>
        </p>
      </div>

      <% if @pre_auth.scopes.count > 0 %>
        <div id="oauth-permissions" class="well">
          <p class="text-sm font-medium text-ink"><%= t(".able_to") %>:</p>
          <ul class="mt-3 space-y-2">
            <% @pre_auth.scopes.each do |scope| %>
              <li class="flex items-start gap-2 text-sm text-ink">
                <%= icon(:check, size: 16, class: "text-grape mt-0.5 shrink-0") %>
                <span><%= t scope, scope: [:doorkeeper, :scopes], default: scope.to_s.humanize %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# turbo: false on both forms. Either one answers with a redirect to the
          client's redirect_uri, which is cross-origin by definition, and Turbo
          submits forms as fetch() — so it follows that redirect as a CORS
          request rather than a navigation. The client then sees an OPTIONS
          preflight, which carries no cookies, instead of the GET its callback
          needs, and every sign-in dies there. These have to be real browser
          form submissions. %>
      <div class="space-y-3">
        <%= form_tag oauth_authorization_path, method: :post, data: { turbo: false } do %>
          <%= render "pre_auth_fields" %>
          <%= submit_tag t("doorkeeper.authorizations.buttons.authorize"), class: "btn btn-primary btn-block" %>
        <% end %>
        <%= form_tag oauth_authorization_path, method: :delete, data: { turbo: false } do %>
          <%= render "pre_auth_fields" %>
          <%= submit_tag t("doorkeeper.authorizations.buttons.deny"), class: "btn btn-secondary btn-block" %>
        <% end %>
      </div>

      <% redirect_host = URI.parse(@pre_auth.redirect_uri).host rescue nil %>
      <% if redirect_host.present? %>
        <p class="text-xs text-ink-faint text-center">
          Authorizing will redirect you to <span class="font-medium text-ink-soft"><%= redirect_host %></span>
        </p>
      <% end %>
    </div>
  </div>
</div>

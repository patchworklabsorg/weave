<%# An optional invitation to the demographics form (see DemographicsVault),
    on the profile and the Slack onboarding page. It never blocks a step. %>
<% answered = DemographicsVault.answered_at(user).present? %>
<% link_class = "text-grape hover:text-ink font-medium underline decoration-dashed underline-offset-2" %>
<div class="patch p-5 space-y-2 text-left" id="demographics-prompt">
  <p class="font-semibold text-ink"><%= t("demographics.prompt.title") %></p>
  <p class="text-sm text-ink-soft"><%= answered ? t("demographics.prompt.answered") : t("demographics.prompt.body") %></p>
  <p class="text-sm flex flex-wrap gap-x-4 gap-y-1">
    <%= link_to (answered ? t("demographics.prompt.manage") : t("demographics.prompt.link")), demographics_path, class: link_class %>
    <%= link_to t("demographics.data_page_link"), Weave.data_page_url, class: link_class, target: "_blank", rel: "noopener noreferrer" %>
  </p>
</div>

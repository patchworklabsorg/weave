<%# The member's demographics form (see DemographicsController). It always
    starts empty: Weave cannot read the answers back. After a failed save it
    shows what the member just sent. %>
<% content_for :title, t("demographics.form.title") %>
<%
  submitted = params.fetch(:demographics, {})
  link_class = "text-grape hover:text-ink font-medium underline decoration-dashed underline-offset-2"
%>

<div class="max-w-2xl mx-auto px-4 py-10 space-y-6">
  <div class="patch patch-bound p-6 space-y-3">
    <h1 class="font-display text-2xl font-bold text-ink"><%= t("demographics.form.title") %></h1>
    <p class="text-sm text-ink"><%= t("demographics.form.intro") %></p>
    <p class="text-sm text-ink"><%= t("demographics.form.required") %></p>
    <p class="text-sm text-ink-soft"><%= t("demographics.form.sealed") %></p>
    <p class="text-sm text-ink-soft"><%= t("demographics.form.age_band") %></p>
    <p class="text-sm">
      <%= link_to t("demographics.data_page_link"), Weave.data_page_url, class: link_class, target: "_blank", rel: "noopener noreferrer" %>
    </p>
    <p class="text-sm font-medium text-ink">
      <%= @answered_at ? t("demographics.form.answered", date: l(@answered_at.to_date, format: :long)) : t("demographics.form.not_answered") %>
    </p>
  </div>

  <% if @available %>
    <div class="patch p-6">
      <%= form_with url: demographics_path, method: :patch, class: "space-y-6" do |form| %>
        <%= hidden_field_tag :return_to, @return_to if @return_to %>
        <% DemographicsVault.fields.each do |field| %>
          <% key = field[:key] %>
          <fieldset>
            <legend class="block text-sm font-medium text-ink mb-2"><%= demographic_field_label(key) %></legend>
            <div class="space-y-2">
              <% DemographicsVault.options_for(field).each do |option| %>
                <label class="flex items-center gap-2 text-sm text-ink">
                  <% if field[:type] == "multi" %>
                    <%= check_box_tag "demographics[#{key}][]", option, Array(submitted[key]).include?(option), id: "demographics_#{key}_#{option}" %>
                  <% else %>
                    <%= radio_button_tag "demographics[#{key}]", option, submitted[key] == option, id: "demographics_#{key}_#{option}", required: true %>
                  <% end %>
                  <%= demographic_option_label(key, option) %>
                </label>
              <% end %>
            </div>
            <% if field[:self_describe] %>
              <div class="mt-3">
                <%= label_tag "demographics_#{key}_self_description", t("demographics.form.self_description"), class: "block text-sm text-ink-soft" %>
                <%= text_field_tag "demographics[#{key}_self_description]", submitted["#{key}_self_description"],
                      maxlength: DemographicsVault::SELF_DESCRIPTION_MAX, autocomplete: "off",
                      aria: { describedby: "demographics_#{key}_self_description_hint" },
                      class: "mt-1 w-full px-4 py-2 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape" %>
                <p id="demographics_<%= key %>_self_description_hint" class="mt-1 text-xs text-ink-faint"><%= t("demographics.form.self_description_hint") %></p>
              </div>
            <% end %>
            <% if @form_errors&.key?(key.to_sym) %>
              <p class="mt-1 text-sm text-orchid"><%= @form_errors[key.to_sym] %></p>
            <% end %>
          </fieldset>
        <% end %>

        <p class="text-sm text-ink-soft"><%= t("demographics.form.why") %></p>

        <%= form.submit t("demographics.form.submit"), class: "btn-stitch w-full justify-center" %>
      <% end %>
    </div>
  <% else %>
    <div class="patch p-6">
      <p class="text-sm text-ink-soft"><%= t("demographics.form.unavailable") %></p>
    </div>
  <% end %>

  <% consent_funders = FunderProfiles.all.select(&:consent_required?) %>
  <% if consent_funders.any? %>
    <div class="patch p-6 space-y-3">
      <h2 class="font-display text-lg font-bold text-ink"><%= t("funder_consents.title") %></h2>
      <p class="text-sm text-ink-soft"><%= t("funder_consents.intro") %></p>
      <% live = current_user.funder_consents.live.pluck(:funder) %>
      <ul class="space-y-3">
        <% consent_funders.each do |profile| %>
          <li class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <span class="text-sm text-ink">
              <%= profile.name %>:
              <%= live.include?(profile.key) ? t("funder_consents.counted") : t("funder_consents.not_counted") %>
            </span>
            <% if live.include?(profile.key) %>
              <%= button_to t("funder_consents.withdraw"), funder_consent_path(profile.key), method: :delete, class: "btn-stitch-ghost" %>
            <% else %>
              <%= button_to t("funder_consents.give"), funder_consents_path(funder: profile.key), method: :post, class: "btn-stitch-ghost" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @answered_at %>
    <div class="patch p-6 space-y-3">
      <h2 class="font-display text-lg font-bold text-ink"><%= t("demographics.form.withdraw_title") %></h2>
      <p class="text-sm text-ink-soft"><%= t("demographics.form.withdraw_body") %></p>
      <%= button_to t("demographics.form.withdraw"), demographics_path, method: :delete,
            form: { data: { turbo_confirm: t("demographics.form.withdraw_confirm") } },
            class: "btn-stitch-ghost w-full justify-center" %>
    </div>
  <% end %>
</div>

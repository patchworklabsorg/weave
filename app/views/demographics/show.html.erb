<%# The member's demographics form (see DemographicsController). It always
    starts empty: Weave cannot read the answers back. After a failed save it
    shows what the member just sent. %>
<% content_for :title, t("demographics.form.title") %>
<% submitted = params.fetch(:demographics, {}) %>

<div class="page page-narrow space-y-6">
  <%= page_header(t("demographics.form.title"), lede: t("demographics.form.intro")) %>

  <section class="card">
    <div class="card-body space-y-3 text-sm">
      <p class="text-ink"><%= t("demographics.form.required") %></p>
      <p class="text-ink-soft"><%= t("demographics.form.sealed") %></p>
      <p class="text-ink-soft"><%= t("demographics.form.age_band") %></p>
      <p>
        <%= link_to t("demographics.data_page_link"), Weave.data_page_url, class: "link", target: "_blank", rel: "noopener noreferrer" %>
      </p>
      <p class="font-medium text-ink">
        <%= @answered_at ? t("demographics.form.answered", date: l(@answered_at.to_date, format: :long)) : t("demographics.form.not_answered") %>
      </p>
    </div>
  </section>

  <section class="card">
    <div class="card-body">
      <% if @available %>
        <%= form_with url: demographics_path, method: :patch, class: "space-y-6" do |form| %>
          <%= hidden_field_tag :return_to, @return_to if @return_to %>
          <% DemographicsVault.fields.each do |field| %>
            <% key = field[:key] %>
            <fieldset class="field-group<%= " is-invalid" if @form_errors&.key?(key.to_sym) %>">
              <legend class="field-label mb-2"><%= demographic_field_label(key) %></legend>
              <div class="space-y-2">
                <% DemographicsVault.options_for(field).each do |option| %>
                  <label class="choice">
                    <% if field[:type] == "multi" %>
                      <%= check_box_tag "demographics[#{key}][]", option, Array(submitted[key]).include?(option), id: "demographics_#{key}_#{option}", class: "checkbox" %>
                    <% else %>
                      <%= radio_button_tag "demographics[#{key}]", option, submitted[key] == option, id: "demographics_#{key}_#{option}", required: true, class: "radio" %>
                    <% end %>
                    <span><%= demographic_option_label(key, option) %></span>
                  </label>
                <% end %>
              </div>
              <% if field[:self_describe] %>
                <div class="field-group mt-3">
                  <%= label_tag "demographics_#{key}_self_description", t("demographics.form.self_description"), class: "field-label" %>
                  <%= text_field_tag "demographics[#{key}_self_description]", submitted["#{key}_self_description"],
                        maxlength: DemographicsVault::SELF_DESCRIPTION_MAX, autocomplete: "off",
                        aria: { describedby: "demographics_#{key}_self_description_hint" },
                        class: "field" %>
                  <p id="demographics_<%= key %>_self_description_hint" class="field-hint"><%= t("demographics.form.self_description_hint") %></p>
                </div>
              <% end %>
              <% if @form_errors&.key?(key.to_sym) %>
                <p class="field-error"><%= @form_errors[key.to_sym] %></p>
              <% end %>
            </fieldset>
          <% end %>

          <p class="text-sm text-ink-soft"><%= t("demographics.form.why") %></p>

          <%= form.submit t("demographics.form.submit"), class: "btn btn-primary btn-block" %>
        <% end %>
      <% else %>
        <p class="text-sm text-ink-soft"><%= t("demographics.form.unavailable") %></p>
      <% end %>
    </div>
  </section>

  <% consent_funders = FunderProfiles.all.select(&:consent_required?) %>
  <% if consent_funders.any? %>
    <section class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title"><%= t("funder_consents.title") %></h2>
          <p class="card-lede"><%= t("funder_consents.intro") %></p>
        </div>
      </div>
      <div class="card-body">
        <% live = current_user.funder_consents.live.pluck(:funder) %>
        <div class="record-list">
          <% consent_funders.each do |profile| %>
            <div class="record flex-wrap">
              <div class="record-main">
                <p class="text-sm text-ink">
                  <span class="font-medium"><%= profile.name %></span>:
                  <%= live.include?(profile.key) ? t("funder_consents.counted") : t("funder_consents.not_counted") %>
                </p>
              </div>
              <div class="record-actions">
                <% if live.include?(profile.key) %>
                  <%= button_to t("funder_consents.withdraw"), funder_consent_path(profile.key), method: :delete, class: "btn btn-secondary btn-sm" %>
                <% else %>
                  <%= button_to t("funder_consents.give"), funder_consents_path(funder: profile.key), method: :post, class: "btn btn-secondary btn-sm" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <% if @answered_at %>
    <section class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title"><%= t("demographics.form.withdraw_title") %></h2>
          <p class="card-lede"><%= t("demographics.form.withdraw_body") %></p>
        </div>
      </div>
      <div class="card-body">
        <%= button_to t("demographics.form.withdraw"), demographics_path, method: :delete,
              form: { data: { turbo_confirm: t("demographics.form.withdraw_confirm") } },
              class: "btn btn-danger" %>
      </div>
    </section>
  <% end %>
</div>

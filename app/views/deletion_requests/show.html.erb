<%# The member asks to delete their account (see DeletionRequestsController). %>
<% content_for :title, t("data_handling.deletion.title") %>

<div class="page page-narrow space-y-6">
  <%= page_header(t("data_handling.deletion.title"), lede: t("data_handling.deletion.intro")) %>

  <section class="card">
    <div class="card-body space-y-3 text-sm text-ink">
      <p><%= t("data_handling.deletion.sla", review_days: DataRetention.review_sla.in_days.to_i, complete_days: DataRetention.complete_within.in_days.to_i) %></p>
      <p>
        <%= link_to t("data_handling.data_page_link"), Weave.data_page_url, class: "link", target: "_blank", rel: "noopener noreferrer" %>
      </p>
    </div>
  </section>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title"><%= t("data_handling.deletion.what_happens") %></h2>
    </div>
    <div class="card-body space-y-4 text-sm">
      <div class="record-list">
        <% @categories.each do |category| %>
          <div class="record">
            <div class="record-main">
              <p class="text-ink">
                <span class="font-semibold"><%= category.name %></span>:
                <%= t("data_handling.deletion.outcomes.#{category.outcome}") %>.
              </p>
              <p class="record-meta"><%= category.legal_basis %></p>
            </div>
          </div>
        <% end %>
      </div>
      <p class="text-ink-soft"><%= t("data_handling.deletion.knot_note") %></p>
    </div>
  </section>

  <% if @deletion_request&.pending_review? %>
    <section class="card">
      <div class="card-body space-y-4">
        <div class="callout callout-grape">
          <%= icon(:info, size: 18) %>
          <div class="callout-body">
            <p><%= t("data_handling.deletion.pending", date: @deletion_request.review_due_at.to_date.to_fs(:long)) %></p>
          </div>
        </div>
        <%= button_to t("data_handling.deletion.cancel"), deletion_request_path, method: :delete, class: "btn btn-secondary btn-block" %>
      </div>
    </section>
  <% elsif @deletion_request %>
    <div class="callout callout-grape">
      <%= icon(:info, size: 18) %>
      <div class="callout-body">
        <p><%= t("data_handling.deletion.in_progress") %></p>
      </div>
    </div>
  <% else %>
    <section class="card">
      <div class="card-body space-y-5">
        <p class="text-sm text-ink"><%= t("data_handling.deletion.export_first") %> <%= link_to t("data_handling.profile.export"), takeout_path, class: "link" %></p>

        <%= form_with url: deletion_request_path, method: :post, class: "space-y-5" do |form| %>
          <% if @form_errors&.any? %>
            <div class="callout callout-danger" role="alert">
              <%= icon(:circle_alert, size: 18) %>
              <div class="callout-body">
                <p><%= @form_errors.values.to_sentence %></p>
              </div>
            </div>
          <% end %>
          <div class="choice">
            <%= form.check_box :understand, { required: true, class: "checkbox" }, "1", nil %>
            <%= form.label :understand, t("data_handling.deletion.understand") %>
          </div>
          <div class="field-group">
            <%= form.label :confirmation, t("data_handling.deletion.confirmation_label"), class: "field-label" %>
            <%= form.text_field :confirmation, required: true, autocomplete: "off", class: "field" %>
          </div>
          <%= form.submit t("data_handling.deletion.button"), class: "btn btn-danger-solid btn-block" %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>

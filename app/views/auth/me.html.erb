<% content_for :title, "Who am I" %>

<div class="max-w-xl mx-auto px-4 py-10">
  <div class="patch patch-bound">
    <div class="quilt-binding"></div>
    <div class="p-6 sm:p-8">
      <h1 class="font-display text-2xl font-bold text-ink mb-4">You're signed in</h1>

      <dl class="divide-y divide-lavender-purple/20">
        <div class="flex justify-between gap-4 py-2.5">
          <dt class="text-sm text-ink-faint">Name</dt>
          <dd class="text-sm text-ink font-medium text-right"><%= current_user.full_name %></dd>
        </div>
        <div class="flex justify-between gap-4 py-2.5">
          <dt class="text-sm text-ink-faint">Email</dt>
          <dd class="text-sm text-ink font-medium text-right break-all"><%= current_user.email %></dd>
        </div>
        <div class="flex justify-between gap-4 py-2.5">
          <dt class="text-sm text-ink-faint">Weave ID</dt>
          <dd class="text-sm text-ink font-medium text-right break-all"><%= current_user.p_id %></dd>
        </div>
        <div class="flex justify-between gap-4 py-2.5">
          <dt class="text-sm text-ink-faint">Role</dt>
          <dd class="text-sm text-ink font-medium text-right"><%= current_user.role.humanize %></dd>
        </div>
      </dl>

      <div class="mt-6 flex gap-2">
        <%= link_to "View profile", profile_path, class: "btn-stitch text-sm" %>
        <%= button_to "Sign out", logout_path, method: :delete, class: "btn-stitch-ghost text-sm", form_class: "inline-block" %>
      </div>
    </div>
  </div>
</div>

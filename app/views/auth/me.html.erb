<% content_for :title, "Who am I" %>

<div class="page page-narrow">
  <%= page_header("You're signed in") %>

  <section class="card">
    <div class="card-body">
      <dl class="dl">
        <%= dl_row "Name", current_user.full_name %>
        <%= dl_row "Email", current_user.email %>
        <%= dl_row "Weave ID", current_user.p_id %>
        <%= dl_row "Role", current_user.role.humanize %>
      </dl>
    </div>
    <div class="card-footer">
      <div class="btn-row justify-end">
        <%= button_to "Sign out", logout_path, method: :delete, class: "btn btn-secondary", form_class: "inline-block" %>
        <%= link_to "View profile", profile_path, class: "btn btn-primary" %>
      </div>
    </div>
  </section>
</div>

<div id="login_form" class="absolute inset-0 flex items-center justify-center p-6">
<%= form_with(model: user, url: "/login", data: { turbo: true, controller: "login-form", action: "submit->login-form#submitForm" }, local: true, id: "login_form_element") do |f| %>
  <div class="patch patch-bound patch-tilt-l w-full max-w-md">
    <div class="quilt-binding"></div>
    <!-- Card Header -->
    <div class="p-9 pb-5 text-center">
      <h1 class="font-display text-3xl font-bold text-ink">Weave</h1>
      <p class="text-ink-soft mt-2">Please sign in to your account.</p>
    </div>

    <!-- Card Content -->
    <div class="px-9 pb-9 space-y-6">
      <div class="space-y-2">
        <%= f.label :email, "Email address", class: "block text-sm font-medium text-ink" %>
        <%= f.email_field :email,
            class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint",
            placeholder: "you@example.com",
            required: true,
            data: { login_form_target: "email", action: "input->login-form#emailChanged" } %>
      </div>

      <!-- Dynamic Password Field -->
      <div data-login-form-target="passwordContainer" class="space-y-2" style="display: none;">
        <%= f.label :password, "Password", class: "block text-sm font-medium text-ink" %>
        <%= f.password_field :password,
            class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint",
            placeholder: "Enter your password",
            data: { login_form_target: "password" } %>
      </div>

      <!-- Loading indicator -->
      <div data-login-form-target="loadingIndicator" class="text-center text-ink-soft" style="display: none;">
        <div class="inline-flex items-center">
          <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-grape" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Checking account...
        </div>
      </div>

      <!-- Dynamic Submit Button -->
      <div>
        <%= f.submit "Continue",
            data: { login_form_target: "submitButton" },
            class: "btn-stitch w-full disabled:opacity-50",
            disabled: true %>
      </div>

      <div class="text-center">
        <p class="text-sm text-ink-soft">
          Don't have an account? <%= link_to "Sign up", signup_path, class: "text-grape hover:text-ink font-medium underline decoration-dashed underline-offset-2" %>
        </p>
      </div>
    </div>
  </div>
<% end %>
</div>

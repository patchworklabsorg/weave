<div id="login_form" class="min-h-full flex items-center justify-center p-6">
  <%= form_with(model: user, url: "/login", data: { turbo: true, controller: "login-form fingerprint", action: "submit->login-form#submitForm" }, local: true, id: "login_form_element", class: "w-full max-w-md") do |f| %>
    <%= hidden_field_tag :fingerprint, "", data: { fingerprint_target: "fingerprint" } %>
    <%= hidden_field_tag :timezone, "", data: { fingerprint_target: "timezone" } %>
    <div class="patch patch-bound patch-tilt-l w-full">
      <div class="quilt-binding"></div>
      <div class="p-8 sm:p-9 space-y-6">
        <div class="text-center space-y-2">
          <%= render "shared/wordmark", size: :lg, href: nil %>
          <h1 class="font-display text-2xl font-bold text-ink">Sign in</h1>
          <p class="text-ink-soft text-sm">Please sign in to your account.</p>
        </div>

        <div class="field-group">
          <%= f.label :email, "Email address", class: "field-label" %>
          <%= f.email_field :email,
                class: "field",
                placeholder: "you@example.com",
                required: true,
                data: { login_form_target: "email", action: "input->login-form#emailChanged" } %>
        </div>

        <%# Shown by the login-form controller when the account uses a password. %>
        <div class="field-group" data-login-form-target="passwordContainer" style="display: none;">
          <%= f.label :password, "Password", class: "field-label" %>
          <%= f.password_field :password,
                class: "field",
                placeholder: "Enter your password",
                data: { login_form_target: "password" } %>
        </div>

        <div class="text-center text-sm text-ink-soft" data-login-form-target="loadingIndicator" style="display: none;">
          <span class="inline-flex items-center gap-2">
            <%= icon(:loader, class: "spinner text-grape") %>
            Checking account...
          </span>
        </div>

        <%# Enabled in the markup so the form still submits without scripts;
            the login-form controller disables it only while it checks the email. %>
        <%= f.submit "Send magic link",
              data: { login_form_target: "submitButton" },
              class: "btn btn-primary btn-block" %>


        <p class="text-center text-sm text-ink-soft">
          Don't have an account? <%= link_to "Sign up", signup_path, class: "link" %>
        </p>
      </div>
    </div>
  <% end %>
</div>

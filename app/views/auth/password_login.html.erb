<div id="login_form" class="absolute inset-0 flex items-center justify-center p-6">
<%= form_with(model: @user, url: "/login", data: { turbo: true, controller: "fingerprint" }, local: true) do |f| %>
  <%= hidden_field_tag :fingerprint, "", data: { fingerprint_target: "fingerprint" } %>
  <%= hidden_field_tag :timezone, "", data: { fingerprint_target: "timezone" } %>
  <div class="patch patch-tilt-l w-full max-w-md">
    <!-- Card Header -->
    <div class="p-9 pb-5 text-center">
      <h1 class="font-display text-3xl font-bold text-ink">Patchwork Labs</h1>
      <p class="text-ink-soft mt-2">Admin password login</p>
    </div>

    <!-- Card Content -->
    <div class="px-9 pb-9 space-y-6">
      <div class="space-y-2">
        <%= f.label :email, "Email address", class: "block text-sm font-medium text-ink" %>
        <%= f.email_field :email,
            class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint",
            placeholder: "admin@patchworklabs.org",
            required: true,
            autofocus: true %>
      </div>

      <div class="space-y-2">
        <%= f.label :password, "Password", class: "block text-sm font-medium text-ink" %>
        <%= f.password_field :password,
            class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint",
            placeholder: "Enter your password",
            required: true %>
      </div>

      <div>
        <%= f.submit "Sign In", class: "btn-stitch w-full" %>
      </div>

      <div class="text-center">
        <p class="text-sm text-ink-soft">
          <%= link_to "← Use magic link instead", login_path, class: "text-grape hover:text-ink font-medium underline decoration-dashed underline-offset-2" %>
        </p>
      </div>
    </div>
  </div>
<% end %>
</div>

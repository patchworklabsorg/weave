<div id="login_form" class="absolute inset-0 flex items-center justify-center p-6">
  <%= form_with(model: user, url: "/login", data: { turbo: true }) do |f| %>
    <div class="patch patch-tilt-l w-full max-w-md">
      <!-- Card Header -->
      <div class="p-9 pb-5 text-center">
        <h1 class="font-display text-3xl font-bold text-ink">Patchwork Labs</h1>
        <p class="text-ink-soft mt-2">Please sign in to your account.</p>

        <div class="mt-4 patch border-2 border-grape bg-grape-soft/40 p-4">
          <p class="text-sm text-ink text-center">
            <% if oauth_client_name.present? %>
              The website you are trying to log in to (<strong><%= oauth_client_name %></strong>) is using the Weave authentication system.
            <% else %>
              The website you are trying to log in to is using the Weave authentication system.
            <% end %>
            In this system you create a central account that is used to log into Patchwork services.
            Once you are logged into this account, you will automatically be logged in to the associated Patchwork services.
          </p>
        </div>
      </div>

      <!-- Card Content -->
      <div class="px-9 pb-9 space-y-6">
        <div class="space-y-2">
          <%= f.label :email, "Email address", class: "block text-sm font-medium text-ink" %>
          <%= f.email_field :email,
            class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint",
            placeholder: "you@example.com",
            required: true %>
        </div>

        <div class="space-y-2">
          <%= f.label :password, "Password", class: "block text-sm font-medium text-ink" %>
          <%= f.password_field :password,
            class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint",
            placeholder: "Enter your password",
            required: true %>
        </div>

        <%= f.submit "Sign in", class: "btn-stitch w-full" %>

        <div class="text-center">
          <p class="text-sm text-ink-soft">
            Don't have an account?
            <%= link_to "Sign up", signup_path, class: "text-grape hover:text-ink font-medium underline decoration-dashed underline-offset-2" %>
          </p>
        </div>
      </div>
    </div>
  <% end %>
</div>

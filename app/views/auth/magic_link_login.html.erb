<div class="min-h-full flex items-center justify-center p-6">
  <div class="patch patch-bound patch-tilt-r w-full max-w-md">
    <div class="quilt-binding"></div>
    <div class="p-8 sm:p-9 space-y-6">
      <div class="text-center space-y-2">
        <%= render "shared/wordmark", size: :lg, href: nil %>
        <h1 class="font-display text-2xl font-bold text-ink">Confirm your sign in</h1>
        <p class="text-ink-soft text-sm">
          You're about to sign in as
          <strong class="text-ink break-all"><%= @magic_link_user.email %></strong>.
        </p>
      </div>

      <% if @continues_to %>
        <div class="callout callout-grape">
          <%= icon(:info, size: 18) %>
          <div class="callout-body">
            <p>After you sign in, you continue to <strong><%= @continues_to %></strong>.</p>
          </div>
        </div>
      <% end %>

      <%# turbo: false, matching the OAuth authorize forms (see their comment): confirming
          while an OAuth flow is in progress can redirect straight through to /oauth/authorize
          and, when that authorization is already granted, on to the client's (cross-origin)
          redirect_uri in the same response chain. Turbo follows redirects via fetch(), which
          our CSP's connect-src (self https:) blocks for a plain-http cross-origin client like a
          local Krater -- silently breaking sign-in for any returning user. A real browser form
          submission navigates instead, which CSP does not restrict. %>
      <%= form_with(url: confirm_magic_link_path(token: @token), method: :post, data: { controller: "fingerprint", turbo: false }) do %>
        <%= hidden_field_tag :fingerprint, "", data: { fingerprint_target: "fingerprint" } %>
        <%= hidden_field_tag :timezone, "", data: { fingerprint_target: "timezone" } %>
        <%= submit_tag "Sign in", class: "btn btn-primary btn-block" %>
      <% end %>

      <p class="text-sm text-ink-faint text-center">
        This link can only be used once. If you didn't request it, close this page
        and nothing will happen.
      </p>

      <p class="text-center text-sm text-ink-soft">
        Not you? <%= link_to "Sign in with a different account", login_path, class: "link" %>
      </p>
    </div>
  </div>
</div>

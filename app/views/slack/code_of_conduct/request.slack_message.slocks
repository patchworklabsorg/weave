# The Slack DM that asks someone to accept the code of conduct
# (SlackService#post_code_of_conduct).
#
# @title       header text
# @paragraphs  plain-text paragraphs (mrkdwn is allowed)
# @action_text what to do with the button
# @button      { text:, action_id:, value: }
# @coc_url     the Code of Conduct, or nil
# @web_url     the /slack page, where people can also accept

header @title

@paragraphs.each { |paragraph| section paragraph, markdown: true }

if @coc_url.present?
  section ":scroll: *Code of Conduct*\nIt explains how we treat each other in Patchwork Labs.",
          markdown: true,
          accessory: button("Read it", "read_coc", url: @coc_url)
end

divider

section @action_text, markdown: true
actions [button(@button[:text], @button[:action_id], value: @button[:value], style: "primary")]

context [mrkdwn_text("You can also accept on Weave: <#{@web_url}|#{@web_url.delete_prefix('https://')}>")]

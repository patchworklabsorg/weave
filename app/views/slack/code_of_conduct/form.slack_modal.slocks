# The Slack form that accepts the code of conduct
# (SlackService#open_code_of_conduct_form).
#
# @ask_name         true to show the name fields
# @coc_url          the Code of Conduct, or nil
# @private_metadata JSON string

title "Code of Conduct"
submit "I accept"
close "Not now"
callback SlackService::CODE_OF_CONDUCT_FORM
private_metadata @private_metadata

if @coc_url.present?
  section t("code_of_conduct_form.intro"), markdown: true, accessory: button("Read it", "read_coc", url: @coc_url)
else
  section t("code_of_conduct_form.intro"), markdown: true
end

if @ask_name
  divider
  section t("code_of_conduct_form.name_why"), markdown: true
  input "First name", plain_text_input("value", max_length: 100), block_id: "first_name"
  input "Last name", plain_text_input("value", max_length: 100), block_id: "last_name"
end

divider
input "Code of Conduct", checkboxes("value", [option(t("code_of_conduct_form.accept_label"), "accept")]), block_id: "accept"

context [mrkdwn_text(":lock: *#{t('code_of_conduct_form.data_use_title')}*\n#{t('code_of_conduct_form.data_use')}")]

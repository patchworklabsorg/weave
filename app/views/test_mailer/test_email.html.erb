<h2 style="margin: 0 0 16px 0; color: #2a2050; font-size: 20px; font-weight: 700;">SMTP Test Email</h2>

<p style="margin: 0 0 16px 0; color: #2a2050;">This is a test email to verify the SMTP configuration is working correctly.</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="background-color: #f7f5fb; padding: 1em; border-radius: 8px; margin: 1em 0; width: 100%;">
  <tr>
    <td style="padding: 0.5em; font-weight: bold; color: #2a2050;">Environment:</td>
    <td style="padding: 0.5em; color: #2a2050;"><%= @environment %></td>
  </tr>
  <tr>
    <td style="padding: 0.5em; font-weight: bold; color: #2a2050;">Sent at:</td>
    <td style="padding: 0.5em; color: #2a2050;"><%= @timestamp.strftime("%Y-%m-%d %H:%M:%S %Z") %></td>
  </tr>
  <tr>
    <td style="padding: 0.5em; font-weight: bold; color: #2a2050;">From:</td>
    <td style="padding: 0.5em; color: #2a2050;"><%= Array(message.from).join(", ") %></td>
  </tr>
  <tr>
    <td style="padding: 0.5em; font-weight: bold; color: #2a2050;">Reply-to:</td>
    <td style="padding: 0.5em; color: #2a2050;"><%= Array(message.reply_to).join(", ") %></td>
  </tr>
</table>

<p style="background-color: #e3f5f0; border-left: 4px solid #2aa187; border-radius: 0 8px 8px 0; padding: 1em; margin: 1em 0; color: #17604f;">
  &#9989; If you're reading this, your SMTP configuration is working correctly!
</p>

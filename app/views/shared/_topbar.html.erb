<%# The member-pages top bar (layouts/application).
    Left: the sections (Home, Account, and Groups for group managers). Right: the
    command bar, the theme switch and the account menu, which holds the
    rarer links (Admin, Verification) and Sign out. Below 64rem the section
    links move into the account menu too. On an account page a second row
    carries the account tabs (shared/_account_tabs). %>
<% manages_groups = current_user&.managed_groups&.exists? %>
<header class="topbar">
  <div class="topbar-inner">
    <%= render "shared/wordmark" %>

    <% if current_user %>
      <nav class="topbar-nav" aria-label="Sections">
        <%= nav_link "Home", root_path, icon: :house %>
        <%= nav_link "Account", profile_path, icon: :user, active: account_section? %>
        <% if manages_groups %>
          <%= nav_link "Groups", groups_path, icon: :users, active: request.path.start_with?(groups_path) %>
        <% end %>
      </nav>
    <% end %>

    <div class="topbar-end">
      <% if current_user %>
        <button type="button" class="cmdk-trigger" data-command-bar-trigger aria-label="Search or jump to a page">
          <%= icon(:search) %>
          <span class="kbd">⌘K</span>
        </button>
        <%= render "shared/theme_toggle" %>

        <div class="menu" data-controller="menu" data-action="keydown->menu#keydown">
          <button type="button" class="account-trigger" aria-haspopup="menu" aria-expanded="false"
                  aria-label="Account menu for <%= current_user.full_name %>"
                  data-menu-target="button" data-action="menu#toggle">
            <%= avatar current_user, size: :sm %>
            <%= icon(:chevron_down, size: 14) %>
          </button>

          <div class="menu-panel" role="menu" aria-label="Account" data-menu-target="panel" hidden>
            <div class="menu-head">
              <div class="menu-head-name"><%= current_user.full_name %></div>
              <div class="menu-head-meta"><%= current_user.email %></div>
            </div>

            <div class="menu-group lg:hidden">
              <%= link_to root_path, class: "menu-item", role: "menuitem" do %>
                <%= icon(:house) %><span>Home</span>
              <% end %>
              <%= link_to profile_path, class: "menu-item", role: "menuitem" do %>
                <%= icon(:user) %><span>Account</span>
              <% end %>
              <% if manages_groups %>
                <%= link_to groups_path, class: "menu-item", role: "menuitem" do %>
                  <%= icon(:users) %><span>Groups</span>
                <% end %>
              <% end %>
            </div>

            <% identity_link = identity_home_link %>
            <% if current_user.admin? || identity_link %>
              <div class="menu-group">
                <% if current_user.admin? %>
                  <%= link_to admin_root_path, class: "menu-item", role: "menuitem" do %>
                    <%= icon(:layout_dashboard) %><span>Admin</span>
                  <% end %>
                <% end %>
                <% if identity_link %>
                  <% identity_label, identity_path, identity_icon = identity_link %>
                  <%= link_to identity_path, class: "menu-item", role: "menuitem" do %>
                    <%= icon(identity_icon) %><span><%= identity_label %></span>
                  <% end %>
                <% end %>
              </div>
            <% end %>

            <div class="menu-group">
              <% if impersonating? %>
                <%= button_to stop_impersonating_admin_users_path, method: :delete, class: "menu-item", form_class: "contents", role: "menuitem" do %>
                  <%= icon(:log_out) %><span>Stop impersonating</span>
                <% end %>
              <% else %>
                <%= button_to logout_path, method: :delete, class: "menu-item", form_class: "contents", role: "menuitem" do %>
                  <%= icon(:log_out) %><span>Sign out</span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <%= render "shared/theme_toggle" %>
        <%= link_to "Sign in", login_path, class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  </div>

  <% if current_user && account_section? %>
    <%= render "shared/account_tabs" %>
  <% end %>
</header>

<%# Small fixed marker on every page of the staging deployment (WEAVE_ENV=staging).
    Bottom-left, opposite the theme toggle, and ignores pointer events so it
    never covers a control. %>
<% if Weave.staging? %>
  <div class="fixed bottom-4 left-4 z-40 pointer-events-none select-none rounded-full bg-teal-soft px-3 py-1 text-xs font-semibold uppercase tracking-wide text-teal ring-1 ring-teal/30" role="status">
    Staging
  </div>
<% end %>

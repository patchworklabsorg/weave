<%# The US residency part of the member's verification page (see ResidencyFlow). Never ask about citizenship.
    The submit is the page's primary action only when the identity form above is hidden. %>
<%# locals: (latest:, check:, status:, blocker:, identity_form:) %>
<%
  message =
    if status == "pending" then t("residency.page.pending")
    elsif latest&.needs_resubmission? && latest.document_review? then t("residency.page.needs_resubmission", note: latest.resubmission_note)
    elsif check&.us_resident && blocker.nil? then t("residency.page.us_resident_renew", state: check.us_state_name, date: check.expires_at.to_date.strftime(TimeHelper::FORMATS[:date]))
    elsif check&.us_resident then t("residency.page.us_resident", state: check.us_state_name, date: check.expires_at.to_date.strftime(TimeHelper::FORMATS[:date]))
    elsif check then t("residency.page.not_us_resident")
    elsif latest&.end_reason == "address_changed" then t("residency.page.ended_address")
    elsif blocker == :not_open then t("residency.blockers.not_open")
    elsif blocker == :identity_needed then t("residency.page.identity_first")
    else t("residency.page.needs_check")
    end
%>
<section class="card" aria-labelledby="residency_title">
  <div class="card-header">
    <div>
      <h2 id="residency_title" class="card-title"><%= t("residency.page.title") %></h2>
      <p class="card-lede"><%= t("residency.page.intro") %></p>
    </div>
    <%= badge(t("residency.statuses.#{status}"), tone: status == "us_resident" ? :success : :grape, class: "shrink-0") %>
  </div>
  <div class="card-body space-y-4">
    <p class="text-sm text-ink"><%= message %></p>

    <% if blocker.nil? %>
      <%= form_with url: verification_residency_path, method: :post, multipart: true, class: "space-y-5" do |form| %>
        <div class="field-group">
          <%= form.label :evidence_type, t("residency.page.evidence_type"), class: "field-label" %>
          <%= form.select :evidence_type,
                (["id_document"] + ResidencyCheck::UPLOAD_EVIDENCE).map { |type| [t("residency.page.evidence.#{type}"), type] },
                { include_blank: true }, required: true, class: "field" %>
        </div>
        <div class="field-group">
          <%= form.label :residency_document, t("residency.page.document"), class: "field-label" %>
          <%= form.file_field :residency_document, required: true, accept: "image/jpeg,image/png,image/heic,image/heif,.heic,.heif,application/pdf",
                aria: { describedby: "residency_document_hint" }, class: "field" %>
          <p id="residency_document_hint" class="field-hint">
            <%= t("residency.page.document_hint", megabytes: VerificationSettings.max_image_size / 1.megabyte, days: VerificationSettings.purge_image_after_pass.in_days.to_i) %>
          </p>
        </div>
        <%= form.submit t("residency.page.submit"), class: "btn #{identity_form ? "btn-secondary" : "btn-primary"} btn-block" %>
      <% end %>
      <% unless check && !check.us_resident %>
        <%= button_to t("residency.page.not_resident"), not_resident_verification_residency_path, method: :post,
              class: "btn btn-quiet btn-block", data: { turbo_confirm: t("residency.page.not_resident_confirm") } %>
      <% end %>
    <% elsif blocker == :standing %>
      <p class="field-hint"><%= t("residency.blockers.standing", days: VerificationSettings.residency_renewal_reminder.in_days.to_i) %></p>
    <% end %>
  </div>
</section>

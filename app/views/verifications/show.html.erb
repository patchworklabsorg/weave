<%# The member's identity verification page (see VerificationsController). %>
<% content_for :title, t("verification.page.title") %>
<%
  status_message =
    if @latest.nil? then nil
    elsif @latest.reverification_required? then t("verification.page.reverification_required", reason: t("verification.reverification_reasons.#{@latest.reverification_reason}"))
    elsif @latest.ineligible? then t("verification.page.ineligible")
    elsif @latest.escalation_open? then t("verification.page.escalated")
    elsif @latest.failed? && @blocker == :cooldown then t("verification.page.failed", retry_date: @latest.retry_available_at.to_date.strftime(TimeHelper::FORMATS[:date]))
    elsif @latest.failed? then t("verification.page.failed_can_retry")
    elsif @latest.needs_resubmission? then t("verification.page.needs_resubmission", note: @latest.resubmission_note)
    elsif @latest.call_scheduled? then t("verification.page.call_scheduled", call_time: @latest.call_scheduled_for.utc.strftime(TimeHelper::FORMATS[:datetime]))
    else t("verification.page.#{@latest.status}")
    end
  accept = "image/jpeg,image/png,image/heic,image/heif,.heic,.heif,application/pdf"
%>

<div class="page page-narrow space-y-6">
  <%= page_header(t("verification.page.title"), lede: t("verification.page.intro")) %>

  <section class="card">
    <div class="card-body space-y-4">
      <dl class="dl">
        <%= dl_row(t("verification.page.status_label")) do %>
          <%= badge(t("verification.statuses.#{@status}"), tone: @status == "verified" ? :success : :grape) %>
        <% end %>
      </dl>

      <% if status_message %>
        <div class="callout callout-grape">
          <%= icon(:info, size: 18) %>
          <div class="callout-body">
            <p><%= status_message %></p>
          </div>
        </div>
      <% end %>

      <% if current_user.minor? && @status != "verified" %>
        <p class="text-sm text-ink">
          <%= t("verification.page.guardian_needed") %>
          <% if current_user.guardian_consent_missing? %>
            <%= link_to t("verification.page.guardian_consent_link"), guardian_consent_request_path, class: "link" %>
          <% end %>
        </p>
      <% end %>

      <% if @blocker && (@latest.nil? || !@latest.verified?) %>
        <% if @form_errors&.key?(:base) %>
          <div class="callout callout-danger" role="alert">
            <%= icon(:circle_alert, size: 18) %>
            <div class="callout-body">
              <p><%= @form_errors[:base] %></p>
            </div>
          </div>
        <% elsif %i[no_birthday under_minimum_age not_open].include?(@blocker) %>
          <p class="text-sm text-ink"><%= t("verification.blockers.#{@blocker}") %></p>
        <% end %>
      <% end %>

      <% if @latest&.verified? %>
        <p class="text-sm text-ink-soft"><%= t("knot.member.name_change") %></p>
        <p class="text-sm text-ink-soft"><%= t("knot.member.notice") %></p>
      <% end %>

      <% if @attempts.size > 1 || @latest&.decided? %>
        <details>
          <summary class="text-sm text-ink-soft cursor-pointer"><%= t("verification.page.history") %></summary>
          <ul class="mt-2 space-y-1 text-sm text-ink-faint">
            <% @attempts.each do |attempt| %>
              <li><%= time_label(attempt.created_at) %>: <%= attempt.status.humanize %></li>
            <% end %>
          </ul>
        </details>
      <% end %>
    </div>
  </section>

  <% if @blocker.nil? %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title"><%= t("verification.page.steps_title") %></h2>
      </div>
      <div class="card-body space-y-6">
        <div class="space-y-3 text-sm">
          <ol class="list-decimal pl-5 space-y-1 text-ink">
            <% t("verification.page.steps").each do |step| %>
              <li><%= step %></li>
            <% end %>
          </ol>
          <p class="text-ink-soft">
            <%= t("verification.page.data", days: VerificationSettings.purge_image_after_pass.in_days.to_i) %>
            <%= link_to t("verification.data_page_link"), Weave.data_page_url, class: "link", target: "_blank", rel: "noopener" %>
          </p>
          <p class="text-ink-soft"><%= t("knot.member.notice") %></p>
        </div>

        <%= form_with url: verification_path, method: :post, multipart: true, class: "space-y-5" do |form| %>
          <% if @form_errors&.key?(:base) %>
            <div class="callout callout-danger" role="alert">
              <%= icon(:circle_alert, size: 18) %>
              <div class="callout-body">
                <p><%= @form_errors[:base] %></p>
              </div>
            </div>
          <% end %>
          <div class="field-group<%= " is-invalid" if @form_errors&.key?(:document_type) %>">
            <%= form.label :document_type, t("verification.page.document_type"), class: "field-label" %>
            <%= form.select :document_type,
                  Verification::DOCUMENT_TYPES.map { |type| [t("verification.page.document_types.#{type}"), type] },
                  { selected: params[:document_type] }, required: true, class: "field" %>
            <% if @form_errors&.key?(:document_type) %>
              <p class="field-error"><%= @form_errors[:document_type] %></p>
            <% end %>
          </div>
          <div class="field-group<%= " is-invalid" if @form_errors&.key?(:id_document) %>">
            <%= form.label :id_document, t("verification.page.document"), class: "field-label" %>
            <%= form.file_field :id_document, required: true, accept: accept,
                  aria: { describedby: "id_document_hint" }, class: "field" %>
            <p id="id_document_hint" class="field-hint"><%= t("verification.page.document_hint", megabytes: VerificationSettings.max_image_size / 1.megabyte) %></p>
            <% if @form_errors&.key?(:id_document) %>
              <p class="field-error"><%= @form_errors[:id_document] %></p>
            <% end %>
          </div>
          <fieldset class="field-group">
            <legend class="field-label"><%= t("residency.page.submission_title") %></legend>
            <p class="field-hint"><%= t("residency.page.submission_hint") %></p>
            <%= form.label :residency_evidence_type, t("residency.page.evidence_type"), class: "field-label" %>
            <%= form.select :residency_evidence_type,
                  ResidencyCheck::UPLOAD_EVIDENCE.map { |type| [t("residency.page.evidence.#{type}"), type] },
                  { include_blank: t("residency.page.evidence_none"), selected: params[:residency_evidence_type] },
                  class: "field" %>
            <%= form.file_field :residency_document, accept: accept,
                  aria: { label: t("residency.page.document") }, class: "field" %>
            <% %i[residency_evidence_type residency_document].each do |key| %>
              <% if @form_errors&.key?(key) %><p class="field-error"><%= @form_errors[key] %></p><% end %>
            <% end %>
          </fieldset>
          <div class="field-group">
            <div class="choice">
              <%= form.check_box :data_notice_read, { required: true, class: "checkbox" }, "1", nil %>
              <%= form.label :data_notice_read do %>
                <%= t("verification.page.data_notice_read") %>
                (<%= link_to t("verification.data_page_link"), Weave.data_page_url, class: "link", target: "_blank", rel: "noopener" %>)
              <% end %>
            </div>
            <% if @form_errors&.key?(:data_notice_read) %>
              <p class="field-error"><%= @form_errors[:data_notice_read] %></p>
            <% end %>
          </div>
          <%= form.submit(@latest ? t("verification.page.resubmit") : t("verification.page.submit"), class: "btn btn-primary btn-block") %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= render "verifications/residency", latest: @residency_latest, check: @residency_check, status: @residency_status,
                                         blocker: @residency_blocker, identity_form: @blocker.nil? %>

  <p class="text-sm text-center">
    <%= link_to t("verification.data_page_link"), Weave.data_page_url, class: "link", target: "_blank", rel: "noopener" %>
  </p>
</div>

<% content_for :title, "Key custody" %>

<%= page_header("Key custody",
      lede: "Each stored ID image is sealed to a master public key. The master private key exists only as " \
            "#{KeyCustody.share_count} shares, one for each key holder. Any #{KeyCustody.threshold} holders open an image, " \
            "each with one of their hardware keys. Weave never stores the private key or a share.") do %>
  <% if KeyCustody::Ceremony.can_run?(current_user) && KeyCustody::Ceremony.blocker.nil? %>
    <%= link_to new_identity_key_ceremony_path, class: "btn btn-primary" do %><%= icon(:key_round) %><%= @current ? "Rotate: run a new ceremony" : "Run the key ceremony" %><% end %>
  <% end %>
<% end %>

<div class="space-y-6">
  <% if (warning = KeyCustody.warning) %>
    <div class="callout callout-warning" role="alert">
      <%= icon(:triangle_alert, size: 18) %>
      <div class="callout-body"><p><%= warning %></p></div>
    </div>
  <% end %>

  <% if KeyCustody::Ceremony.can_run?(current_user) && (ceremony_blocker = KeyCustody::Ceremony.blocker) %>
    <div class="callout">
      <%= icon(:info, size: 18) %>
      <div class="callout-body"><p class="text-ink-soft"><%= ceremony_blocker %></p></div>
    </div>
  <% end %>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Key sets</h2>
    </div>
    <% if @key_sets.any? %>
      <div class="card-body">
        <ul class="record-list">
          <% @key_sets.each do |key_set| %>
            <li class="record flex-col items-stretch gap-3">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div class="record-main">
                  <p class="record-title flex flex-wrap items-center gap-2">
                    <span class="mono"><%= key_set.public_id %></span>
                    <%= badge(key_set.status.to_s, tone: { "active" => :success, "pending" => :warning, "compromised" => :danger }.fetch(key_set.status.to_s, :neutral)) %>
                  </p>
                  <p class="record-meta">
                    <%= "(#{key_set.compromised_reason.to_s.humanize.downcase}), " if key_set.compromised_at %>any <%= key_set.threshold %> of <%= key_set.share_count %>
                    <%= "· rotation of #{key_set.rotated_from.public_id}" if key_set.rotated_from %>
                  </p>
                </div>
                <p class="text-sm text-ink-soft">
                  Holders: <%= key_set.shares.map { |share| share.holder&.full_name || "a deleted user" }.to_sentence %>
                </p>
              </div>
              <% if key_set.pending? %>
                <% if key_set.compromised_at %>
                  <div class="callout callout-warning">
                    <%= icon(:triangle_alert, size: 18) %>
                    <div class="callout-body"><p>The key holders changed after this ceremony. Discard it and run a new ceremony.</p></div>
                  </div>
                <% else %>
                  <div class="well space-y-2">
                    <p class="text-sm text-ink-soft">
                      Waits for activation by every holder. Shares given now: <%= @activation_progress[:new] %> of <%= key_set.share_count %> new
                      <% if key_set.rotation? %>, <%= @activation_progress[:old] %> of <%= key_set.rotated_from.threshold %> old<% end %>.
                      A share waits, encrypted, for <%= VerificationSettings.pending_share_ttl.inspect %>.
                    </p>
                    <% waiting_ids = KeyCustody::Activation.waiting_holder_ids(key_set) %>
                    <ul class="space-y-0.5 text-sm text-ink">
                      <% key_set.shares.each do |share| %>
                        <li class="flex items-center gap-1.5">
                          <%= icon(waiting_ids.include?(share.holder_id) ? :circle_check : :circle_dashed, class: waiting_ids.include?(share.holder_id) ? "text-success" : "text-ink-faint") %>
                          <span>
                            <%= share.holder&.full_name || "a deleted user" %>:
                            <%= waiting_ids.include?(share.holder_id) ? "share given" : "not yet" %>
                          </span>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                  <% if waiting_ids.include?(current_user.id) && !key_set.rotation? %>
                    <p class="text-sm text-ink-soft">You gave your share. The key set goes live when every holder has given theirs.</p>
                  <% elsif KeyCustody::Activation.can_submit?(current_user, key_set) %>
                    <div class="space-y-1" data-controller="key-custody"
                         data-key-custody-options-url-value="<%= activation_options_identity_key_set_path(key_set) %>"
                         data-key-custody-submit-url-value="<%= activate_identity_key_set_path(key_set) %>">
                      <button type="button" class="btn btn-secondary" data-action="key-custody#activate">
                        <%= icon(:key_round) %>Activate with my hardware key<%= " (new and old share)" if key_set.rotation? %>
                      </button>
                      <p class="field-hint" data-key-custody-target="status" aria-live="polite"></p>
                    </div>
                  <% end %>
                <% end %>
                <% if KeyCustody::Ceremony.can_discard?(current_user) %>
                  <%= form_with url: discard_identity_key_set_path(key_set), method: :patch, class: "flex flex-col sm:flex-row gap-2" do |form| %>
                    <%= form.text_field :reason, required: true, placeholder: "Why discard this key set?",
                          aria: { label: "Why discard #{key_set.public_id}?" }, class: "field sm:flex-1" %>
                    <%= form.submit "Discard", class: "btn btn-secondary" %>
                  <% end %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <% blocker = KeyCustody::Ceremony.blocker %>
      <%= empty_state("No key set yet",
            body: (if KeyCustody::Ceremony.can_run?(current_user)
                     blocker || "You hold a key, so you can run the ceremony."
                   else
                     "A key holder with an active hardware key runs the ceremony. #{blocker}".strip
                   end),
            icon: :key_round) %>


    <% end %>
  </section>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Key holders and their hardware keys</h2>
    </div>
    <% if @holders.any? %>
      <div class="card-body">
        <ul class="record-list">
          <% @holders.each do |holder| %>
            <li class="record">
              <div class="record-main">
                <p class="record-title"><%= holder.full_name %></p>
                <p class="record-meta">
                  <%= holder.identity_hardware_keys.select(&:active?).map { |key| "#{key.label}#{' (seal key not set up)' unless key.sealable?}" }.to_sentence.presence || "no hardware key" %>
                </p>
              </div>
              <% ready = holder.identity_hardware_keys.to_a.count(&:sealable?) %>
              <%= badge("#{ready} of #{VerificationSettings.hardware_keys_per_holder} ready", tone: ready >= VerificationSettings.hardware_keys_per_holder ? :success : :warning) %>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <%= empty_state("No key holders. The board adds them through governance.", icon: :users) %>
    <% end %>
  </section>

  <% if KeyCustody.holder?(current_user) %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title">My hardware keys</h2>
      </div>
      <div class="card-body space-y-4">
        <% if @my_keys.any? %>
          <ul class="record-list">
            <% @my_keys.each do |key| %>
              <li class="record flex-col items-stretch gap-3">
                <div class="record-main">
                  <p class="record-title flex flex-wrap items-center gap-2">
                    <%= key.label %>
                    <% unless key.active? %><%= badge("Revoked", tone: :danger) %><% end %>
                  </p>
                  <p class="record-meta">
                    Enrolled <%= time_label(key.created_at) %>.
                    <% if key.active? %>
                      <%= @my_share && KeyCustody::Recovery.keys_for(@my_share).include?(key) ? "Opens your share." : "Holds no share of the current key set." %>
                    <% else %>
                      Revoked <%= time_label(key.revoked_at) %>: <%= key.revoked_reason %>.
                    <% end %>
                  </p>
                </div>
                <% if key.active? && !key.sealable? %>
                  <div class="space-y-2" data-controller="key-custody"
                       data-key-custody-options-url-value="<%= seal_key_options_identity_hardware_key_path(key) %>"
                       data-key-custody-submit-url-value="<%= seal_key_identity_hardware_key_path(key) %>">
                    <div class="callout callout-warning">
                      <%= icon(:triangle_alert, size: 18) %>
                      <div class="callout-body"><p>This key has no seal key yet, so no share can be sealed to it.</p></div>
                    </div>
                    <button type="button" class="btn btn-secondary" data-action="key-custody#registerSealKey">Set up the seal key of this key</button>
                    <p class="field-hint" data-key-custody-target="status" aria-live="polite"></p>
                  </div>
                <% end %>
                <% if key.active? %>
                  <% if key.sealable? && @my_share && KeyCustody::Recovery.keys_for(@my_share).exclude?(key) && KeyCustody::Recovery.keys_for(@my_share).any? %>
                    <div class="space-y-1" data-controller="key-custody"
                         data-key-custody-options-url-value="<%= rewrap_options_identity_hardware_key_path(key) %>"
                         data-key-custody-submit-url-value="<%= rewrap_identity_hardware_key_path(key) %>">
                      <button type="button" class="btn btn-secondary" data-action="key-custody#rewrap">Seal my share for this key</button>
                      <p class="field-hint" data-key-custody-target="status" aria-live="polite"></p>
                    </div>
                  <% end %>
                  <%= form_with url: revoke_identity_hardware_key_path(key), method: :patch, class: "flex flex-col sm:flex-row gap-2" do |form| %>
                    <%= form.text_field :reason, required: true, placeholder: "Lost, broken or stolen: say what happened",
                          aria: { label: "Why revoke #{key.label}?" }, class: "field sm:flex-1" %>
                    <%= form.submit "Revoke", class: "btn btn-danger",
                          data: { turbo_confirm: "Revoke this key? Its sealed share is deleted and the board is told. With no key left, the key set must be rotated." } %>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
        <% if KeyCustody::Enrollment.can_enroll?(current_user) %>
          <div class="<%= 'border-t border-hairline pt-4 ' if @my_keys.any? %>space-y-1.5" data-controller="key-custody"
               data-key-custody-options-url-value="<%= options_identity_hardware_keys_path %>"
               data-key-custody-submit-url-value="<%= identity_hardware_keys_path %>">
            <div class="flex flex-col sm:flex-row gap-2">
              <label class="sr-only" for="hardware_key_role">Role</label>
              <select id="hardware_key_role" class="field sm:w-40" data-key-custody-target="role">
                <% KeyCustody::Enrollment.open_roles(current_user).each do |role| %>
                  <option value="<%= role %>"><%= role.capitalize %></option>
                <% end %>
              </select>
              <label class="sr-only" for="hardware_key_nickname">Name</label>
              <input id="hardware_key_nickname" type="text" maxlength="60" autocomplete="off" placeholder="Name, for example the colour of the key"
                     class="field sm:flex-1" data-key-custody-target="nickname">
              <button type="button" class="btn btn-secondary" data-action="key-custody#enroll"><%= icon(:plus) %>Enroll a hardware key</button>
            </div>
            <p class="field-hint" data-key-custody-target="status" aria-live="polite"></p>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Log</h2>
    </div>
    <% if @events.any? %>
      <div class="card-body">
        <ul class="record-list">
          <% @events.each do |event| %>
            <li class="record">
              <div class="record-main">
                <p class="record-title"><%= event.summary %></p>
                <p class="record-meta"><%= time_label(event.created_at, :datetime) %></p>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="card-body text-sm text-ink-faint">Nothing yet.</p>
    <% end %>
  </section>
</div>

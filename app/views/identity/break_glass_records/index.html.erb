<% content_for :title, "Break-glass" %>

<header class="page-header">
  <div class="min-w-0">
    <p class="text-sm"><%= link_to "All verifications", identity_verifications_path, class: "link-quiet text-ink-soft" %></p>
    <h1 class="page-title">Break-glass access to ID images</h1>
    <p class="page-lede">
      A stored ID image opens only with two approvals from different key holders. A key holder approves with a hardware key:
      the key opens their share of the master key. The second share seals the image's key to a one-time key in the browser of the
      person who asked. The approvers do not see the image. Only the person who asked can open it, once, in that browser, within
      <%= VerificationSettings.break_glass_handoff_ttl.inspect %>. Weave keeps no key it can open: to see the image again, ask again.
      Each open tells the key holders who approved, the identity team lead, the member after
      <%= VerificationSettings.member_notice_delay.inspect %>, and the board.
    </p>
  </div>
</header>

<div class="space-y-6">
  <% if (warning = KeyCustody.warning) %>
    <div class="callout callout-warning" role="alert">
      <%= icon(:triangle_alert, size: 18) %>
      <div class="callout-body"><p><%= warning %> <%= link_to "Key custody", identity_key_custody_path, class: "link" %></p></div>
    </div>
  <% end %>

  <% if @ready.any? %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Ready for you to open</h2>
      </div>
      <div class="card-body">
        <ul class="record-list">
          <% @ready.each_with_index do |record, index| %>
            <li class="record flex-col items-stretch gap-3"
                data-controller="break-glass"
                data-break-glass-url-value="<%= open_identity_break_glass_record_path(record) %>"
                data-break-glass-request-id-value="<%= record.public_id %>">
              <p class="text-sm text-ink">
                <span class="mono"><%= record.public_id %></span>: <%= record.reason %>. Open it once, in the browser you asked from, before
                <%= record.handoff_expires_at.utc.strftime("%H:%M UTC") %>.
              </p>
              <div>
                <button type="button" class="btn <%= index.zero? ? 'btn-primary' : 'btn-secondary' %>" data-break-glass-target="button" data-action="break-glass#open"><%= icon(:eye) %>Open</button>
              </div>
              <p class="field-hint" data-break-glass-target="status" aria-live="polite"></p>
              <div data-break-glass-target="canvas"></div>
            </li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Waiting for approval</h2>
    </div>
    <% if @pending.any? %>
      <div class="card-body">
        <ul class="record-list">
          <% @pending.each do |record| %>
            <li class="record flex-col items-stretch gap-3">
              <div class="record-main space-y-1">
                <p class="record-title">
                  <span class="mono"><%= record.public_id %></span> for <%= link_to record.verification.public_id, identity_verification_path(record.verification), class: "link mono" %>,
                  asked by <%= record.requested_by&.full_name || "a deleted user" %> <%= time_ago_in_words(record.created_at) %> ago.
                </p>
                <p class="text-sm text-ink-soft">Reason: <%= record.reason %></p>
                <% in_memory = BreakGlass.pending_share_holder_ids(record) %>
                <p class="record-meta">
                  Approvals: <%= record.approvers.map(&:full_name).to_sentence.presence || "none" %> (<%= VerificationSettings.break_glass_approvals_required %> needed).
                  A share waits, encrypted, for <%= VerificationSettings.pending_share_ttl.inspect %>.
                  <% lapsed = record.approvals.select(&:lapsed?).filter_map(&:approver) - record.approvers.to_a %>
                  <%= "Lapsed, must approve again: #{lapsed.map(&:full_name).to_sentence}." if lapsed.any? %>
                </p>
              </div>
              <% if BreakGlass.may_approve?(current_user, record) && (record.approvers.exclude?(current_user) || in_memory.exclude?(current_user.id)) %>
                <div class="flex flex-col sm:flex-row sm:items-start gap-2">
                  <div class="space-y-1" data-controller="key-custody"
                       data-key-custody-options-url-value="<%= approval_options_identity_break_glass_record_path(record) %>"
                       data-key-custody-submit-url-value="<%= approve_identity_break_glass_record_path(record) %>">
                    <button type="button" class="btn btn-secondary" data-action="key-custody#approve"><%= icon(:key_round) %>Approve with my hardware key</button>
                    <p class="field-hint" data-key-custody-target="status" aria-live="polite"></p>
                  </div>
                  <%= form_with url: deny_identity_break_glass_record_path(record), method: :patch, class: "flex flex-1 flex-col sm:flex-row gap-2" do |form| %>
                    <%= form.text_field :reason, required: true, placeholder: "Why deny?", aria: { label: "Why deny?" }, class: "field sm:flex-1" %>
                    <%= form.submit "Deny", class: "btn btn-secondary" %>
                  <% end %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="card-body text-sm text-ink-faint">Nothing waits.</p>
    <% end %>
  </section>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Member notices not sent yet</h2>
    </div>
    <% if @member_notices.any? %>
      <div class="card-body">
        <ul class="record-list">
          <% @member_notices.each do |notice| %>
            <li class="record flex-col items-stretch gap-3">
              <p class="text-sm text-ink">
                <span class="mono"><%= notice.break_glass_record.public_id %></span>: notice to <%= notice.recipient&.full_name || "a deleted user" %>,
                due <%= notice.due_at.utc.strftime("%b %-d %H:%M UTC") %>.
                <% if notice.delayed? %>
                  <strong>Delay asked</strong> by <%= notice.delayed_by&.full_name || "a deleted user" %>: <%= notice.delay_reason %>.
                  <% if notice.delay_signed_off? %>
                    Signed off by <%= notice.delay_signed_off_by&.full_name || "a deleted user" %>. The notice goes out on
                    <%= notice.delay_ends_at.utc.strftime("%b %-d %H:%M UTC") %> at the latest.
                  <% else %>
                    Not signed off yet: the notice goes out when it is due.
                  <% end %>
                <% end %>
              </p>
              <% if notice.delayed? %>
                <div class="btn-row">
                  <% if !notice.delay_signed_off? && BreakGlass.may_sign_off_delay?(current_user, notice) %>
                    <%= button_to "Sign off the delay", sign_off_delay_identity_break_glass_notice_path(notice), method: :patch, class: "btn btn-secondary btn-sm",
                          data: { turbo_confirm: "Sign off this delay? The board report lists it." } %>
                  <% end %>
                  <%= button_to "Lift the delay", lift_delay_identity_break_glass_notice_path(notice), method: :patch, class: "btn btn-secondary btn-sm" %>
                </div>
              <% elsif notice.recipient_id != current_user.id %>
                <%= form_with url: delay_identity_break_glass_notice_path(notice), method: :patch, class: "flex flex-col sm:flex-row gap-2" do |form| %>
                  <%= form.text_field :reason, required: true, placeholder: "Active fraud investigation: give the reason",
                        aria: { label: "Reason for the delay" }, class: "field sm:flex-1" %>
                  <%= form.submit "Delay the notice", class: "btn btn-secondary",
                        data: { turbo_confirm: "Ask to delay this notice? An owner or the identity team lead must sign it off. The lead is told, and the board report lists it." } %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="card-body text-sm text-ink-faint">None.</p>
    <% end %>
  </section>

  <% if @recent.any? %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Recent requests</h2>
      </div>
      <div class="card-body">
        <ul class="record-list">
          <% @recent.each do |record| %>
            <li class="record">
              <div class="record-main">
                <p class="record-title"><span class="mono"><%= record.public_id %></span>: <%= record.status %>, asked by <%= record.requested_by&.full_name || "a deleted user" %></p>
                <p class="record-meta"><%= time_ago_in_words(record.created_at) %> ago. <%= "Denied: #{record.denial_reason}" if record.denied? %></p>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>
</div>

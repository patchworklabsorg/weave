<% content_for :title, "Identity team governance" %>

<%= page_header("Identity team governance",
      lede: "An owner proposes a new verifier or a lead change, and a different board member approves it. " \
            "A key holder change needs every board member. Any owner or identity team lead removes a member at once. " \
            "The rule of each role is in the Roles section below (config/roles.yml).") %>

<div class="space-y-6">
  <% if @bootstrap_open %>
    <div class="callout callout-warning">
      <%= icon(:triangle_alert, size: 18) %>
      <div class="callout-body">
        <p>Bootstrap open: no member of the identity team is verified yet. Follow the bootstrap steps in docs/KYC_ROLLOUT.md.</p>
      </div>
    </div>
  <% end %>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">The identity team</h2>
    </div>
    <% if @team.any? %>
      <div class="card-body">
        <ul class="record-list">
          <% @team.each do |member| %>
            <li class="record flex-col items-stretch gap-3">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div class="record-main">
                  <p class="record-title flex flex-wrap items-center gap-2">
                    <span><%= member.full_name %> <span class="mono text-ink-faint">(<%= member.p_id %>)</span></span>
                    <% if member.identity_key_holder %><span class="text-ink-soft font-normal">· key holder</span><% end %>
                    <% if member.identity_lead %><span class="text-ink-soft font-normal">· lead</span><% end %>
                  </p>
                </div>
                <p class="text-sm text-ink-soft"><%= member.verification_status.humanize %>.</p>
              </div>
              <% if IdentityGovernance.can_remove?(current_user, member) %>
                <%= form_with url: identity_team_removals_path, method: :post, class: "flex flex-col sm:flex-row gap-2" do |form| %>
                  <%= form.hidden_field :user_id, value: member.p_id %>
                  <%= form.text_field :reason, required: true, placeholder: "Reason for the removal",
                        aria: { label: "Reason to remove #{member.full_name}" }, class: "field field-sm sm:flex-1" %>
                  <%= form.submit "Remove now", class: "btn btn-danger btn-sm",
                        data: { turbo_confirm: "Remove #{member.full_name} from the identity team now? This also revokes the key holder and lead roles. The board gets an email." } %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <%= empty_state("Nobody is on the identity team.", icon: :users) %>
    <% end %>
  </section>

  <section class="card">
    <div class="card-header">
      <div>
        <h2 id="roles" class="card-title">Roles</h2>
        <p class="card-lede">
          Each role, who has it, and its grant rule. Staff and contractor change on the
          <%= link_to "staff and contractors page", admin_role_assignments_path, class: "link" %>,
          and board member and the removal of a patch lead on the roles section of a user's admin page.
        </p>
      </div>
    </div>
    <div class="card-body">
      <ul class="record-list">
        <% RoleRegistry.definitions.each_value do |definition| %>
          <% assignments = @role_assignments.fetch(definition.key, []) %>
          <li class="record flex-col items-stretch gap-1">
            <div class="flex flex-wrap justify-between gap-x-4 gap-y-1">
              <span class="record-title"><%= definition.name %><%= " (scoped by program)" if definition.scopable? %></span>
              <span class="record-meta">Grant: <%= RoleGrants.rule_text(definition.key, :grant) %> Revoke: <%= RoleGrants.rule_text(definition.key, :revoke) %></span>
            </div>
            <p class="text-sm text-ink-soft">
              <% if assignments.any? %>
                <%= safe_join(assignments.map { |assignment| "#{assignment.user&.full_name || 'A deleted user'}#{" (#{assignment.scope})" if assignment.scope}" }, "; ") %>
              <% else %>
                Nobody.
              <% end %>
            </p>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <section class="card">
    <div class="card-header">
      <div class="flex items-center gap-2">
        <h2 class="card-title">Proposals that wait</h2>
        <%= badge(@pending.size.to_s, tone: @pending.any? ? :warning : :neutral) %>
      </div>
    </div>
    <% if @pending.any? %>
      <div class="card-body">
        <ul class="record-list">
          <% @pending.each do |proposal| %>
            <li class="record flex-wrap">
              <div class="record-main">
                <p class="record-title flex flex-wrap items-baseline gap-x-2">
                  <%= link_to proposal.public_id, identity_governance_proposal_path(proposal), class: "link mono" %>
                  <span><%= proposal.description.upcase_first %></span>
                </p>
              </div>
              <span class="record-meta">
                Proposed by <%= proposal.proposed_by&.full_name || "a deleted user" %>.
                <%= proposal.expired_now? ? "Expired." : "Expires #{proposal.expires_at.utc.strftime('%Y-%m-%d')}." %>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="card-body text-sm text-ink-faint">Nothing waits.</p>
    <% end %>
  </section>

  <% if IdentityGovernance.can_propose?(current_user) %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Propose a change</h2>
      </div>
      <div class="card-body">
        <%= form_with url: identity_governance_proposals_path, method: :post, class: "space-y-4" do |form| %>
          <div class="field-group">
            <%= form.label :person, "Person (Weave ID or email)", class: "field-label" %>
            <%= form.text_field :person, required: true, class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :kind, "Change", class: "field-label" %>
            <%= form.select :kind, IdentityGovernance.proposable_kinds.map { |kind| [IdentityGovernanceProposal.describe(kind, "this person").upcase_first, kind] },
                  {}, class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :scope, "Program (for a patch lead only)", class: "field-label" %>
            <%= form.select :scope, KnotSettings.programs.map { |program| [program.name, program.key] }, { include_blank: "None" },
                  class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :reason, "Reason", class: "field-label" %>
            <%= form.text_area :reason, required: true, rows: 3, class: "field" %>
          </div>
          <%= form.submit "Propose", class: "btn btn-primary" %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Closed proposals</h2>
    </div>
    <% if @recent.any? %>
      <div class="card-body">
        <ul class="record-list">
          <% @recent.each do |proposal| %>
            <li class="record">
              <p class="record-title">
                <%= link_to proposal.public_id, identity_governance_proposal_path(proposal), class: "link mono" %>
                <%= proposal.description.upcase_first %>: <%= proposal.status %>.
              </p>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="card-body text-sm text-ink-faint">None yet.</p>
    <% end %>
  </section>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Log</h2>
    </div>
    <% if @events.any? %>
      <div class="card-body">
        <ul class="record-list">
          <% @events.each do |event| %>
            <li class="record">
              <div class="record-main">
                <p class="record-title"><%= event.summary %></p>
                <p class="record-meta">
                  <%= event.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %>
                  <% if event.data["reason"].present? %><span class="text-ink-soft">Reason: <%= event.data["reason"] %></span><% end %>
                </p>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="card-body text-sm text-ink-faint">Nothing logged yet.</p>
    <% end %>
  </section>

  <section class="card">
    <div class="card-header">
      <div>
        <h2 id="permanent-log" class="card-title">Permanent log of privileged attributes</h2>
        <p class="card-lede">Every grant and revoke of a role (with its scope), and every change to the admin tier (role). Database triggers write it. Nobody can change or delete a row.</p>
      </div>
    </div>
    <% if @privileged_changes.any? %>
      <div class="card-body">
        <ul class="record-list">
          <% @privileged_changes.each do |change| %>
            <li class="record">
              <div class="record-main">
                <p class="record-title"><%= change.summary %></p>
                <p class="record-meta"><%= change.changed_at.utc.strftime("%Y-%m-%d %H:%M UTC") %> <span class="text-ink-soft">By <%= change.actor_name %>.</span></p>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="card-body text-sm text-ink-faint">No changes logged yet.</p>
    <% end %>
  </section>
</div>

<% content_for :title, "Verification" %>

<%= page_header("Identity verification",
      lede: "Take an attempt for pre-review, check the document, then set the call. Nobody verifies their own account, " \
            "and nobody who failed a member can verify them again.") do %>
  <%= link_to identity_break_glass_records_path, class: "btn btn-secondary" do %><%= icon(:key_round) %>Break-glass<% end %>
  <% if current_user.admin? %>
    <%= link_to admin_break_glass_report_path, class: "btn btn-secondary" do %><%= icon(:file_text) %>Board report<% end %>
  <% end %>
<% end %>

<%
  sections = [
    ["Escalations for the lead", @escalations, ->(v) { "Escalated #{time_ago_in_words(v.escalated_at)} ago" }],
    ["Waiting for pre-review", @awaiting_pre_review, ->(v) { "Submitted #{time_ago_in_words(v.created_at)} ago" }],
    ["In pre-review", @in_pre_review, ->(v) { "Pre-reviewer: #{v.pre_reviewer&.full_name || 'a deleted user'}" }],
    ["Document OK: agree a call time", @awaiting_call, ->(v) { "Document OK #{time_ago_in_words(v.pre_reviewed_at)} ago" }],
    ["Calls", @calls, ->(v) { "Call on #{v.call_scheduled_for.utc.strftime('%b %-d, %Y %H:%M UTC')}" }],
    ["Recently closed", @recent, ->(v) { "#{v.status.humanize}, #{time_ago_in_words(v.updated_at)} ago" }]
  ]
%>

<div class="space-y-6">
  <% sections.each do |title, verifications, detail| %>
    <section class="card">
      <div class="card-header">
        <div class="flex items-center gap-2">
          <h2 class="card-title"><%= title %></h2>
          <%= badge(verifications.size.to_s, tone: verifications.any? ? :grape : :neutral) %>
        </div>
      </div>
      <% if verifications.any? %>
        <div class="card-body">
          <ul class="record-list">
            <% verifications.each do |verification| %>
              <li class="record flex-wrap">
                <div class="record-main">
                  <p class="record-title flex flex-wrap items-baseline gap-x-2">
                    <%= link_to verification.public_id, identity_verification_path(verification), class: "link mono" %>
                    <span><%= verification.user&.full_name || "A deleted account" %></span>
                  </p>
                </div>
                <span class="record-meta"><%= detail.call(verification) %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <p class="card-body text-sm text-ink-faint">Nothing here.</p>
      <% end %>
    </section>
  <% end %>
</div>

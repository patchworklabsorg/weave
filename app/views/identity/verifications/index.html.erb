<% content_for :title, "Verification" %>

<div class="mb-6 flex flex-wrap justify-between items-start gap-4">
  <div>
    <h2 class="font-display text-2xl font-bold text-ink mb-2">Identity verification</h2>
    <p class="text-ink-soft">
      Take an attempt for pre-review, check the document, then set the call. Nobody verifies their own account,
      and nobody who failed a member can verify them again.
    </p>
  </div>
  <div class="flex gap-2">
    <%= link_to "Break-glass", identity_break_glass_records_path, class: "btn-stitch-ghost" %>
    <% if current_user.admin? %>
      <%= link_to "Board report", admin_break_glass_report_path, class: "btn-stitch-ghost" %>
    <% end %>
  </div>
</div>

<%
  sections = [
    ["Escalations for the lead", @escalations, ->(v) { "Escalated #{time_ago_in_words(v.escalated_at)} ago" }],
    ["Waiting for pre-review", @awaiting_pre_review, ->(v) { "Submitted #{time_ago_in_words(v.created_at)} ago" }],
    ["In pre-review", @in_pre_review, ->(v) { "Pre-reviewer: #{v.pre_reviewer&.full_name || 'a deleted user'}" }],
    ["Document OK: agree a call time", @awaiting_call, ->(v) { "Document OK #{time_ago_in_words(v.pre_reviewed_at)} ago" }],
    ["Calls", @calls, ->(v) { "Call on #{v.call_scheduled_for.utc.strftime('%b %-d, %Y %H:%M UTC')}" }],
    ["Recently closed", @recent, ->(v) { "#{v.status.humanize}, #{time_ago_in_words(v.updated_at)} ago" }]
  ]
%>

<% sections.each do |title, verifications, detail| %>
  <h3 class="font-display text-lg font-bold text-ink mb-3"><%= title %></h3>
  <div class="patch overflow-hidden mb-8">
    <% if verifications.any? %>
      <ul class="divide-y divide-ink-soft/10">
        <% verifications.each do |verification| %>
          <li class="px-6 py-3 flex flex-wrap justify-between gap-2">
            <span class="text-sm text-ink">
              <%= link_to verification.public_id, identity_verification_path(verification), class: "font-mono hover:text-grape" %>
              <%= verification.user&.full_name || "A deleted account" %>
            </span>
            <span class="text-sm text-ink-soft"><%= detail.call(verification) %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="px-6 py-4 text-sm text-ink-faint">Nothing here.</p>
    <% end %>
  </div>
<% end %>

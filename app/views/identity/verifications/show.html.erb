<% content_for :title, "Verification #{@verification.public_id}" %>
<%
  own = @user && @user == current_user
  excluded = @excluded_ids.include?(current_user.id)
  status_tone = { "verified" => :success, "failed" => :danger, "ineligible" => :danger, "escalated" => :warning }.fetch(@verification.status, :neutral)
%>

<header class="page-header">
  <div class="min-w-0">
    <p class="text-sm"><%= link_to "All verifications", identity_verifications_path, class: "link-quiet text-ink-soft" %></p>
    <h1 class="page-title"><span class="mono"><%= @verification.public_id %></span>: <%= @verification.status.humanize %></h1>
    <div class="page-lede flex flex-wrap items-center gap-1.5">
      <% if @user %>
        <span>
          <% if current_user.admin? %><%= link_to @user.full_name, admin_user_path(@user), class: "link-quiet" %><% else %><%= @user.full_name %><% end %>
          (<span class="mono"><%= @user.p_id %></span>)
        </span>
        <%= badge(@user.minor? ? "under 18" : "18 or older", tone: @user.minor? ? :orchid : :neutral) %>
        <span>Member status: <%= @user.verification_status.humanize %>.</span>
      <% else %>
        <span>The account was deleted.</span>
      <% end %>
    </div>
  </div>
  <% if !own && @verification.submitted? %>
    <div class="page-actions">
      <%= button_to "Take for pre-review", start_pre_review_identity_verification_path(@verification), method: :patch, class: "btn btn-primary" %>
    </div>
  <% end %>
</header>

<div class="space-y-6">
  <% if own %>
    <div class="callout callout-info">
      <%= icon(:info, size: 18) %>
      <div class="callout-body"><p>This is your own verification. Another identity team member must handle it.</p></div>
    </div>
  <% end %>

  <% if @verification.knot_review_reason %>
    <div class="callout callout-warning">
      <%= icon(:triangle_alert, size: 18) %>
      <div class="callout-body">
        <p class="callout-title">Manual review</p>
        <p><%= t("knot.review_reasons.#{@verification.knot_review_reason}") %></p>
      </div>
    </div>
  <% end %>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Attempt</h2>
    </div>
    <div class="card-body">
      <dl class="dl">
        <%= dl_row "Method", @verification.verification_method.humanize %>
        <%= dl_row "Document", @verification.document_type&.humanize || "none" %>
        <%= dl_row "Image", @verification.document_stored? ? "stored, encrypted" : (@verification.document_purged_at ? "purged #{@verification.document_purged_at.to_date.to_fs(:long)}" : "none") %>
        <% if @verification.knot && current_user.identity_team && current_user.admin? %>
          <%= dl_row("Knot") do %>
            <span class="flex flex-wrap items-center gap-2">
              <%= link_to @verification.knot.public_id, admin_knot_path(@verification.knot), class: "link mono" %>
              <% if @verification.knot.blacklisted %><%= badge("fraud flag set", tone: :danger) %><% end %>
            </span>
          <% end %>
        <% end %>
      </dl>
    </div>
  </section>

  <% if !own && @verification.pre_review? %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Pre-review</h2>
      </div>
      <div class="card-body space-y-4">
        <% if @verification.pre_reviewer == current_user %>
          <p class="text-sm text-ink-soft">Each view of the image is logged. Open it only to check the document.</p>
          <%= render "shared/secure_image_viewer", url: image_identity_verification_path(@verification), label: "Show the ID image" %>
          <% if @residency_check&.document&.attached? %>
            <p class="text-sm text-ink-soft">
              The member also uploaded a US residency document: <%= @residency_check.evidence_label.downcase %>.
              Check that it is readable and current. You record the residency result on the call.
            </p>
            <%= render "shared/secure_image_viewer", url: residency_image_identity_verification_path(@verification), label: "Show the residency document" %>
          <% end %>
        <% else %>
          <p class="text-sm text-ink-soft">
            <%= @verification.pre_reviewer&.full_name || "A deleted user" %> is the pre-reviewer. Only they can open the image and mark the document OK.
            If they can't finish it, you can take it over. The hand-over is logged.
          </p>
          <%= button_to "Take over pre-review", take_over_pre_review_identity_verification_path(@verification), method: :patch, class: "btn btn-secondary",
                data: { turbo_confirm: "Take over this pre-review? You become the pre-reviewer, and the hand-over is logged." } %>
        <% end %>
        <% if @verification.pre_reviewer == current_user %>
          <div class="space-y-1.5 border-t border-hairline pt-4">
            <%= button_to approve_document_identity_verification_path(@verification), method: :patch, class: "btn btn-primary",
                  data: { turbo_confirm: "Mark the document OK? Pre-review ends, and you can no longer see the image." } do %>
              <%= icon(:check) %>Document OK
            <% end %>
            <p class="field-hint">Pre-review ends. Then agree a call time with the member by email or Slack, and record it here.</p>
          </div>
        <% end %>
        <%= form_with url: reject_document_identity_verification_path(@verification), method: :patch, class: "field-group border-t border-hairline pt-4" do |form| %>
          <%= form.text_area :note, required: true, rows: 2, placeholder: "What must the member fix? The member sees this note.",
                aria: { label: "What must the member fix?" }, class: "field" %>
          <div>
            <%= form.submit "Send back: ask for a new document", class: "btn btn-secondary" %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if !own && (@verification.awaiting_call? || @verification.call_scheduled?) %>
    <section class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title"><%= @verification.call_scheduled? ? "Move the call" : "Record the agreed call time" %></h2>
          <% if @verification.awaiting_call? %>
            <p class="card-lede">
              The document is OK. Agree a call time with <%= @user&.first_name || "the member" %> by email or Slack first. Then record it here.
            </p>
          <% end %>
        </div>
      </div>
      <div class="card-body space-y-1.5">
        <%= form_with url: schedule_call_identity_verification_path(@verification), method: :patch, class: "flex flex-col sm:flex-row gap-2" do |form| %>
          <%= form.datetime_local_field :call_scheduled_for, required: true, aria: { label: "Call time (UTC)" }, class: "field sm:flex-1" %>
          <%= form.submit "Record the call time", class: "btn btn-secondary" %>
        <% end %>
        <p class="field-hint">Times are UTC. We email the member to confirm.</p>
      </div>
    </section>
  <% end %>

  <% if !own && @verification.call_scheduled? %>
    <section class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title">Record the call outcome</h2>
          <p class="card-lede">
            Call on <%= @verification.call_scheduled_for.utc.strftime("%b %-d, %Y %H:%M UTC") %>. You are the verifier.
            Do not record the call. Write what you checked.
          </p>
        </div>
      </div>
      <div class="card-body">
        <% if excluded %>
          <div class="callout callout-warning">
            <%= icon(:triangle_alert, size: 18) %>
            <div class="callout-body"><p>You failed this member before. A different verifier must run this call.</p></div>
          </div>
        <% else %>
          <% values = @decision_values || {} %>
          <% typed = values[:identifiers] || {} %>
          <% mismatch = @mismatch || {} %>
          <%= form_with url: decide_identity_verification_path(@verification), method: :patch, class: "space-y-6", html: { autocomplete: "off" } do |form| %>
            <div class="form-grid form-grid-2">
              <div class="field-group">
                <%= form.label :second_verifier, class: "field-label" do %>Second verifier <span class="optional">(optional)</span><% end %>
                <%= form.select :second_verifier, @team.reject { |member| @excluded_ids.include?(member.id) }.map { |member| [member.full_name, member.p_id] },
                      { include_blank: "None", selected: values[:second_verifier] }, class: "field" %>
              </div>
              <% if @user&.minor? %>
                <label class="choice sm:mt-7">
                  <%= form.check_box :guardian_attended, checked: values[:guardian_attended], class: "checkbox" %>
                  <span>A parent or guardian attended (a pass needs this)</span>
                </label>
              <% end %>
            </div>

            <fieldset class="space-y-3">
              <legend class="field-label mb-3">Consistency attestation. Do not write down values from the ID. Never check gender.</legend>
              <div class="form-grid form-grid-2">
                <% { age_consistent: "The self-reported age does not contradict the ID", region_consistent: "The self-reported region does not contradict the ID" }.each do |field, label| %>
                  <div class="field-group">
                    <%= form.label field, label, class: "field-label font-normal" %>
                    <%= form.select field, [["Choose", ""], ["Yes", "yes"], ["No", "no"]], { selected: values[field] }, required: true, class: "field" %>
                  </div>
                <% end %>
              </div>
            </fieldset>

            <fieldset class="space-y-3">
              <legend class="field-label">Weave keeps document and national ID numbers only as one-way hashes for the fraud check. The name and birthday must match the member's account.</legend>
              <p class="field-hint">Type the legal name and the birthday from the ID. Weave compares them with the account when you record a pass.</p>
              <div class="form-grid form-grid-2">
                <%= form.fields_for :identifiers do |ids| %>
                  <%= ids.select :document_type, Verification::DOCUMENT_TYPES.map { |type| [type.humanize, type] },
                        { selected: typed[:document_type].presence || @verification.document_type }, aria: { label: "Document type" }, class: "field" %>
                  <%= ids.text_field :issuing_country, value: typed[:issuing_country], maxlength: 2, placeholder: "Issuing country (two letters)", aria: { label: "Issuing country" }, class: "field" %>
                  <%= ids.text_field :document_number, value: typed[:document_number], placeholder: "Document number", aria: { label: "Document number" }, class: "field" %>
                  <%= ids.text_field :national_id, value: typed[:national_id], placeholder: "National identity number (if any)", aria: { label: "National identity number" }, class: "field" %>
                  <div class="field-group">
                    <%= ids.text_field :legal_name, value: typed[:legal_name], placeholder: "Legal name on the ID", aria: { label: "Legal name", invalid: mismatch.key?(:identifiers_legal_name) },
                          class: "field" %>
                    <% if mismatch.key?(:identifiers_legal_name) %><p class="field-error">The name does not match the account.</p><% end %>
                  </div>
                  <div class="field-group">
                    <%= ids.date_field :date_of_birth, value: typed[:date_of_birth], aria: { label: "Date of birth", invalid: mismatch.key?(:identifiers_date_of_birth) },
                          class: "field" %>
                    <% if mismatch.key?(:identifiers_date_of_birth) %><p class="field-error">The birthday does not match the account.</p><% end %>
                  </div>
                <% end %>
              </div>
            </fieldset>

            <fieldset class="space-y-3">
              <legend class="field-label">US residency (a pass needs a result). Check where the member lives. Never ask about citizenship.</legend>
              <p class="field-hint">
                Yes needs a US driver's license, learner's permit or state ID with a current US address, or the proof document the member uploaded
                <%= @residency_check&.document_stored? ? "(#{@residency_check.evidence_label.downcase})" : "(none uploaded)" %>.
                A US passport alone does not show where the member lives. Weave keeps only the result, the state, the evidence type and the date.
              </p>
              <div class="form-grid form-grid-3">
                <div class="field-group">
                  <%= form.label :us_resident, "Lives in the US", class: "field-label font-normal" %>
                  <%= form.select :us_resident, [["Choose", ""], ["Yes", "yes"], ["No", "no"]], { selected: values[:us_resident] }, class: "field" %>
                </div>
                <div class="field-group">
                  <%= form.label :us_state, "US state (for yes)", class: "field-label font-normal" %>
                  <%= form.select :us_state, ResidencyCheck::US_STATES.map { |code, name| [name, code] }, { include_blank: true, selected: values[:us_state] }, class: "field" %>
                </div>
                <div class="field-group">
                  <%= form.label :residency_evidence, "Evidence (for yes)", class: "field-label font-normal" %>
                  <%= form.select :residency_evidence, (["id_document"] + ResidencyCheck::UPLOAD_EVIDENCE).map { |type| [ResidencyCheck::EVIDENCE_TYPES[type], type] },
                        { include_blank: true, selected: values[:residency_evidence] }, class: "field" %>
                </div>
              </div>
            </fieldset>

            <div class="field-group">
              <%= form.text_area :reason, value: values[:reason], required: true, rows: 3, placeholder: "Written reason: what you checked on the call and why you decided",
                    aria: { label: "Written reason" }, class: "field" %>
            </div>

            <div class="btn-row border-t border-hairline pt-4">
              <%= form.button "Verified", name: "outcome", value: "verified", class: "btn btn-primary",
                    data: { turbo_confirm: "Record a pass?" } %>
              <%= form.button "Failed", name: "outcome", value: "failed", class: "btn btn-danger",
                    data: { turbo_confirm: "Record a fail? The member waits for the cooldown, and you can't verify them again." } %>
              <%= form.button "Failed: details don't match the account", name: "details_mismatch", value: "1", formnovalidate: true,
                    class: "btn btn-danger", data: { turbo_confirm: "Record a fail because the details on the ID don't match the account?" } %>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if !own && @verification.escalation_open? %>
    <section class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title">Escalation</h2>
          <% if @user %>
            <p class="card-lede">This member failed <%= VerificationFlow.failed_calls_since_reset(@user) %> calls. Read the chain below.</p>
          <% end %>
        </div>
      </div>
      <div class="card-body">
        <% if current_user.identity_lead %>
          <%= form_with url: resolve_escalation_identity_verification_path(@verification), method: :patch, class: "field-group" do |form| %>
            <%= form.text_area :note, required: true, rows: 2, placeholder: "Why?", aria: { label: "Why?" }, class: "field" %>
            <div class="btn-row mt-1">
              <%= form.button "Allow one more round", name: "resolution", value: "retry_allowed", class: "btn btn-secondary" %>
              <%= form.button "Close the case (ineligible)", name: "resolution", value: "ineligible", class: "btn btn-danger",
                    data: { turbo_confirm: "Close the case? The member can't verify again." } %>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-ink-faint">Only an identity team lead can resolve it.</p>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @verification.decided? %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Decision</h2>
        <%= badge(@verification.status.humanize, tone: status_tone) %>
      </div>
      <div class="card-body space-y-4">
        <dl class="dl">
          <%= dl_row "Outcome", "#{@verification.status.humanize}, #{@verification.decided_at.to_fs(:long)}" %>
          <%= dl_row "Verifier", "#{@verification.verifier&.full_name || 'a deleted user'}#{", second verifier: #{@verification.second_verifier&.full_name || 'a deleted user'}" if @verification.second_verifier_id}" %>
          <%= dl_row "Guardian attended", @verification.guardian_attended ? "yes" : "no" %>
          <%= dl_row "Age consistent", @verification.age_consistent ? "yes" : "no" %>
          <%= dl_row "Region consistent", @verification.region_consistent ? "yes" : "no" %>
          <%= dl_row "Reason", @verification.decision_reason %>
          <% if @residency_check&.decided? && !@residency_check.us_resident.nil? %>
            <%= dl_row "US residency", @residency_check.us_resident ? "yes, #{@residency_check.us_state_name} (#{@residency_check.evidence_label.downcase})" : "no" %>
          <% end %>
        </dl>
        <% if @verification.reverification_required? %>
          <div class="callout callout-warning">
            <%= icon(:triangle_alert, size: 18) %>
            <div class="callout-body">
              <p>This pass no longer stands: <%= @verification.reverification_reason.humanize %>, <%= @verification.reverification_required_at.to_fs(:long) %>. The member needs a new call.</p>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if !own && @verification.document_sealed? && BreakGlass.request_blocker(@verification).nil? %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Break-glass</h2>
      </div>
      <div class="card-body space-y-4">
        <p class="text-sm text-ink-soft">
          To open the stored image, ask with a reason. Two key holders must approve, each with a hardware key. Then only you can open the image,
          once, in this browser, within <%= VerificationSettings.break_glass_handoff_ttl.inspect %>: your browser makes a one-time key for the request,
          and the approvers do not see the image. The open tells the key holders who approved, the lead, the member
          (after <%= VerificationSettings.member_notice_delay.inspect %>) and the board.
        </p>
        <%= form_with url: identity_verification_break_glass_records_path(@verification), method: :post, class: "field-group",
                      data: { controller: "break-glass", action: "submit->break-glass#ask",
                              break_glass_url_value: identity_verification_break_glass_records_path(@verification),
                              break_glass_redirect_url_value: identity_break_glass_records_path } do |form| %>
          <%= form.text_area :reason, required: true, rows: 2, minlength: 10, placeholder: "Why do you need the image itself?",
                aria: { label: "Why do you need the image?" }, class: "field", data: { break_glass_target: "reason" } %>
          <div class="mt-1">
            <%= form.submit "Ask for break-glass access", class: "btn btn-secondary", data: { break_glass_target: "button" } %>
          </div>
          <p class="field-hint" data-break-glass-target="status" aria-live="polite"></p>
        <% end %>
        <% if @break_glass_records.any? %>
          <ul class="record-list border-t border-hairline">
            <% @break_glass_records.each do |record| %>
              <li class="record">
                <span class="record-meta"><span class="mono"><%= record.public_id %></span>: <%= record.status %>, asked by <%= record.requested_by&.full_name || "a deleted user" %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Attempt chain</h2>
    </div>
    <div class="card-body">
      <ol class="record-list">
        <% @chain.each do |attempt| %>
          <li class="record">
            <div class="record-main">
              <p class="record-title">
                <%= link_to_unless attempt == @verification, attempt.public_id, identity_verification_path(attempt), class: "link mono" do %><span class="mono"><%= attempt.public_id %></span><% end %>:
                <%= attempt.status.humanize %>, <%= attempt.created_at.to_date.to_fs(:long) %>
              </p>
              <% if attempt.decided? %>
                <p class="record-meta">(verifier: <%= attempt.verifier&.full_name || "a deleted user" %>)</p>
              <% end %>
            </div>
            <% if attempt == @verification %><%= badge("This attempt", tone: :grape) %><% end %>
          </li>
        <% end %>
      </ol>
    </div>
  </section>

  <section class="card card-flush">
    <div class="card-header">
      <h2 class="card-title">Audit record</h2>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">When</th>
            <th scope="col">Event</th>
            <th scope="col">By</th>
            <th scope="col">Details</th>
          </tr>
        </thead>
        <tbody>
          <% @events.each do |event| %>
            <tr>
              <td class="whitespace-nowrap text-xs text-ink-soft"><%= event.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %></td>
              <td><%= event.kind.humanize %></td>
              <td><%= event.actor&.full_name || (event.actor_id ? "A deleted user" : "Weave") %></td>
              <td class="mono text-ink-soft break-all"><%= event.data.to_json %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>

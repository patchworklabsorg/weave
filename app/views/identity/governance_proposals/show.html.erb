<% content_for :title, "Identity team proposal" %>
<% status = @proposal.expired_now? ? "expired" : @proposal.status %>

<header class="page-header">
  <div class="min-w-0">
    <p class="text-sm"><%= link_to "Back to governance", identity_governance_path, class: "link-quiet text-ink-soft" %></p>
    <h1 class="page-title"><%= @proposal.description.upcase_first %></h1>
    <p class="page-lede">
      <span class="mono"><%= @proposal.public_id %></span>.
      Proposed by <%= @proposal.proposed_by&.full_name || "a deleted user" %> on <%= @proposal.created_at.utc.strftime("%Y-%m-%d") %>.
      Status: <%= status %>.
      <% if @proposal.pending? %>Expires <%= @proposal.expires_at.utc.strftime("%Y-%m-%d %H:%M UTC") %>.<% end %>
    </p>
  </div>
  <% if IdentityGovernance.can_withdraw?(@proposal, current_user) %>
    <div class="page-actions">
      <%= form_with url: withdraw_identity_governance_proposal_path(@proposal), method: :patch do |form| %>
        <%= form.submit "Withdraw the proposal", class: "btn btn-secondary" %>
      <% end %>
    </div>
  <% end %>
</header>

<div class="space-y-6">
  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Proposal</h2>
      <%= badge(status.to_s.humanize, tone: { "applied" => :success, "approved" => :success, "rejected" => :danger, "pending" => :warning }.fetch(status.to_s, :neutral)) %>
    </div>
    <div class="card-body space-y-2 text-sm">
      <p class="text-ink">Reason: <%= @proposal.reason %></p>
      <% if @proposal.close_reason.present? %>
        <p class="text-ink-soft">Closing note: <%= @proposal.close_reason %></p>
      <% end %>
    </div>
  </section>

  <% if @preconditions %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Preconditions (checked again at the approval)</h2>
      </div>
      <div class="card-body">
        <ul class="record-list">
          <% @preconditions.each do |check| %>
            <li class="record items-start justify-start">
              <%= badge(check.met ? "Met" : "Not met", tone: check.met ? :success : :danger, icon: check.met ? :check : :x) %>
              <div class="record-main">
                <p class="record-title"><%= { verified: "verified by another verifier", adult: "#{IdentityGovernanceSettings.verifier_minimum_age} or older", nda: "signed NDA on record" }.fetch(check.key) %>.</p>
                <p class="record-meta"><%= check.detail %></p>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>

  <section class="card">
    <div class="card-header">
      <div>
        <h2 class="card-title">Approvals</h2>
        <p class="card-lede">
          <% if @proposal.key_holder_change? %>
            Every board member at the time of the proposal must approve.
          <% else %>
            One board member who did not make the proposal, and who is not its subject, must approve.
          <% end %>
        </p>
      </div>
    </div>
    <div class="card-body">
      <ul class="record-list">
        <% if @proposal.key_holder_change? %>
          <% User.where(id: @proposal.required_approver_ids).order(:first_name).each do |member| %>
            <% approved = @proposal.approver_ids.include?(member.id) %>
            <li class="record">
              <span class="record-title"><%= member.full_name %></span>
              <%= badge(approved ? "approved" : "not yet", tone: approved ? :success : :neutral) %>
            </li>
          <% end %>
        <% else %>
          <% @proposal.approvals.includes(:approver).each do |approval| %>
            <li class="record">
              <span class="record-title"><%= approval.approver&.full_name || "A deleted user" %> approved on <%= approval.created_at.utc.strftime("%Y-%m-%d") %>.</span>
            </li>
          <% end %>
        <% end %>
      </ul>
    </div>
    <% if @proposal.open? && IdentityGovernance.can_approve?(@proposal, current_user) %>
      <div class="card-footer flex flex-col sm:flex-row sm:items-center gap-3">
        <%= form_with url: approve_identity_governance_proposal_path(@proposal), method: :patch do |form| %>
          <%= form.submit "Approve", class: "btn btn-primary", data: { turbo_confirm: "Approve: #{@proposal.description}?" } %>
        <% end %>
        <%= form_with url: reject_identity_governance_proposal_path(@proposal), method: :patch, class: "flex flex-1 flex-col sm:flex-row gap-2" do |form| %>
          <%= form.text_field :reason, required: true, placeholder: "Why reject?", aria: { label: "Why reject?" }, class: "field sm:flex-1" %>
          <%= form.submit "Reject", class: "btn btn-secondary" %>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Log</h2>
    </div>
    <div class="card-body">
      <ul class="record-list">
        <% @events.each do |event| %>
          <li class="record">
            <div class="record-main">
              <p class="record-title"><%= event.summary %></p>
              <p class="record-meta">
                <%= event.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %>
                <% if event.data["reason"].present? %><span class="text-ink-soft">Reason: <%= event.data["reason"] %></span><% end %>
              </p>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
</div>

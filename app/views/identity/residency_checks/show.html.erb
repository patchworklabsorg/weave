<% content_for :title, "US residency check #{@check.public_id}" %>
<%
  own = @user && @user == current_user
  pre_reviewer = @check.pre_reviewer == current_user
%>

<header class="page-header">
  <div class="min-w-0">
    <p class="text-sm"><%= link_to "All US residency checks", identity_residency_checks_path, class: "link-quiet text-ink-soft" %></p>
    <h1 class="page-title"><span class="mono"><%= @check.public_id %></span>: <%= @check.status.humanize %></h1>
    <p class="page-lede">
      <%= @user ? "#{@user.full_name} (#{@user.p_id})" : "A deleted account" %>.
      Evidence the member chose: <%= @check.evidence_label.downcase %>. Uploaded <%= time_label(@check.created_at, :datetime) %>.
    </p>
  </div>
  <% if !own && @check.submitted? && @check.document_review? %>
    <div class="page-actions">
      <%= button_to "Take for pre-review", start_pre_review_identity_residency_check_path(@check), method: :patch, class: "btn btn-primary" %>
    </div>
  <% end %>
</header>

<div class="space-y-6">
  <% if own %>
    <div class="callout callout-info">
      <%= icon(:info, size: 18) %>
      <div class="callout-body"><p>This is your own check. Another member of the identity team must decide it.</p></div>
    </div>
  <% end %>

  <% if !own && @check.pre_review? && @check.document_review? %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Pre-review</h2>
      </div>
      <div class="card-body space-y-4">
        <% if pre_reviewer %>
          <p class="text-sm text-ink-soft">
            Each view is logged. Check that the document is current and shows a US address, or a current US school enrollment.
            Weave keeps only the result, the state, the evidence type and the date. After the decision nobody can open the document.
          </p>
          <%= render "shared/secure_image_viewer", url: image_identity_residency_check_path(@check), label: "Show the document" %>
          <%= form_with url: decide_identity_residency_check_path(@check), method: :patch, class: "space-y-4 border-t border-hairline pt-4", html: { autocomplete: "off" } do |form| %>
            <div class="form-grid form-grid-3">
              <div class="field-group">
                <%= form.label :us_resident, "Lives in the US", class: "field-label" %>
                <%= form.select :us_resident, [["Yes", "yes"], ["No", "no"]], { include_blank: "Choose" }, required: true, class: "field" %>
              </div>
              <div class="field-group">
                <%= form.label :us_state, "US state (for yes)", class: "field-label" %>
                <%= form.select :us_state, ResidencyCheck::US_STATES.map { |code, name| [name, code] }, { include_blank: true }, class: "field" %>
              </div>
              <div class="field-group">
                <%= form.label :evidence_type, "What the document is", class: "field-label" %>
                <%= form.select :evidence_type, (["id_document"] + ResidencyCheck::UPLOAD_EVIDENCE).map { |type| [ResidencyCheck::EVIDENCE_TYPES[type], type] },
                      { selected: @check.evidence_type }, class: "field" %>
              </div>
            </div>
            <%= form.submit "Record the result", class: "btn btn-primary", data: { turbo_confirm: "Record this result? The document is sealed, and you can no longer see it." } %>
          <% end %>
          <%= form_with url: reject_document_identity_residency_check_path(@check), method: :patch, class: "field-group border-t border-hairline pt-4" do |form| %>
            <%= form.text_area :note, required: true, rows: 2, placeholder: "What must the member fix? The member sees this note.",
                  aria: { label: "What must the member fix?" }, class: "field" %>
            <div class="mt-1">
              <%= form.submit "Send back: ask for a new document", class: "btn btn-secondary" %>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-ink-soft"><%= @check.pre_reviewer&.full_name || "A deleted user" %> is the pre-reviewer. Only they can open the document and decide.</p>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @check.decided? || @check.needs_resubmission? %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Result</h2>
        <% if @check.needs_resubmission? %>
          <%= badge("Sent back", tone: :warning) %>
        <% elsif @check.us_resident %>
          <%= badge("Lives in the US", tone: :success) %>
        <% else %>
          <%= badge("Not in the US", tone: :neutral) %>
        <% end %>
      </div>
      <div class="card-body">
        <dl class="dl">
          <% if @check.needs_resubmission? %>
            <%= dl_row "Sent back", @check.resubmission_note %>
          <% elsif @check.us_resident %>
            <%= dl_row "Lives in the US", "yes, #{@check.us_state_name}" %>
            <%= dl_row "Evidence", @check.evidence_label.downcase %>
            <%= dl_row "Good until" do %><%= time_label(@check.expires_at) %><% if @check.ended_at %>. Ended: <%= @check.end_reason.humanize.downcase %>, <%= time_label(@check.ended_at, :datetime) %><% end %><% end %>
          <% else %>
            <%= dl_row "Lives in the US", "no" %>
          <% end %>
          <%= dl_row "Decided by" do %><%= @check.decided_by&.full_name || "the member's own statement" %>, <%= time_label(@check.decided_at || @check.pre_reviewed_at, :datetime) %><% end %>
          <%= dl_row "Document" do %><% if @check.document_purged_at %>deleted <%= time_label(@check.document_purged_at, :datetime) %><% else %><%= @check.document_sealed? ? "sealed" : "none" %><% end %><% end %>
        </dl>
      </div>
    </section>
  <% end %>
</div>

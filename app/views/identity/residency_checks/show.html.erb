<% content_for :title, "US residency check #{@check.public_id}" %>
<%
  input_class = "w-full px-3 py-2 rounded-lg border-2 border-neutral-300 bg-paper text-sm"
  own = @user && @user == current_user
  pre_reviewer = @check.pre_reviewer == current_user
%>

<div class="mb-6">
  <%= link_to "All US residency checks", identity_residency_checks_path, class: "text-sm text-grape" %>
  <h2 class="font-display text-2xl font-bold text-ink mt-2"><%= @check.public_id %>: <%= @check.status.humanize %></h2>
  <p class="text-ink-soft mt-1">
    <%= @user ? "#{@user.full_name} (#{@user.p_id})" : "A deleted account" %>.
    Evidence the member chose: <%= @check.evidence_label.downcase %>. Uploaded <%= @check.created_at.to_fs(:long) %>.
  </p>
  <% if own %>
    <p class="text-sm text-orchid mt-2">This is your own check. Another member of the identity team must decide it.</p>
  <% end %>
</div>

<% if !own && @check.submitted? && @check.document_review? %>
  <div class="patch p-6 mb-6">
    <%= button_to "Take for pre-review", start_pre_review_identity_residency_check_path(@check), method: :patch, class: "btn-stitch" %>
  </div>
<% end %>

<% if !own && @check.pre_review? && @check.document_review? %>
  <div class="patch p-6 mb-6 space-y-4">
    <h3 class="font-display text-lg font-bold text-ink">Pre-review</h3>
    <% if pre_reviewer %>
      <p class="text-sm text-ink-soft">
        Each view is logged. Check that the document is current and shows a US address, or a current US school enrollment.
        Weave keeps only the result, the state, the evidence type and the date. After the decision nobody can open the document.
      </p>
      <%= render "shared/secure_image_viewer", url: image_identity_residency_check_path(@check), label: "Show the document" %>
      <%= form_with url: decide_identity_residency_check_path(@check), method: :patch, class: "space-y-3", html: { autocomplete: "off" } do |form| %>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <label class="text-sm text-ink">Lives in the US
            <%= form.select :us_resident, [["Choose", ""], ["Yes", "yes"], ["No", "no"]], {}, required: true, class: input_class %>
          </label>
          <label class="text-sm text-ink">US state (for yes)
            <%= form.select :us_state, ResidencyCheck::US_STATES.map { |code, name| [name, code] }, { include_blank: true }, class: input_class %>
          </label>
          <label class="text-sm text-ink">What the document is
            <%= form.select :evidence_type, (["id_document"] + ResidencyCheck::UPLOAD_EVIDENCE).map { |type| [ResidencyCheck::EVIDENCE_TYPES[type], type] },
                  { selected: @check.evidence_type }, class: input_class %>
          </label>
        </div>
        <%= form.submit "Record the result", class: "btn-stitch", data: { turbo_confirm: "Record this result? The document is sealed, and you can no longer see it." } %>
      <% end %>
      <%= form_with url: reject_document_identity_residency_check_path(@check), method: :patch, class: "space-y-2" do |form| %>
        <%= form.text_area :note, required: true, rows: 2, placeholder: "What must the member fix? The member sees this note.",
              aria: { label: "What must the member fix?" }, class: input_class %>
        <%= form.submit "Send back: ask for a new document", class: "btn-stitch-ghost" %>
      <% end %>
    <% else %>
      <p class="text-sm text-ink-soft"><%= @check.pre_reviewer&.full_name || "A deleted user" %> is the pre-reviewer. Only they can open the document and decide.</p>
    <% end %>
  </div>
<% end %>

<% if @check.decided? || @check.needs_resubmission? %>
  <div class="patch p-6 mb-6 text-sm text-ink space-y-1">
    <h3 class="font-display text-lg font-bold text-ink mb-2">Result</h3>
    <% if @check.needs_resubmission? %>
      <p>Sent back: <%= @check.resubmission_note %></p>
    <% elsif @check.us_resident %>
      <p>Lives in the US: yes, <%= @check.us_state_name %>. Evidence: <%= @check.evidence_label.downcase %>.</p>
      <p>Good until <%= @check.expires_at.to_date.to_fs(:long) %><%= ". Ended: #{@check.end_reason.humanize.downcase}, #{@check.ended_at.to_fs(:long)}" if @check.ended_at %>.</p>
    <% else %>
      <p>Lives in the US: no.</p>
    <% end %>
    <p>Decided by <%= @check.decided_by&.full_name || "the member's own statement" %>, <%= (@check.decided_at || @check.pre_reviewed_at)&.to_fs(:long) %>.</p>
    <p>Document: <%= @check.document_purged_at ? "deleted #{@check.document_purged_at.to_fs(:long)}" : (@check.document_sealed? ? "sealed" : "none") %>.</p>
  </div>
<% end %>

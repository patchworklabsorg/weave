<% content_for :title, "US residency checks" %>

<%= page_header("US residency checks",
      lede: "Members who already passed identity verification upload a proof document here. There is no call. " \
            "Check where the member lives, never citizenship. Checks on an identity call are decided on the verification page.") %>

<div class="space-y-6">
  <% { "Waiting for pre-review" => @submitted, "In pre-review" => @in_pre_review }.each do |title, checks| %>
    <section class="card">
      <div class="card-header">
        <div class="flex items-center gap-2">
          <h2 class="card-title"><%= title %></h2>
          <%= badge(checks.size.to_s, tone: checks.any? ? :grape : :neutral) %>
        </div>
      </div>
      <% if checks.any? %>
        <div class="card-body">
          <ul class="record-list">
            <% checks.each do |check| %>
              <li class="record">
                <div class="record-main">
                  <p class="record-title">
                    <%= link_to check.public_id, identity_residency_check_path(check), class: "link mono" %>:
                    <%= check.user&.full_name || "a deleted user" %>, <%= check.evidence_label.downcase %>, <%= time_label(check.created_at, :datetime) %>
                  </p>
                  <% if check.pre_review? %>
                    <p class="record-meta">(pre-reviewer: <%= check.pre_reviewer&.full_name || "a deleted user" %>)</p>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <p class="card-body text-sm text-ink-faint">Nothing here.</p>
      <% end %>
    </section>
  <% end %>

  <% if @recent.any? %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Recent</h2>
      </div>
      <div class="card-body">
        <ul class="record-list">
          <% @recent.each do |check| %>
            <li class="record">
              <div class="record-main">
                <p class="record-title">
                  <%= link_to check.public_id, identity_residency_check_path(check), class: "link mono" %>:
                  <%= check.status.humanize %><%= check.us_resident.nil? ? "" : (check.us_resident ? ", yes (#{check.us_state_name})" : ", no") %>
                </p>
                <p class="record-meta"><%= check.decided_by&.full_name %> <%= time_label(check.updated_at, :datetime) %></p>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>
</div>

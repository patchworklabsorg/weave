<% content_for :title, "Key ceremony" %>

<header class="page-header">
  <div class="min-w-0">
    <p class="text-sm"><%= link_to "Key custody", identity_key_custody_path, class: "link-quiet text-ink-soft" %></p>
    <h1 class="page-title"><%= @rotation_of ? "Rotation ceremony" : "Key ceremony" %></h1>
    <p class="page-lede">
      One key holder runs the ceremony on a clean computer with no browser extensions. The other holders watch on a call.
      Nobody sends a hardware key or brings it to this computer. This page makes a new master key pair, splits the private
      key into <%= KeyCustody.share_count %> shares, and seals each share to the seal keys that its holder set up on their
      own computer. You touch only your own key, one time.
    </p>
  </div>
</header>

<div class="space-y-6">
  <div class="callout callout-warning">
    <%= icon(:shield_alert, size: 18) %>
    <div class="callout-body">
      <p class="callout-title">Where the private key exists</p>
      <p>
        The private key and the shares exist in plain form only in the memory of this page, from the start of the ceremony to
        its end. Weave gets the public key and the sealed shares only. At the end, the page overwrites the private key and the
        shares. JavaScript can keep other copies until the page closes, so close this tab and the browser after the ceremony.
        Use a computer you trust, with no browser extensions.
      </p>
      <% if @rotation_of %>
        <p>
          This is a rotation of <span class="mono"><%= @rotation_of.public_id %></span>. The new key set waits until
          every holder of the new set, and <%= KeyCustody.threshold %> holders of the old set, activate it on their own computers.
          Then Weave re-wraps every stored image to the new key and retires the old set.
        </p>
      <% end %>
    </div>
  </div>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Key holders</h2>
    </div>
    <div class="card-body">
      <ul class="record-list">
        <% @holders.each do |holder| %>
          <li class="record">
            <div class="record-main">
              <p class="record-title"><%= holder.full_name %></p>
              <p class="record-meta"><%= holder.identity_hardware_keys.select(&:sealable?).map(&:label).to_sentence.presence || "no hardware key with a seal key" %></p>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <% if @blocker %>
    <div class="callout callout-warning" role="alert">
      <%= icon(:triangle_alert, size: 18) %>
      <div class="callout-body"><p><%= @blocker %></p></div>
    </div>
  <% elsif !@can_run %>
    <div class="callout callout-warning" role="alert">
      <%= icon(:triangle_alert, size: 18) %>
      <div class="callout-body"><p>Only a key holder with a hardware key can run the ceremony.</p></div>
    </div>
  <% else %>
    <section class="card" data-controller="key-custody"
             data-key-custody-options-url-value="<%= start_identity_key_ceremony_path %>"
             data-key-custody-submit-url-value="<%= identity_key_ceremony_path %>"
             data-key-custody-redirect-url-value="<%= identity_key_custody_path %>">
      <div class="card-header">
        <h2 class="card-title">Run the ceremony</h2>
      </div>
      <div class="card-body space-y-3">
        <button type="button" class="btn btn-primary" data-action="key-custody#ceremony"><%= icon(:key_round) %>Start the ceremony</button>
        <p class="text-sm font-semibold text-ink" data-key-custody-target="status" aria-live="polite"></p>
        <ol class="ml-5 list-decimal space-y-1 text-xs text-ink-soft" data-key-custody-target="log"></ol>
      </div>
    </section>
  <% end %>
</div>

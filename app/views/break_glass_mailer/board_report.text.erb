  Reason: <%= record.reason %>
  Notices: <%= decryption.notices.map { |notice| "#{notice.recipient_kind} #{notice.sent? ? 'sent' : (notice.delayed? ? 'delayed' : 'waiting')}" }.join(", ") %>
<% end %>
<% @report.delayed_notices.each do |notice| %>
- Delayed member notice for <%= notice.break_glass_record.public_id %> since <%= notice.delayed_at.utc.strftime("%Y-%m-%d") %>: <%= notice.delay_reason %> (<%= notice.delay_signed_off? ? "signed off, holds until #{notice.delay_ends_at.utc.strftime('%Y-%m-%d')} at the latest" : "not signed off" %>)
<% end %>


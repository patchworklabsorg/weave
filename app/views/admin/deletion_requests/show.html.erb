<% content_for :title, "Deletion request" %>

<p class="mb-2 text-sm">
  <%= link_to admin_deletion_requests_path, class: "link-quiet inline-flex items-center gap-1 text-ink-soft" do %>
    <%= icon(:arrow_left, size: 14) %>All deletion requests
  <% end %>
</p>

<header class="page-header">
  <div class="min-w-0">
    <h1 class="page-title mono"><%= @deletion_request.public_id %></h1>
    <% if @deletion_request.review_overdue? %>
      <div class="page-lede"><%= badge "Review overdue", tone: :danger, icon: :clock_alert %></div>
    <% end %>
  </div>
  <% if @deletion_request.failed? && @can_review %>
    <div class="page-actions">
      <%= button_to "Run the pipeline again", rerun_admin_deletion_request_path(@deletion_request), method: :patch, class: "btn btn-primary" %>
    </div>
  <% end %>
</header>

<div class="space-y-6">
  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Request</h2>
    </div>
    <div class="card-body">
      <dl class="dl">
        <%= dl_row("Member") do %>
          <%= @user ? link_to("#{@user.full_name} (#{@user.p_id})", admin_user_path(@user), class: "link") : "A deleted account" %>
        <% end %>
        <%= dl_row "Source", @deletion_request.source %>
        <%= dl_row "Status", @deletion_request.status.humanize %>
        <%= dl_row "Requested" do %><%= time_label(@deletion_request.requested_at, :datetime) %><% end %>
        <%= dl_row("Review due") do %>
          <span class="<%= 'text-danger' if @deletion_request.review_overdue? %>"><%= time_label(@deletion_request.review_due_at) %></span>
        <% end %>
        <%= dl_row "Deletion complete by" do %><%= time_label(@deletion_request.complete_by) %><% end %>
        <% if @deletion_request.reviewed_at %>
          <%= dl_row "Reviewed" do %><%= @deletion_request.reviewed_by&.full_name || "a deleted user" %>, <%= time_label(@deletion_request.reviewed_at, :datetime) %><% end %>
          <%= dl_row "Review note", @deletion_request.review_note %>
        <% end %>
        <% if @user && @deletion_request.dormancy? %>
          <%= dl_row "Last active" do %><%= time_label(@user.last_active_at, :datetime) %><% end %>
        <% end %>
      </dl>
    </div>
  </section>

  <% if @deletion_request.pending_review? %>
    <section class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title">Authenticity check</h2>
          <% if @can_review %>
            <p class="card-lede">
              Confirm that the request came from the member (for example, a reply from the address on file), or that the
              account is dormant. Do not write member details in the note.
            </p>
          <% end %>
        </div>
      </div>
      <div class="card-body">
        <% if @can_review %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <%= form_with url: approve_admin_deletion_request_path(@deletion_request), method: :patch, class: "space-y-3" do |form| %>
              <div class="field-group">
                <%= form.label :review_note, "How you checked it", class: "field-label" %>
                <%= form.text_area :review_note, required: true, rows: 2, class: "field" %>
              </div>
              <%= form.submit "Approve and run the deletion", class: "btn btn-danger", data: { turbo_confirm: "This deletes the account. Continue?" } %>
            <% end %>
            <%= form_with url: reject_admin_deletion_request_path(@deletion_request), method: :patch, class: "space-y-3" do |form| %>
              <div class="field-group">
                <%= form.label :review_note, "Why the check failed", class: "field-label" %>
                <%= form.text_area :review_note, required: true, rows: 2, class: "field" %>
              </div>
              <%= form.submit "Reject: could not confirm", class: "btn btn-secondary" %>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-ink-soft">You can't review this request: it is your own, or the user is at or above your access level.</p>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Pipeline runs</h2>
    </div>
    <% if @runs.any? %>
      <div class="card-body">
        <div class="record-list">
          <% @runs.each do |run| %>
            <div class="record">
              <div class="record-main space-y-1">
                <p class="record-title"><strong><%= run.outcome.humanize %></strong>, started <%= time_label(run.started_at, :datetime) %></p>
                <ol class="list-decimal list-inside text-sm text-ink-soft">
                  <% run.steps.each do |step| %>
                    <li><span class="mono"><%= step["step"] %></span>: <%= step["status"] %></li>
                  <% end %>
                </ol>
                <% if run.error_class %>
                  <p class="field-error"><%= run.error_class %>: <%= run.error_message %></p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <%= empty_state("No runs yet.", icon: :play) %>
    <% end %>
  </section>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">What the pipeline does</h2>
    </div>
    <div class="card-body">
      <div class="record-list">
        <% @categories.each do |category| %>
          <div class="record">
            <div class="record-main text-sm text-ink"><strong><%= category.name %></strong> (<%= category.outcome %>): <%= category.legal_basis %></div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
</div>

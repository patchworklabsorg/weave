<% content_for :title, "Deletion requests" %>

<header class="page-header">
  <div>
    <h1 class="page-title">Deletion requests</h1>
    <p class="page-lede">
      Check that each request is authentic: it came from the member, or the account is really dormant. This is not a
      judgment call. Review each request by its due date (<%= DataRetention.review_sla.in_days.to_i %> days).
      <%= link_to "What we do with your data", Weave.data_page_url, target: "_blank", rel: "noopener noreferrer", class: "link" %>
    </p>
  </div>
  <div class="page-actions">
    <%= link_to admin_delete_time_aggregates_path, class: "btn btn-secondary" do %>
      <%= icon(:chart_column) %>Departed totals
    <% end %>
  </div>
</header>

<%
  sections = [
    ["Waiting for review", @pending, ->(r) { "Review due #{r.review_due_at.to_date.to_fs(:long)}#{' (overdue)' if r.review_overdue?}" }],
    ["Approved, running or failed", @active, ->(r) { "#{r.status.humanize}, complete by #{r.complete_by.to_date.to_fs(:long)}" }],
    ["Recently closed", @recent, ->(r) { "#{r.status.humanize}, #{time_ago_in_words(r.updated_at)} ago" }]
  ]
%>

<div class="space-y-6">
  <% sections.each do |title, requests, detail| %>
    <section class="card">
      <div class="card-header">
        <div class="flex items-center gap-2">
          <h2 class="card-title"><%= title %></h2>
          <%= badge(requests.size.to_s) %>
        </div>
      </div>
      <% if requests.any? %>
        <div class="card-body">
          <div class="record-list">
            <% requests.each do |request| %>
              <div class="record flex-wrap">
                <div class="record-main">
                  <p class="record-title">
                    <%= link_to request.public_id, admin_deletion_request_path(request), class: "link mono" %>
                    <%= request.user&.full_name || "A deleted account" %>
                  </p>
                  <p class="record-meta"><%= request.source %></p>
                </div>
                <% if request.review_overdue? %>
                  <%= badge detail.call(request), tone: :danger, icon: :clock_alert %>
                <% else %>
                  <span class="text-sm text-ink-soft"><%= detail.call(request) %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <%= empty_state("Nothing here.", icon: :inbox) %>
      <% end %>
    </section>
  <% end %>
</div>

<% content_for :title, "Departed totals" %>

<header class="page-header">
  <div>
    <h1 class="page-title">Departed totals</h1>
    <p class="page-lede">
      Participation of deleted accounts, added to these totals before each deletion. Counts only, never a row per
      person. Counts under <%= @report["threshold"] %> are hidden. Demographic totals of departed members are on the
      <%= link_to "demographics page", admin_demographics_path, class: "link" %>.
      <%= link_to "What we do with your data", Weave.data_page_url, target: "_blank", rel: "noopener noreferrer", class: "link" %>
    </p>
  </div>
</header>

<div class="space-y-6">
  <% sections = [["All departed participations", @report["all"]]] + @report["cohorts"].to_a %>
  <% sections.each do |title, tally| %>
    <section class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title"><%= title %></h2>
          <p class="card-lede">Participations: <%= tally["respondents"] || "hidden (fewer than #{@report['threshold']})" %></p>
        </div>
      </div>
      <div class="card-body">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <% tally["fields"].each do |field, counts| %>
            <div>
              <h3 class="section-title"><%= field.humanize %></h3>
              <dl class="dl">
                <% counts.each do |value, count| %>
                  <%= dl_row value, (count.nil? ? "hidden" : count) %>
                <% end %>
              </dl>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
</div>

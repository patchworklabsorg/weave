<%= form_with model: [:admin, group], local: true, class: "card" do |form| %>
  <div class="card-body space-y-5">
    <%= form_errors(group) %>

    <div class="field-group">
      <%= form.label :name, class: "field-label" %>
      <%= form.text_field :name, class: "field", placeholder: "Engineering" %>
    </div>

    <div class="field-group">
      <%= form.label :slug, class: "field-label" %>
      <% if group.persisted? %>
        <span class="field-static mono"><%= group.slug %></span>
        <p class="field-hint">The slug can't be changed after the group is created.</p>
      <% else %>
        <%= form.text_field :slug, class: "field", placeholder: "engineering" %>
        <p class="field-hint">
          Lowercase letters, numbers and dashes. Apps will see this name. Leave it empty to make one from the name.
          You can't change it later.
        </p>
      <% end %>
    </div>

    <div class="field-group">
      <%= form.label :description, class: "field-label" %>
      <%= form.text_area :description, rows: 3, class: "field" %>
    </div>

    <div class="well">
      <fieldset class="space-y-3">
        <legend class="field-label">Sponsored project</legend>
        <p class="field-hint">
          Use these for a sponsored project, such as HackBoston. They apply to every member of this group. Do not use them for Patchwork members.
        </p>
        <label class="choice">
          <%= form.check_box :waives_code_of_conduct, class: "checkbox" %>
          <span>Members do not need to accept the Patchwork Code of Conduct to use apps.</span>
        </label>
        <label class="choice">
          <%= form.check_box :waives_slack, class: "checkbox" %>
          <span>Members do not need to join the Patchwork Slack. This needs the Code of Conduct waiver too.</span>
        </label>
      </fieldset>
    </div>

    <div class="form-actions">
      <%= link_to "Cancel", group.persisted? ? admin_group_path(group) : admin_groups_path, class: "btn btn-secondary" %>
      <%= form.submit group.persisted? ? "Save Group" : "Create Group", class: "btn btn-primary" %>
    </div>
  </div>
<% end %>

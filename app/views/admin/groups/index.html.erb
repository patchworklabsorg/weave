<% content_for :title, "Groups" %>

<%= page_header("Groups", lede: "Sets of users. Groups will control who can use each OAuth app.") do %>
  <% if current_user.superadmin? %>
    <%= link_to new_admin_group_path, class: "btn btn-primary" do %><%= icon(:plus) %>New group<% end %>
  <% end %>
<% end %>

<div class="card card-flush">
  <div class="card-header">
    <h2 class="card-title">All groups</h2>
    <%= render "shared/search_form", url: admin_groups_path, frame: "groups_table", placeholder: "Search groups" %>
  </div>

  <%= turbo_frame_tag "groups_table", target: "_top" do %>
    <% if params[:search].present? %>
      <p class="px-5 py-3 text-sm text-ink-soft border-b border-hairline">
        <%= pluralize(@groups.size, "group") %> <%= @groups.size == 1 ? "matches" : "match" %> “<%= params[:search] %>”
      </p>
    <% end %>

    <% if @groups.any? %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Slug</th>
              <th scope="col">Type</th>
              <th scope="col" class="num">Members</th>
              <th scope="col">Created</th>
            </tr>
          </thead>
          <tbody>
            <% @groups.each do |group| %>
              <tr>
                <td>
                  <%= link_to group.name, admin_group_path(group), class: "link-quiet font-medium" %>
                  <% if group.description.present? %>
                    <span class="table-sub"><%= group.description %></span>
                  <% end %>
                </td>
                <td class="mono"><%= group.slug %></td>
                <td><%= render "kind_badge", group: group %></td>
                <td class="num"><%= @member_counts.fetch(group.id, 0) %></td>
                <td class="whitespace-nowrap text-ink-soft"><%= time_ago_in_words(group.created_at) %> ago</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% elsif params[:search].present? %>
      <%= empty_state("No groups match “#{params[:search]}”", body: "Search by name, slug or description.", icon: :search) %>
    <% else %>
      <%= empty_state("No groups yet", body: "Create a group to give a set of users access to an app.", icon: :users) do %>
        <% if current_user.superadmin? %>
          <%= link_to new_admin_group_path, class: "btn btn-secondary" do %><%= icon(:plus) %>New group<% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>

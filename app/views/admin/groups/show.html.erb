<% content_for :title, @group.name %>
<% can_change = current_user.superadmin? && @group.editable? %>

<header class="page-header">
  <div>
    <p class="text-sm"><%= link_to "Groups", admin_groups_path, class: "link-quiet text-ink-soft" %></p>
    <h1 class="page-title"><%= @group.name %></h1>
    <p class="page-lede mono"><%= @group.slug %></p>
  </div>
  <% if can_change %>
    <div class="page-actions">
      <%= link_to edit_admin_group_path(@group), class: "btn btn-secondary" do %><%= icon(:pencil) %>Edit<% end %>
      <%= button_to admin_group_path(@group), method: :delete, class: "btn btn-danger",
          data: { turbo_confirm: "Delete #{@group.name}? All members will be removed from it." } do %>
        <%= icon(:trash_2) %>Delete
      <% end %>
    </div>
  <% end %>
</header>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Details</h2>
    </div>
    <div class="card-body">
      <dl class="dl">
        <%= dl_row("Type") { render "kind_badge", group: @group } %>
        <% if @group.description.present? %>
          <%= dl_row "Description", @group.description %>
        <% end %>
        <% if @group.waives_code_of_conduct || @group.waives_slack %>
          <%= dl_row "Sponsored project waivers",
                [("Code of Conduct" if @group.waives_code_of_conduct), ("Slack" if @group.waives_slack)].compact.to_sentence %>
        <% end %>
        <%= dl_row("Created") do %>
          <%= @group.created_at.strftime("%B %d, %Y") %>
          <% if @group.created_by %>by <%= @group.created_by.full_name %><% end %>
        <% end %>
      </dl>
      <% if @group.system? %>
        <p class="mt-3 text-sm text-ink-soft">Weave keeps this group in sync from user attributes. You can't change it by hand.</p>
      <% elsif current_user.superadmin? %>
        <p class="mt-3 text-sm text-ink-soft">
          Managers approve access requests and manage members on the
          <%= link_to "group page", group_path(@group), class: "link" %>.
          <% if (pending = @group.access_requests.pending.count).positive? %>
            <%= pluralize(pending, "request") %> waiting.
          <% end %>
        </p>
      <% end %>
    </div>
  </div>

  <div class="card card-flush lg:col-span-2">
    <div class="card-header">
      <div class="flex items-center gap-2">
        <h2 class="card-title">Members</h2>
        <%= badge(@memberships.count(&:active?).to_s) %>
      </div>
      <%= render "shared/search_form", url: admin_group_path(@group), frame: "group_members", placeholder: "Search members" %>
    </div>

    <% if can_change %>
      <div class="px-5 pt-4">
        <%= form_with model: @membership, scope: :group_membership, url: admin_group_memberships_path(@group), local: true,
            class: "well grid grid-cols-1 sm:grid-cols-[minmax(0,1fr)_auto_auto] items-end gap-3" do |form| %>
          <div class="field-group">
            <%= form.label :email, "Email", class: "field-label" %>
            <%= form.email_field :email, required: true, class: "field", placeholder: "person@example.com" %>
          </div>
          <div class="field-group">
            <%= form.label :expires_at, class: "field-label" do %>Expires <span class="optional">(optional)</span><% end %>
            <%= form.datetime_local_field :expires_at, class: "field" %>
          </div>
          <%= form.submit "Add Member", class: "btn btn-primary" %>
        <% end %>
      </div>
    <% end %>

    <%= turbo_frame_tag "group_members", target: "_top" do %>
      <% if params[:search].present? %>
        <p class="px-5 py-3 text-sm text-ink-soft border-b border-hairline">
          <%= pluralize(@memberships.size, "member") %> <%= @memberships.size == 1 ? "matches" : "match" %> “<%= params[:search] %>”
        </p>
      <% end %>

      <% if @memberships.any? %>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th scope="col">User</th>
                <th scope="col">Added</th>
                <th scope="col">Expires</th>
                <th scope="col" class="actions"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% @memberships.each do |membership| %>
                <tr>
                  <td>
                    <%= link_to membership.user.full_name, admin_user_path(membership.user), class: "link-quiet font-medium" %>
                    <%= badge("Manager", tone: :grape) if membership.role_manager? %>
                    <span class="table-sub"><%= membership.user.email %></span>
                  </td>
                  <td class="text-ink-soft">
                    <%= time_ago_in_words(membership.created_at) %> ago
                    <% if membership.added_by %><span class="table-sub">by <%= membership.added_by.full_name %></span><% end %>
                  </td>
                  <td class="whitespace-nowrap">
                    <% if membership.expired? %>
                      <%= badge "Expired", tone: :danger %>
                    <% elsif membership.expires_at %>
                      <%= membership.expires_at.strftime("%b %d, %Y %I:%M %p") %>
                    <% else %>
                      <span class="text-ink-faint">Never</span>
                    <% end %>
                  </td>
                  <td class="actions">
                    <% if can_change && membership.manual? %>
                      <div class="btn-row justify-end">
                      <% if membership.role_manager? %>
                        <%= button_to "Make member", role_admin_group_membership_path(@group, membership), method: :patch,
                            params: { role: "member" }, class: "btn btn-secondary btn-sm", form_class: "inline-block",
                            data: { turbo_confirm: "#{membership.user.full_name} will no longer decide access requests for #{@group.name}. Continue?" } %>
                      <% else %>
                        <%= button_to "Make manager", role_admin_group_membership_path(@group, membership), method: :patch,
                            params: { role: "manager" }, class: "btn btn-secondary btn-sm", form_class: "inline-block",
                            data: { turbo_confirm: "#{membership.user.full_name} will approve access requests and manage the members of #{@group.name}. Continue?" } %>
                      <% end %>
                      <%= button_to "Remove", admin_group_membership_path(@group, membership), method: :delete,
                          class: "btn btn-danger btn-sm",
                          form_class: "inline-block",
                          data: { turbo_confirm: "Remove #{membership.user.full_name} from #{@group.name}?" } %>
                      </div>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% elsif params[:search].present? %>
        <%= empty_state("No members match “#{params[:search]}”", body: "Search by name, email or Weave ID.", icon: :search) %>
      <% else %>
        <%= empty_state("This group has no members.", icon: :users) %>
      <% end %>
    <% end %>
  </div>
</div>

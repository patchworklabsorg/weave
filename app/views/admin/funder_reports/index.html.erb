<%# The funder profiles (see Admin::FunderReportsController). %>
<% content_for :title, "Funder reports" %>

<header class="page-header">
  <div>
    <h1 class="page-title">Funder reports</h1>
    <p class="page-lede">
      Each funder profile is in <code class="code-chip">config/kyc/data_retention.yml</code>. Open a funder to preview its report. The preview
      uses only that funder's fields, threshold, amount setting and consent rule. There is no export and no send yet.
    </p>
  </div>
</header>

<section class="card">
  <% if @profiles.any? %>
    <div class="card-body">
      <div class="record-list">
        <% @profiles.each do |profile| %>
          <div class="record flex-wrap">
            <div class="record-main">
              <p class="record-title">
                <%= link_to profile.name, admin_funder_report_path(profile.key), class: "link" %>
                <span class="mono text-ink-faint font-normal">(<%= profile.key %>)</span>
              </p>
              <p class="record-meta">
                Programs: <%= profile.programs.to_sentence.presence || "none" %>.
                <%= profile.report_cadence.humanize %>.<%= " Consent required." if profile.consent_required? %>
              </p>
            </div>
            <% if profile.consent_required? %>
              <%= badge "Consent", tone: :info, icon: :shield_check %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= empty_state("No funder has a profile yet.", body: "See the checklist in docs/KYC_ROLLOUT.md.", icon: :landmark) %>
  <% end %>
</section>

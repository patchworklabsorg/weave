<%# A preview of one funder's report (see FunderReport). Counts and sums only,
    after the funder's own threshold. %>
<% profile = @report.profile %>
<% content_for :title, "Funder report: #{profile.name}" %>

<%
  # One block of suppressed counts: respondents and a table per field.
  render_counts = lambda do |data|
    capture do
      concat tag.p("Members: #{demographic_count(data['respondents'], profile.threshold)}", class: "text-sm text-ink-soft")
      data.fetch("fields", {}).each do |field, counts|
        concat(tag.div(class: "table-wrap rounded-lg border border-hairline") do
          tag.table(class: "table") do
            concat tag.caption(demographic_field_label(field), class: "px-4 py-2 text-left text-sm font-semibold text-ink")
            concat(tag.tbody do
              counts.each do |value, count|
                concat(tag.tr do
                  concat tag.td(demographic_option_label(field, value))
                  concat tag.td(demographic_count(count, profile.threshold), class: "num")
                end)
              end
            end)
          end
        end)
      end
    end
  end
%>

<p class="mb-2 text-sm">
  <%= link_to admin_funder_reports_path, class: "link-quiet inline-flex items-center gap-1 text-ink-soft" do %>
    <%= icon(:arrow_left, size: 14) %>All funders
  <% end %>
</p>

<%= page_header(profile.name, lede: "Preview only. There is no export and no send yet. Counts below #{profile.threshold} are hidden.") %>

<div class="space-y-6">
  <% @report.notes.each do |note| %>
    <div class="callout callout-warning">
      <%= icon(:triangle_alert, size: 18) %>
      <div class="callout-body"><%= note %></div>
    </div>
  <% end %>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Profile</h2>
    </div>
    <div class="card-body">
      <dl class="dl">
        <%= dl_row("Key") { tag.code(profile.key, class: "mono") } %>
        <%= dl_row "Contract", (profile.contract_reference || "not recorded") %>
        <%= dl_row "Programs", (profile.programs.to_sentence.presence || "none") %>
        <%= dl_row "Report cadence", profile.report_cadence.humanize.downcase %>
        <%= dl_row "Report fields", (profile.report_fields.map { |field| demographic_field_label(field) }.to_sentence.presence || "none (member counts only)") %>
        <%= dl_row "Amounts", (profile.totals? ? "totals (sums only)" : "bands") %>
        <%= dl_row "Threshold", profile.threshold %>
        <%= dl_row "Member consent", (profile.consent_required? ? "required" : "not required") %>
        <%= dl_row "Award ends", (profile.award_ends_on&.iso8601 || "not set") %>
        <%= dl_row "Records kept", "#{profile.financial_keep_years ? "#{profile.financial_keep_years} years in full" : 'the default financial window'}#{", and until #{profile.post_award_until.iso8601} after the award" if profile.post_award_until}" %>
        <% if profile.eligibility.any? %>
          <%= dl_row "Eligibility in the contract (recorded only, not enforced)",
                ["ages #{profile.eligibility.min_age || 'any'} to #{profile.eligibility.max_age || 'any'}",
                 ("countries #{profile.eligibility.countries.join(', ')}" if profile.eligibility.countries.any?)].compact.join(", ") %>
        <% end %>
      </dl>
    </div>
  </section>

  <section class="card">
    <div class="card-header">
      <div>
        <h2 class="card-title">Current members</h2>
        <p class="card-lede"><%= @report.generated_at ? "From the reporting run of #{@report.generated_at.strftime('%b %-d, %Y %H:%M')}." : "No reporting run yet." %></p>
      </div>
    </div>
    <div class="card-body space-y-4">
      <%= @report.demographics ? render_counts.call(@report.demographics) : tag.p("No counts yet.", class: "text-sm text-ink-faint") %>
    </div>
  </section>

  <% if @report.departed.present? %>
    <% @report.departed.each do |cohort, data| %>
      <section class="card">
        <div class="card-header">
          <h2 class="card-title">Members who left (<%= cohort %>)</h2>
        </div>
        <div class="card-body space-y-4">
          <%= render_counts.call(data) %>
        </div>
      </section>
    <% end %>
  <% end %>

  <% if @report.delete_time %>
    <% @report.delete_time.each do |cohort, data| %>
      <section class="card">
        <div class="card-header">
          <h2 class="card-title">Delete-time aggregates (<%= cohort %>)</h2>
        </div>
        <div class="card-body space-y-4">
          <%= render_counts.call(data) %>
        </div>
      </section>
    <% end %>
  <% end %>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Grant amounts</h2>
    </div>
    <% if @report.amounts.empty? %>
      <%= empty_state("No grant money for this funder yet.", icon: :coins) %>
    <% else %>
      <div class="card-body space-y-6">
        <% @report.amounts.each do |cohort, data| %>
          <div class="space-y-3">
            <h3 class="section-title mb-0"><%= cohort %></h3>
            <% if profile.totals? %>
              <p class="text-sm text-ink">
                <% if data["total_cents"] %>
                  <%= number_to_currency(data["total_cents"] / 100.0, unit: "") %> <%= data["currency"] %> to <%= data["recipients"] %> members.
                <% else %>
                  Hidden: fewer than <%= profile.threshold %> members got money.
                <% end %>
              </p>
            <% else %>
              <%= render_counts.call(data) %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
</div>

<% content_for :title, "Staff and contractors" %>

<%= page_header("Staff and contractors",
      lede: "Any admin grants or revokes the staff and contractor roles at once, for a person they can manage. " \
            "Weave logs each change in the permanent log. Other roles have their own rules: see the identity governance page.") %>

<div class="space-y-6">
  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Grant a role</h2>
    </div>
    <div class="card-body">
      <%= form_with url: admin_role_assignments_path, method: :post, class: "flex flex-col md:flex-row gap-2" do |form| %>
        <%= form.text_field :person, required: true, placeholder: "Weave ID or email", aria: { label: "Person" }, class: "field flex-1" %>
        <%= form.select :role, Admin::RoleAssignmentsController::PAGE_ROLES.map { |key| [RoleRegistry.fetch(key).name, key] }, {},
              aria: { label: "Role" }, class: "field md:w-48" %>
        <%= form.text_field :reason, placeholder: "Reason (optional)", aria: { label: "Reason" }, class: "field flex-1" %>
        <%= form.submit "Grant", class: "btn btn-primary" %>
      <% end %>
    </div>
  </section>

  <% @assignments.each do |key, assignments| %>
    <% definition = RoleRegistry.fetch(key) %>
    <section class="card">
      <div class="card-header">
        <div class="flex items-center gap-2">
          <h2 class="card-title"><%= definition.name %></h2>
          <%= badge(assignments.size.to_s) %>
        </div>
      </div>
      <% if assignments.any? %>
        <div class="card-body">
          <div class="record-list">
            <% assignments.each do |assignment| %>
              <% user = assignment.user %>
              <div class="record flex-col items-stretch">
                <div class="record-main">
                  <p class="record-title">
                    <%= link_to user.full_name, admin_user_path(user), class: "link-quiet" %>
                    <span class="mono text-ink-faint font-normal">(<%= user.p_id %>)</span>
                  </p>
                  <p class="record-meta">
                    Since <%= time_label(assignment.granted_at) %>.
                    Granted by <%= assignment.granted_by&.full_name || "Weave" %>.
                    <%= "Reason: #{assignment.reason}" if assignment.reason.present? %>
                  </p>
                </div>
                <% if RoleGrants.allowed_now?(current_user, user, key, :revoke) %>
                  <%= form_with url: revoke_admin_role_assignments_path, method: :post, class: "flex flex-col sm:flex-row gap-2" do |form| %>
                    <%= form.hidden_field :user_id, value: user.p_id %>
                    <%= form.hidden_field :role, value: key %>
                    <%= form.text_field :reason, required: true, placeholder: "Reason for the revoke",
                          aria: { label: "Reason to revoke #{definition.name} of #{user.full_name}" }, class: "field field-sm flex-1" %>
                    <%= form.submit "Revoke", class: "btn btn-danger btn-sm",
                          data: { turbo_confirm: "Revoke the #{definition.name.downcase} role of #{user.full_name} now?" } %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <%= empty_state("Nobody has this role.", icon: :user_round) %>
      <% end %>
    </section>
  <% end %>
</div>

<%# Admin only: what an admin did while signed in as this user. Never render this on user-facing pages. %>
<% content_for :title, "Impersonation of #{@user.full_name}" %>
<% summary = capture do %>
  By <%= @impersonation.admin&.full_name || "a deleted admin" %>,
  started <%= l(@impersonation.started_at, format: :long) %>.
  <% if @impersonation.active? %>
    Not ended.
  <% elsif @impersonation.duration %>
    Lasted <%= distance_of_time_in_words(@impersonation.duration) %>.
  <% end %>
<% end %>

<p class="mb-2 text-sm">
  <%= link_to admin_user_path(@user, anchor: "impersonations"), class: "link-quiet inline-flex items-center gap-1 text-ink-soft" do %>
    <%= icon(:arrow_left, size: 14) %><%= @user.full_name %>
  <% end %>
</p>

<%= page_header "Impersonation of #{@user.full_name}", lede: summary %>

<div class="space-y-6">
  <section class="card card-flush" id="impersonation-actions">
    <div class="card-header">
      <div>
        <h2 class="card-title">Requests</h2>
        <p class="card-lede">Pages the admin opened and every change they submitted. Sensitive values are filtered.</p>
      </div>
    </div>
    <% if @actions.any? %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Time</th>
              <th>Method</th>
              <th>Path</th>
              <th>Action</th>
              <th>Status</th>
              <th>Params</th>
            </tr>
          </thead>
          <tbody>
            <% @actions.each do |action| %>
              <tr>
                <td class="whitespace-nowrap text-ink-soft" title="<%= action.created_at.iso8601 %>">
                  <%= l(action.created_at, format: :short) %>
                </td>
                <td class="whitespace-nowrap">
                  <%= badge action.http_method, tone: (action.state_changing? ? :warning : :neutral) %>
                </td>
                <td class="mono break-all"><%= action.path %></td>
                <td class="whitespace-nowrap mono text-ink-soft"><%= action.controller_action %></td>
                <td class="whitespace-nowrap text-ink-soft"><%= action.status || "—" %></td>
                <td class="text-ink-soft">
                  <% if action.params.present? %>
                    <details>
                      <summary class="link text-sm cursor-pointer">Show</summary>
                      <pre class="code-block mt-2 text-xs"><%= JSON.pretty_generate(action.params) %></pre>
                    </details>
                  <% else %>
                    —
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state "No requests were recorded.", icon: :list %>
    <% end %>
  </section>

  <section class="card card-flush" id="impersonation-versions">
    <div class="card-header">
      <div>
        <h2 class="card-title">Record changes</h2>
        <p class="card-lede">Records the admin created, changed or deleted during this impersonation.</p>
      </div>
    </div>
    <% if @versions.any? %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Time</th>
              <th>Event</th>
              <th>Record</th>
            </tr>
          </thead>
          <tbody>
            <% @versions.each do |version| %>
              <tr>
                <td class="whitespace-nowrap text-ink-soft" title="<%= version.created_at&.iso8601 %>">
                  <%= version.created_at ? l(version.created_at, format: :short) : "—" %>
                </td>
                <td class="whitespace-nowrap"><%= version.event %></td>
                <td class="whitespace-nowrap mono text-ink-soft"><%= version.item_type %> #<%= version.item_id %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state "No records were changed.", icon: :history %>
    <% end %>
  </section>
</div>

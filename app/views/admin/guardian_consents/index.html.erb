<% content_for :title, "Guardian consents" %>

<div class="mb-6">
  <h2 class="font-display text-2xl font-bold text-ink mb-4">Guardian consents to check</h2>
  <p class="text-ink-soft">
    These consents have a sign that the guardian may not be real, or were chosen for a spot check.
    Contact the guardian to confirm. Then mark the consent as checked, or revoke it from the member's page.
  </p>
</div>

<% if @queue.any? %>
  <div class="space-y-4 mb-10">
    <% @queue.each do |consent| %>
      <div class="patch p-6">
        <div class="flex flex-wrap justify-between gap-4">
          <div>
            <p class="font-semibold text-ink">
              <%= link_to consent.user.full_name, admin_user_path(consent.user), class: "hover:text-grape" %>
            </p>
            <p class="text-sm text-ink-soft mt-1">
              Guardian: <%= consent.guardian_name %> (<%= consent.guardian_email %>), signed as <%= consent.signed_name %>
            </p>
            <p class="text-xs text-ink-faint mt-1">Consented <%= consent.granted_at.strftime("%b %-d, %Y %H:%M") %></p>
          </div>
        </div>
        <ul class="mt-3 list-disc list-inside text-sm text-ink">
          <% consent.flags.each do |flag| %>
            <li><%= GuardianConsentSignals.describe(flag) %></li>
          <% end %>
        </ul>
        <%= form_with url: review_admin_guardian_consent_path(consent), method: :patch, class: "mt-4 flex flex-col sm:flex-row gap-2" do |form| %>
          <%= form.text_field :note, required: true, maxlength: 500, placeholder: "How did you confirm it? For example: phone call on Oct 12",
                aria: { label: "How did you confirm it?" },
                class: "flex-1 px-3 py-2 rounded-lg border-2 border-neutral-300 bg-paper text-sm" %>
          <%= form.submit "Mark as checked", class: "btn-stitch-ghost" %>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="patch p-6 mb-10">
    <p class="text-sm text-ink-faint">Nothing to check.</p>
  </div>
<% end %>

<% if @recent.any? %>
  <h3 class="font-display text-lg font-bold text-ink mb-3">Recently checked</h3>
  <div class="patch overflow-hidden">
    <table class="min-w-full divide-y divide-ink-soft/20">
      <thead>
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-grape uppercase tracking-wider">Member</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-grape uppercase tracking-wider">Checked by</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-grape uppercase tracking-wider">Note</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-grape uppercase tracking-wider">When</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-ink-soft/10">
        <% @recent.each do |consent| %>
          <tr>
            <td class="px-6 py-4 text-sm text-ink"><%= link_to consent.user.full_name, admin_user_path(consent.user), class: "hover:text-grape" %></td>
            <td class="px-6 py-4 text-sm text-ink"><%= consent.reviewed_by&.full_name || "A deleted user" %></td>
            <td class="px-6 py-4 text-sm text-ink-soft"><%= consent.review_note %></td>
            <td class="px-6 py-4 text-sm text-ink-soft"><%= time_ago_in_words(consent.reviewed_at) %> ago</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

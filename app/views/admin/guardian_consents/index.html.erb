<% content_for :title, "Guardian consents" %>

<%= page_header("Guardian consents",
      lede: "These consents have a sign that the guardian may not be real, or were chosen for a spot check. " \
            "Contact the guardian to confirm. Then mark the consent as checked, or revoke it from the member's page.") %>

<div class="space-y-6">
  <div class="card">
    <div class="card-header">
      <div class="flex items-center gap-2">
        <h2 class="card-title">Guardian consents to check</h2>
        <%= badge(@queue.size.to_s, tone: @queue.any? ? :warning : :neutral) %>
      </div>
    </div>

    <% if @queue.any? %>
      <div class="card-body">
        <div class="record-list">
          <% @queue.each do |consent| %>
            <div class="record flex-col items-stretch">
              <div class="record-main space-y-2">
                <p class="record-title">
                  <%= link_to consent.user.full_name, admin_user_path(consent.user), class: "link" %>
                </p>
                <p class="record-meta">
                  Guardian: <%= consent.guardian_name %> (<%= consent.guardian_email %>), signed as <%= consent.signed_name %>
                </p>
                <p class="record-meta">Consented <%= consent.granted_at.strftime("%b %-d, %Y %H:%M") %></p>
                <ul class="space-y-1.5" aria-label="Signs">
                  <% consent.flags.each do |flag| %>
                    <li class="callout callout-warning py-2 text-sm">
                      <%= icon(:triangle_alert, size: 18) %>
                      <div class="callout-body"><%= GuardianConsentSignals.describe(flag) %></div>
                    </li>
                  <% end %>
                </ul>
              </div>
              <%= form_with url: review_admin_guardian_consent_path(consent), method: :patch, class: "flex flex-col sm:flex-row gap-2" do |form| %>
                <%= form.text_field :note, required: true, maxlength: 500, placeholder: "How did you confirm it? For example: phone call on Oct 12",
                      aria: { label: "How did you confirm it?" },
                      class: "field field-sm flex-1" %>
                <%= form.submit "Mark as checked", class: "btn btn-secondary btn-sm" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <%= empty_state("Nothing to check.", icon: :shield_check) %>
    <% end %>
  </div>

  <div class="card card-flush">
    <div class="card-header">
      <h2 class="card-title">Recently checked</h2>
      <%= render "shared/search_form", url: admin_guardian_consents_path, frame: "guardian_consents_recent", placeholder: "Search members" %>
    </div>

    <%= turbo_frame_tag "guardian_consents_recent", target: "_top" do %>
      <% if params[:search].present? %>
        <p class="px-5 py-3 text-sm text-ink-soft border-b border-hairline">
          <%= pluralize(@recent.size, "consent") %> <%= @recent.size == 1 ? "matches" : "match" %> “<%= params[:search] %>”
        </p>
      <% end %>

      <% if @recent.any? %>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th scope="col">Member</th>
                <th scope="col">Checked by</th>
                <th scope="col">Note</th>
                <th scope="col">When</th>
              </tr>
            </thead>
            <tbody>
              <% @recent.each do |consent| %>
                <tr>
                  <td><%= link_to consent.user.full_name, admin_user_path(consent.user), class: "link-quiet font-medium" %></td>
                  <td><%= consent.reviewed_by&.full_name || "A deleted user" %></td>
                  <td class="text-ink-soft"><%= consent.review_note %></td>
                  <td class="whitespace-nowrap text-ink-soft"><%= time_ago_in_words(consent.reviewed_at) %> ago</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% elsif params[:search].present? %>
        <%= empty_state("No checked consents match “#{params[:search]}”", body: "Search by name, email or Weave ID.", icon: :search) %>
      <% else %>
        <%= empty_state("No consents checked yet.", icon: :history) %>
      <% end %>
    <% end %>
  </div>
</div>

<%# A member's Thread Count (see ThreadCount). Internal: admins see the score,
    and only superadmins and owners see the entries behind it. %>
<% content_for :title, "Thread Count: #{@user.full_name}" %>

<p class="mb-2 text-sm">
  <%= link_to admin_user_path(@user), class: "link-quiet inline-flex items-center gap-1 text-ink-soft" do %>
    <%= icon(:arrow_left, size: 14) %>Back to <%= @user.full_name %>
  <% end %>
</p>

<header class="page-header">
  <div>
    <h1 class="page-title">Thread Count</h1>
    <p class="page-lede">
      The internal trust score of <%= @user.full_name %>. Staff only: never tell the member their score or what it is made of.
      The weights in <code class="code-chip">config/thread_count.yml</code> are a first draft.
    </p>
  </div>
</header>

<div class="space-y-6">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
    <section class="card stat">
      <span class="stat-label">Score now</span>
      <span class="stat-value" data-testid="thread-count-score"><%= thread_count_number(@score) %></span>
      <span class="stat-note">Entries fade over time, so the score drops unless trust is renewed.</span>
    </section>

    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Vouch</h2>
      </div>
      <div class="card-body space-y-3">
        <% if @own_vouch %>
          <p class="field-hint">You vouched for this member on <%= @own_vouch.created_at.strftime("%b %-d, %Y") %>. To renew it, vouch again and tick the renew box.</p>
        <% end %>
        <%= form_with url: admin_user_thread_count_entries_path(@user), method: :post, class: "space-y-3" do |form| %>
          <%= form.hidden_field :kind, value: "vouch" %>
          <%= form.text_field :voucher, placeholder: "On behalf of (Weave ID or email). Blank means you.", maxlength: 255,
                aria: { label: "On behalf of" }, class: "field" %>
          <%= form.text_area :reason, required: true, rows: 3, maxlength: ThreadCount::Entry::REASON_MAX_LENGTH,
                placeholder: "Why do you put your name on this member?", aria: { label: "Reason" }, class: "field" %>
          <%= form.url_field :evidence_url, placeholder: "Evidence link (optional)", aria: { label: "Evidence link" }, class: "field" %>
          <label class="choice text-sm">
            <%= form.check_box :renew, { class: "checkbox" }, "1", "0" %>
            <span>Renew an earlier vouch from the same voucher</span>
          </label>
          <%= form.submit "Vouch", class: "btn btn-secondary" %>
        <% end %>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Record an entry</h2>
      </div>
      <div class="card-body">
        <%= form_with url: admin_user_thread_count_entries_path(@user), method: :post, class: "space-y-3" do |form| %>
          <%= form.select :kind, @manual_kinds, {}, aria: { label: "Kind" }, class: "field" %>
          <%= form.text_area :reason, required: true, rows: 3, maxlength: ThreadCount::Entry::REASON_MAX_LENGTH,
                placeholder: "What happened? Write the reason in full.", aria: { label: "Reason" }, class: "field" %>
          <%= form.url_field :evidence_url, placeholder: "Evidence link (optional)", aria: { label: "Evidence link" }, class: "field" %>
          <%= form.submit "Record", class: "btn btn-secondary" %>
        <% end %>
      </div>
    </section>
  </div>

  <% if @own_vouch && @composition.nil? %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Withdraw your vouch</h2>
      </div>
      <div class="card-body">
        <%= form_with url: reverse_admin_user_thread_count_entry_path(@user, @own_vouch), method: :patch, class: "flex flex-col sm:flex-row gap-2" do |form| %>
          <%= form.text_field :reason, required: true, maxlength: 500, placeholder: "Why do you withdraw it?", aria: { label: "Reason" }, class: "field flex-1" %>
          <%= form.submit "Withdraw", class: "btn btn-danger", data: { turbo_confirm: "Withdraw your vouch for #{@user.full_name}?" } %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @composition %>
    <section class="card card-flush">
      <div class="card-header">
        <h2 class="card-title">What the score is made of</h2>
      </div>
      <% if @composition.empty? %>
        <%= empty_state("No entries yet.", icon: :list) %>
      <% else %>
        <% entries_by_id = @composition.to_h { |line| [line.entry.id, line.entry] } %>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th scope="col">When</th>
                <th scope="col">Entry</th>
                <th scope="col" class="num">Weight</th>
                <th scope="col" class="num">Now</th>
                <th scope="col">From</th>
                <th scope="col">Reason</th>
                <th scope="col" class="actions"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% @composition.each do |line| %>
                <% entry = line.entry %>
                <% author = entry.author %>
                <% recorder = entry.recorded_by %>
                <% service = entry.service %>
                <tr class="<%= 'opacity-60' if entry.reversal? || line.reversed? %>">
                  <td class="whitespace-nowrap text-ink-faint"><%= entry.created_at.strftime("%b %-d, %Y") %></td>
                  <td>
                    <%= thread_count_label(entry.kind, entry.level) %>
                    <% reversed_entry = entries_by_id[entry.reverses_id] %>
                    <% if reversed_entry %>
                      <span class="table-sub">of the <%= thread_count_label(reversed_entry.kind, reversed_entry.level).downcase %> from <%= reversed_entry.created_at.strftime("%b %-d, %Y") %></span>
                    <% elsif line.reversed? %>
                      <span class="table-sub">(reversed)</span>
                    <% end %>
                    <% if entry.project_ref %>
                      <span class="table-sub">Project <code class="mono"><%= entry.project_ref %></code></span>
                    <% end %>
                  </td>
                  <td class="num"><%= thread_count_number(line.weight) %></td>
                  <td class="num"><%= thread_count_number(line.contribution) %></td>
                  <td class="text-ink-soft">
                    <% if service %>
                      <%= service.name %> (service)
                    <% else %>
                      <%= author&.full_name || "a deleted user" %>
                      <% if recorder && recorder != author %>
                        <span class="table-sub">recorded by <%= recorder.full_name %></span>
                      <% end %>
                    <% end %>
                  </td>
                  <td class="text-ink-soft min-w-48 max-w-md">
                    <%= entry.reason %>
                    <% if entry.evidence_url %>
                      <span class="table-sub"><%= link_to "Evidence", entry.evidence_url, rel: "noopener noreferrer", target: "_blank", class: "link" %></span>
                    <% end %>
                  </td>
                  <td class="actions">
                    <% unless entry.reversal? || line.reversed? %>
                      <details class="text-left">
                        <summary class="link text-sm cursor-pointer">Reverse</summary>
                        <%= form_with url: reverse_admin_user_thread_count_entry_path(@user, entry), method: :patch, class: "mt-2 space-y-2 min-w-48" do |form| %>
                          <%= form.text_field :reason, required: true, maxlength: 500, placeholder: "Why?", aria: { label: "Reason" }, class: "field field-sm" %>
                          <%= form.submit "Reverse", class: "btn btn-danger btn-sm",
                                data: { turbo_confirm: "Reverse this entry?" } %>
                        <% end %>
                      </details>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </section>
  <% else %>
    <p class="field-hint">Only superadmins and owners can see what the score is made of.</p>
  <% end %>
</div>

<% content_for :title, "Knot #{@knot.public_id}" %>

<p class="mb-2 text-sm">
  <%= link_to admin_knots_path, class: "link-quiet inline-flex items-center gap-1 text-ink-soft" do %>
    <%= icon(:arrow_left, size: 14) %>Knot requests
  <% end %>
</p>

<header class="page-header">
  <div class="min-w-0">
    <h1 class="page-title">Knot <span class="mono"><%= @knot.public_id %></span></h1>
    <p class="page-lede">
      <% if @user %>
        Keyed to <%= link_to @user.full_name, admin_user_path(@user), class: "link" %> (<span class="mono"><%= @user.p_id %></span>).
      <% else %>
        Detached: the account was deleted. The Knot identifies nobody.
      <% end %>
    </p>
  </div>
  <% if @knot.blacklisted %>
    <div class="page-actions"><%= badge "Fraud flag", tone: :danger, icon: :flag %></div>
  <% end %>
</header>

<div class="space-y-6">
  <section class="card">
    <div class="card-header">
      <h2 class="card-title">State</h2>
    </div>
    <div class="card-body space-y-2 text-sm text-ink">
      <p>Fraud flag: <strong><%= @knot.blacklisted ? "yes" : "no" %></strong>. The reason is in the audit record, not here.</p>
      <p>
        Grants received:
        <% if @grants.any? %>
          <%= @grants.map { |program, count| "#{KnotSettings.program(program)&.name || program}: #{count}" }.join(", ") %>
        <% else %>
          none
        <% end %>
      </p>
      <p class="text-ink-faint">
        Hashes: <%= KnotHasher::KINDS.map { |kind| "#{kind.humanize} #{@hash_counts.fetch(kind, 0)}" }.join(", ") %>.
        The hashes are one-way. Weave can't show the values behind them.
      </p>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
    <section class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title"><%= @knot.blacklisted ? "Clear the fraud flag" : "Set the fraud flag" %></h2>
          <p class="card-lede">A second identity team member must sign off. The reason goes into the verification audit record.</p>
        </div>
      </div>
      <div class="card-body">
        <%= form_with url: request_blacklist_admin_knot_path(@knot), method: :post, class: "space-y-3" do |form| %>
          <%= form.hidden_field :blacklisted, value: @knot.blacklisted ? "0" : "1" %>
          <%= form.text_area :reason, required: true, rows: 2, placeholder: "Written reason", aria: { label: "Written reason" }, class: "field" %>
          <%= form.submit "Ask for sign-off", class: "btn btn-secondary" %>
        <% end %>
      </div>
    </section>

    <% if @user %>
      <section class="card">
        <div class="card-header">
          <div>
            <h2 class="card-title">Legal name change</h2>
            <p class="card-lede">
              Check continuity first: the member shows the new document or the change-of-name record. Type the new identifiers.
              Weave keeps only their hashes. A second identity team member must sign off. Old hashes, the flag and the grants stay.
            </p>
          </div>
        </div>
        <div class="card-body">
          <%= form_with url: request_name_change_admin_knot_path(@knot), method: :post, class: "space-y-3", html: { autocomplete: "off" } do |form| %>
            <%= form.select :evidence, [["Change-of-name record", "change_of_name_record"], ["New document", "new_document"]], {},
                  aria: { label: "Evidence" }, class: "field" %>
            <div class="form-grid form-grid-2">
              <%= fields_for :identifiers do |ids| %>
                <%= ids.text_field :legal_name, required: true, placeholder: "New legal name", aria: { label: "New legal name" }, class: "field" %>
                <%= ids.date_field :date_of_birth, required: true, aria: { label: "Date of birth" }, class: "field" %>
                <%= ids.select :document_type, [["No new document", ""]] + Verification::DOCUMENT_TYPES.map { |type| [type.humanize, type] }, {},
                      aria: { label: "Document type" }, class: "field" %>
                <%= ids.text_field :issuing_country, maxlength: 2, placeholder: "Issuing country (two letters)", aria: { label: "Issuing country" }, class: "field" %>
                <%= ids.text_field :document_number, placeholder: "Document number (new document only)", aria: { label: "Document number" }, class: "field" %>
                <%= ids.text_field :national_id, placeholder: "National identity number (if any)", aria: { label: "National identity number" }, class: "field" %>
              <% end %>
            </div>
            <%= form.text_area :note, required: true, rows: 2, placeholder: "How you checked continuity", aria: { label: "How you checked continuity" }, class: "field" %>
            <%= form.submit "Ask for sign-off", class: "btn btn-secondary" %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>

  <% if @requests.any? %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Waiting for sign-off</h2>
        <%= link_to "Open the queue", admin_knots_path, class: "btn btn-quiet btn-sm" %>
      </div>
      <div class="card-body">
        <div class="record-list">
          <% @requests.each do |request| %>
            <div class="record">
              <div class="record-main text-sm text-ink"><%= t("knot.changes.#{request.kind}") %>, asked by <%= request.requested_by&.full_name || "a deleted user" %>.</div>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <section class="card">
    <div class="card-header">
      <div>
        <h2 class="card-title">Linked attempts</h2>
        <p class="card-lede">Attempts from deleted accounts stay while their audit records are kept.</p>
      </div>
    </div>
    <div class="card-body">
      <ol class="record-list">
        <% @verifications.each do |verification| %>
          <li class="record">
            <div class="record-main text-sm text-ink">
              <%= link_to verification.public_id, identity_verification_path(verification), class: "link mono" %>:
              <%= verification.status.humanize %>, <%= verification.created_at.to_date.to_fs(:long) %>
              <%= "(account deleted)" if verification.user_id.nil? %>
            </div>
          </li>
        <% end %>
      </ol>
    </div>
  </section>
</div>

<% content_for :title, "Knot requests" %>

<header class="page-header">
  <div>
    <h1 class="page-title">The Knot: two-key requests</h1>
    <p class="page-lede">
      A change to a Knot needs a second person. Sign off only when you checked the reason in the audit record.
      You see the requests you can sign off, decline or withdraw.
    </p>
  </div>
  <% if @blacklisted_count %>
    <div class="page-actions">
      <%= badge "Knots with the fraud flag: #{@blacklisted_count}", tone: (@blacklisted_count.positive? ? :danger : :neutral), icon: :flag %>
    </div>
  <% end %>
</header>

<div class="space-y-6">
  <% if @knot_reviews&.any? %>
    <section class="card">
      <div class="card-header">
        <div class="flex items-center gap-2">
          <h2 class="card-title">Calls that need a second verifier</h2>
          <%= badge(@knot_reviews.size.to_s, tone: :warning) %>
        </div>
      </div>
      <div class="card-body">
        <div class="record-list">
          <% @knot_reviews.each do |verification| %>
            <div class="record">
              <div class="record-main text-sm text-ink">
                <%= link_to verification.public_id, identity_verification_path(verification), class: "link mono" %>:
                <%= t("knot.review_reasons.#{verification.knot_review_reason}") %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <section class="card">
    <div class="card-header">
      <div class="flex items-center gap-2">
        <h2 class="card-title">Waiting for sign-off</h2>
        <%= badge(@requests.size.to_s, tone: (@requests.any? ? :warning : :neutral)) %>
      </div>
    </div>
    <% if @requests.empty? %>
      <%= empty_state("Nothing is waiting for you.", icon: :circle_check) %>

    <% else %>
      <div class="card-body">
        <div class="record-list">
          <% @requests.each do |request| %>
            <div class="record flex-col items-stretch">
              <div class="record-main space-y-1">
                <p class="text-sm text-ink">
                  <strong><%= t("knot.changes.#{request.kind}") %></strong><%= " (#{KnotSettings.program(request.program)&.name})" if request.program %>
                  on
                  <% if current_user.identity_team %>
                    <%= link_to request.knot.public_id, admin_knot_path(request.knot), class: "link mono" %>
                  <% else %>
                    <span class="mono"><%= request.knot.public_id %></span>
                  <% end %>,
                  asked by <%= request.requested_by&.full_name || "a deleted user" %>, <%= time_label(request.created_at, :relative) %>.
                </p>
                <% reason = request.verification.events.where(kind: "knot_change_requested").order(:created_at).last&.data&.dig("reason") %>
                <p class="record-meta">Reason in the audit record: <%= reason %></p>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                <% if KnotChanges.can_sign_off?(request, current_user) %>
                  <%= button_to "Sign off", sign_off_admin_knot_change_request_path(request), method: :patch, class: "btn btn-secondary btn-sm",
                        data: { turbo_confirm: "Sign off this change?" } %>
                <% end %>
                <%= form_with url: decline_admin_knot_change_request_path(request), method: :patch, class: "flex flex-1 flex-col sm:flex-row gap-2" do |form| %>
                  <%= form.text_field :reason, required: true, placeholder: "Why not?", aria: { label: "Why not?" }, class: "field field-sm flex-1" %>
                  <%= form.submit request.requested_by_id == current_user.id ? "Withdraw" : "Decline", class: "btn btn-secondary btn-sm" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
</div>

<% permissions = admin_permissions_for(@user) %>
<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto">
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="font-display text-2xl font-bold text-ink">Edit User</h1>
        <p class="text-ink-soft">Update user information and settings</p>
      </div>
      <%= link_to 'Back to User', admin_user_path(@user),
          class: 'btn-stitch-ghost' %>
    </div>

    <%= form_with(model: [:admin, @user], local: true, class: "space-y-6") do |form| %>
      <% if @user.errors.any? %>
        <div class="patch border-2 border-orchid bg-orchid-soft/40 text-ink p-4">
          <h3 class="text-sm font-medium text-orchid">There were <%= pluralize(@user.errors.count, "error") %> with your submission:</h3>
          <div class="mt-2 text-sm text-ink">
            <ul role="list" class="list-disc space-y-1 pl-5">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <div class="patch p-6">
        <h2 class="font-display text-lg font-bold text-ink mb-4">Basic Information</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= form.label :first_name, "Preferred first name", class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :first_name,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :last_name, "Preferred last name", class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :last_name,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :legal_first_name, class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :legal_first_name,
                maxlength: 100,
                placeholder: "Same as preferred name",
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :legal_last_name, class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :legal_last_name,
                maxlength: 100,
                placeholder: "Same as preferred name",
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div class="md:col-span-2 -mt-2">
            <p class="text-xs text-ink-faint">Leave the legal name fields blank if they match the preferred name. The legal name is only used where it's legally required.</p>
          </div>
          <div>
            <%= form.label :email, class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.email_field :email,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :pronouns, class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :pronouns,
                placeholder: "e.g. they/them",
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :phone_number, class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.telephone_field :phone_number,
                placeholder: "(802) 555-0123",
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :birthday, class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.date_field :birthday,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
            <p class="mt-1 text-xs text-ink-faint">Leave blank to clear the birthday.</p>
          </div>
        </div>
      </div>

      <div class="patch p-6">
        <h2 class="font-display text-lg font-bold text-ink mb-4">Account Settings</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <% if permissions.assignable_roles.any? %>
              <%= form.label :role, "Access Level", class: "block text-sm font-medium text-ink mb-1" %>
              <%= form.select :role,
                  options_for_select(permissions.assignable_roles.map { |role| [role.titleize, role] }, @user.role),
                  {},
                  class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors" %>
            <% else %>
              <p class="block text-sm font-medium text-ink mb-1">Access Level</p>
              <p class="text-sm text-ink"><%= @user.role.titleize %></p>
              <p class="mt-1 text-xs text-ink-faint">Only a superadmin or owner who outranks this user can change their access level, and never their own.</p>
            <% end %>
          </div>
        </div>
      </div>

      <div class="patch p-6">
        <h2 class="font-display text-lg font-bold text-ink mb-4">Staff &amp; Organization</h2>
        <div class="space-y-4">
          <div class="flex items-start">
            <div class="flex items-center h-5">
              <%= form.check_box :is_board,
                  class: "h-4 w-4 rounded border-2 border-neutral-300 text-grape focus:ring-grape" %>
            </div>
            <div class="ml-3 text-sm">
              <%= form.label :is_board, "Board member", class: "font-medium text-ink" %>
              <p class="text-ink-soft">Mark as a board member</p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="flex items-center h-5">
              <%= form.check_box :is_staff,
                  class: "h-4 w-4 rounded border-2 border-neutral-300 text-grape focus:ring-grape" %>
            </div>
            <div class="ml-3 text-sm">
              <%= form.label :is_staff, class: "font-medium text-ink" %>
              <p class="text-ink-soft">Mark as staff member (can have/be a manager)</p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="flex items-center h-5">
              <%= form.check_box :is_contractor,
                  class: "h-4 w-4 rounded border-2 border-neutral-300 text-grape focus:ring-grape" %>
            </div>
            <div class="ml-3 text-sm">
              <%= form.label :is_contractor, class: "font-medium text-ink" %>
              <p class="text-ink-soft">Mark as contractor (can have/be a manager)</p>
            </div>
          </div>

          <div>
            <%= form.label :manager_id, "Manager", class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.collection_select :manager_id,
                User.where(is_staff: true).or(User.where(is_contractor: true)).order(:first_name),
                :id, :full_name,
                { include_blank: "No manager" },
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors" %>
            <p class="mt-1 text-xs text-ink-faint">Only staff and contractors can be managers</p>
          </div>
        </div>
      </div>

      <div class="patch p-6">
        <h2 class="font-display text-lg font-bold text-ink mb-4">Professional Information</h2>
        <p class="text-sm text-ink-faint mb-4">These fields sync with Slack (API-editable fields)</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= form.label :slack_title, "Job Title", class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :slack_title,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :slack_department, "Department", class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :slack_department,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :slack_division, "Division", class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :slack_division,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :slack_organization, "Organization", class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :slack_organization,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :slack_city, "City", class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :slack_city,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :slack_state, "State", class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :slack_state,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :slack_country, "Country", class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :slack_country,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
          <div>
            <%= form.label :slack_cost_center, "Cost Center", class: "block text-sm font-medium text-ink mb-1" %>
            <%= form.text_field :slack_cost_center,
                class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
          </div>
        </div>
      </div>

      <% if permissions.change_password? %>
        <div class="patch p-6">
          <h2 class="font-display text-lg font-bold text-ink mb-4">Change Password</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= form.label :password, class: "block text-sm font-medium text-ink mb-1" %>
              <%= form.password_field :password,
                  class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
              <p class="mt-1 text-xs text-ink-faint">Leave blank to keep current password.</p>
            </div>
            <div>
              <%= form.label :password_confirmation, class: "block text-sm font-medium text-ink mb-1" %>
              <%= form.password_field :password_confirmation,
                  class: "w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
            </div>
          </div>
        </div>
      <% end %>

      <div class="flex justify-end space-x-3">
        <%= link_to 'Cancel', admin_user_path(@user),
            class: 'btn-stitch-ghost' %>
        <%= form.submit "Save Changes",
            class: 'btn-stitch' %>
      </div>
    <% end %>
  </div>
</div>

<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto">
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Edit User</h1>
        <p class="text-gray-600">Update user information and settings</p>
      </div>
      <%= link_to 'Back to User', admin_user_path(@user), 
          class: 'inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50' %>
    </div>

    <%= form_with(model: [:admin, @user], local: true, class: "space-y-6") do |form| %>
      <% if @user.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-md p-4">
          <div class="flex">
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800">There were <%= pluralize(@user.errors.count, "error") %> with your submission:</h3>
              <div class="mt-2 text-sm text-red-700">
                <ul role="list" class="list-disc space-y-1 pl-5">
                  <% @user.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4">Basic Information</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= form.label :first_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :first_name, 
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
          <div>
            <%= form.label :last_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :last_name, 
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
          <div>
            <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.email_field :email, 
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
          <div>
            <%= form.label :birthday, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.date_field :birthday, 
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            <p class="mt-1 text-xs text-gray-500">Leave blank to clear the birthday.</p>
          </div>
        </div>
      </div>

      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4">Account Settings</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= form.label :role, "Access Level", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.select :role,
                options_for_select([
                  ['User', 'user'],
                  ['Admin', 'admin'],
                  ['Owner', 'owner']
                ], @user.role),
                {},
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
        </div>
      </div>

      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4">Staff & Organization</h2>
        <div class="space-y-4">
          <div class="flex items-start">
            <div class="flex items-center h-5">
              <%= form.check_box :is_staff,
                  class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
            </div>
            <div class="ml-3 text-sm">
              <%= form.label :is_staff, class: "font-medium text-gray-700" %>
              <p class="text-gray-500">Mark as staff member (can have/be a manager)</p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="flex items-center h-5">
              <%= form.check_box :is_contractor,
                  class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
            </div>
            <div class="ml-3 text-sm">
              <%= form.label :is_contractor, class: "font-medium text-gray-700" %>
              <p class="text-gray-500">Mark as contractor (can have/be a manager)</p>
            </div>
          </div>

          <div>
            <%= form.label :manager_id, "Manager", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.collection_select :manager_id,
                User.where(is_staff: true).or(User.where(is_contractor: true)).order(:first_name),
                :id, :full_name,
                { include_blank: "No manager" },
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            <p class="mt-1 text-xs text-gray-500">Only staff and contractors can be managers</p>
          </div>
        </div>
      </div>

      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4">Professional Information</h2>
        <p class="text-sm text-gray-500 mb-4">These fields sync with Slack (API-editable fields)</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= form.label :slack_title, "Job Title", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :slack_title,
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
          <div>
            <%= form.label :slack_department, "Department", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :slack_department,
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
          <div>
            <%= form.label :slack_division, "Division", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :slack_division,
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
          <div>
            <%= form.label :slack_organization, "Organization", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :slack_organization,
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
          <div>
            <%= form.label :slack_city, "City", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :slack_city,
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
          <div>
            <%= form.label :slack_state, "State", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :slack_state,
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
          <div>
            <%= form.label :slack_country, "Country", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :slack_country,
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
          <div>
            <%= form.label :slack_cost_center, "Cost Center", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_field :slack_cost_center,
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
        </div>
      </div>

      <div class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4">Change Password</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= form.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.password_field :password, 
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            <p class="mt-1 text-xs text-gray-500">Leave blank to keep current password.</p>
          </div>
          <div>
            <%= form.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.password_field :password_confirmation, 
                class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
        </div>
      </div>

      <div class="flex justify-end space-x-3">
        <%= link_to 'Cancel', admin_user_path(@user), 
            class: 'px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50' %>
        <%= form.submit "Save Changes", 
            class: 'px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500' %>
      </div>
    <% end %>
  </div>
</div>
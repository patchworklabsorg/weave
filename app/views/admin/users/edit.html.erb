<% permissions = admin_permissions_for(@user) %>
<% content_for :title, "Edit #{@user.full_name}" %>

<div class="page-narrow mx-auto">
  <p class="mb-2 text-sm">
    <%= link_to admin_user_path(@user), class: "link-quiet inline-flex items-center gap-1 text-ink-soft" do %>
      <%= icon(:arrow_left, size: 14) %><%= @user.full_name %>
    <% end %>
  </p>

  <%= page_header "Edit User", lede: "Update user information and settings" %>

  <%= form_with(model: [:admin, @user], local: true, class: "space-y-6") do |form| %>
    <%= form_errors(@user) %>

    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Basic information</h2>
      </div>
      <div class="card-body">
        <div class="form-grid form-grid-2">
          <div class="field-group">
            <%= form.label :first_name, "Preferred first name", class: "field-label" %>
            <%= form.text_field :first_name, class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :last_name, "Preferred last name", class: "field-label" %>
            <%= form.text_field :last_name, class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :legal_first_name, class: "field-label" %>
            <%= form.text_field :legal_first_name, maxlength: 100, placeholder: "Same as preferred name", class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :legal_last_name, class: "field-label" %>
            <%= form.text_field :legal_last_name, maxlength: 100, placeholder: "Same as preferred name", class: "field" %>
          </div>
          <p class="field-hint span-2 -mt-2">Leave the legal name fields blank if they match the preferred name. The legal name is only used where it's legally required.</p>
          <div class="field-group">
            <%= form.label :email, class: "field-label" %>
            <%= form.email_field :email, class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :pronouns, class: "field-label" %>
            <%= form.text_field :pronouns, placeholder: "e.g. they/them", maxlength: User::PRONOUNS_MAX_LENGTH, class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :phone_number, class: "field-label" %>
            <%= form.telephone_field :phone_number, placeholder: "(802) 555-0123", class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :birthday, class: "field-label" %>
            <%= form.date_field :birthday, class: "field" %>
            <p class="field-hint">Leave blank to clear the birthday.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Account settings</h2>
      </div>
      <div class="card-body">
        <div class="form-grid form-grid-2">
          <div class="field-group">
            <% if permissions.assignable_roles.any? %>
              <%= form.label :role, "Access level", class: "field-label" %>
              <%= form.select :role,
                    options_for_select(permissions.assignable_roles.map { |role| [role.titleize, role] }, @user.role),
                    {},
                    class: "field" %>
            <% else %>
              <span class="field-label">Access level</span>
              <span class="field-static"><%= @user.role.titleize %></span>
              <p class="field-hint">Only a superadmin or owner who outranks this user can change their access level, and never their own.</p>
            <% end %>
          </div>
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Staff &amp; Organization</h2>
      </div>
      <div class="card-body space-y-4">
        <label class="choice">
          <%= form.check_box :is_board, class: "checkbox" %>
          <span>Board member<span class="choice-hint">Mark as a board member</span></span>
        </label>
        <label class="choice">
          <%= form.check_box :is_staff, class: "checkbox" %>
          <span>Is staff<span class="choice-hint">Mark as staff member (can have/be a manager)</span></span>
        </label>
        <label class="choice">
          <%= form.check_box :is_contractor, class: "checkbox" %>
          <span>Is contractor<span class="choice-hint">Mark as contractor (can have/be a manager)</span></span>
        </label>
        <div class="field-group">
          <%= form.label :manager_id, "Manager", class: "field-label" %>
          <%= form.collection_select :manager_id,
                User.where(is_staff: true).or(User.where(is_contractor: true)).order(:first_name),
                :id, :full_name,
                { include_blank: "No manager" },
                class: "field" %>
          <p class="field-hint">Only staff and contractors can be managers</p>
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title">Professional information</h2>
          <p class="card-lede">These fields sync with Slack (API-editable fields)</p>
        </div>
      </div>
      <div class="card-body">
        <div class="form-grid form-grid-2">
          <% [
            [:slack_title, "Job title"], [:slack_department, "Department"],
            [:slack_division, "Division"], [:slack_organization, "Organization"],
            [:slack_city, "City"], [:slack_state, "State"],
            [:slack_country, "Country"], [:slack_cost_center, "Cost center"]
          ].each do |attribute, label| %>
            <div class="field-group">
              <%= form.label attribute, label, class: "field-label" %>
              <%= form.text_field attribute, class: "field" %>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <% if permissions.change_password? %>
      <section class="card">
        <div class="card-header">
          <h2 class="card-title">Change password</h2>
        </div>
        <div class="card-body">
          <div class="form-grid form-grid-2">
            <div class="field-group">
              <%= form.label :password, class: "field-label" %>
              <%= form.password_field :password, class: "field" %>
              <p class="field-hint">Leave blank to keep current password.</p>
            </div>
            <div class="field-group">
              <%= form.label :password_confirmation, class: "field-label" %>
              <%= form.password_field :password_confirmation, class: "field" %>
            </div>
          </div>
        </div>
      </section>
    <% end %>

    <div class="form-actions">
      <%= link_to "Cancel", admin_user_path(@user), class: "btn btn-secondary" %>
      <%= form.submit "Save changes", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<%# Admin only: who signed in as this user. Never render this on user-facing pages. %>
<section class="card card-flush" id="impersonations">
  <div class="card-header">
    <div>
      <h2 class="card-title">Impersonations</h2>
      <p class="card-lede">Admins who signed in as this user, or tried to. Only admins can see this.</p>
    </div>
  </div>
  <% if impersonations.any? %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Status</th>
            <th>Admin</th>
            <th>Started</th>
            <th>Duration</th>
            <th>Ended by</th>
            <th>IP</th>
            <th class="actions">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% impersonations.each do |impersonation| %>
            <tr>
              <td class="whitespace-nowrap">
                <% if impersonation.denied? %>
                  <%= badge "Denied", tone: :danger %>
                <% elsif impersonation.active? %>
                  <%= badge "Not ended", tone: :warning %>
                <% else %>
                  <%= badge "Ended" %>
                <% end %>
              </td>
              <td>
                <% if impersonation.admin %>
                  <%= link_to impersonation.admin.full_name, admin_user_path(impersonation.admin), class: "link" %>
                  <span class="table-sub"><%= impersonation.admin.email %></span>
                <% else %>
                  <span class="text-ink-faint">Deleted admin</span>
                <% end %>
              </td>
              <td class="whitespace-nowrap text-ink-soft">
                <%= time_label(impersonation.started_at, :relative) %>
              </td>
              <td class="whitespace-nowrap text-ink-soft">
                <%= impersonation.duration ? distance_of_time_in_words(impersonation.duration) : "—" %>
              </td>
              <td class="whitespace-nowrap text-ink-soft">
                <%= { "stopped" => "Stop impersonating", "logged_out" => "Log out" }.fetch(impersonation.end_reason, "—") %>
              </td>
              <td class="whitespace-nowrap mono text-ink-soft"><%= impersonation.ip || "Unknown" %></td>
              <td class="actions">
                <% if impersonation.denied? %>
                  <span class="text-ink-faint">—</span>
                <% else %>
                  <%= link_to "View #{pluralize(action_counts.fetch(impersonation.id, 0), 'action')}",
                        admin_user_impersonation_path(impersonation.user, impersonation),
                        class: "link" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state "No admin has impersonated this user.", icon: :venetian_mask %>
  <% end %>
</section>

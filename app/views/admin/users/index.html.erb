<% content_for :title, "Users" %>

<%= page_header "Users", lede: "Everyone with a Weave account." do %>
  <%= link_to new_admin_user_path, class: "btn btn-primary" do %>
    <%= icon(:plus) %>New user
  <% end %>
<% end %>

<section class="card card-flush">
  <div class="card-header">
    <div class="w-full">
      <%= render "shared/search_form", url: admin_users_path, frame: "users_table", placeholder: "Search by name, email or PWL ID", autofocus: true %>
    </div>
  </div>

  <%= turbo_frame_tag "users_table" do %>
    <% if params[:search].present? %>
      <p class="px-5 pt-3 text-sm text-ink-soft">
        <%= pluralize(@users.size, "user") %> <%= @users.size == 1 ? "matches" : "match" %> &ldquo;<%= params[:search] %>&rdquo;
      </p>
    <% end %>

    <% if @users.any? %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Name</th>
              <th>PWL ID</th>
              <th>Role</th>
              <th>Joined</th>
              <th class="actions"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr>
                <td>
                  <%= user.full_name %>
                  <span class="table-sub"><%= user.email %></span>
                </td>
                <td class="mono"><%= user.p_id %></td>
                <td>
                  <%= badge user.role.titleize, tone: (user.superadmin? ? :grape : (user.admin? ? :violet : :neutral)) %>
                </td>
                <td class="whitespace-nowrap text-ink-soft" title="<%= user.created_at.iso8601 %>">
                  <%= time_ago_in_words(user.created_at) %> ago
                </td>
                <td class="actions">
                  <% if user.is_viewable?(current_user) %>
                    <%= link_to "View", admin_user_path(user), class: "btn btn-quiet btn-sm", data: { turbo_frame: "_top" } %>
                  <% end %>
                  <% if user.is_impersonatable?(current_user) && !impersonating? %>
                    <%= button_to "Impersonate", impersonate_admin_user_path(user), method: :post,
                          class: "btn btn-quiet btn-sm",
                          form: { class: "inline-block", data: { turbo: false } },
                          local: true,
                          data: { turbo_confirm: "Are you sure you want to impersonate #{user.full_name}?" } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% elsif params[:search].present? %>
      <%= empty_state "No users match", body: "Try a different name, email or PWL ID.", icon: :search_x %>
    <% else %>
      <%= empty_state "No users yet", icon: :users %>
    <% end %>
  <% end %>
</section>

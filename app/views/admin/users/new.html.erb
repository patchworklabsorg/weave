<% permissions = admin_permissions_for(@user) %>
<% content_for :title, "New user" %>

<div class="page-narrow mx-auto">
  <%= page_header "New user", lede:
 "The user signs in with a magic link sent to this email address." %>

  <%= form_with(model: [:admin, @user], local: true, class: "space-y-6") do |form| %>
    <%= form_errors(@user) %>

    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Basic information</h2>
      </div>
      <div class="card-body">
        <div class="form-grid form-grid-2">
          <div class="field-group">
            <%= form.label :first_name, class: "field-label" %>
            <%= form.text_field :first_name, required: true, class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :last_name, class: "field-label" %>
            <%= form.text_field :last_name, required: true, class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :email, class: "field-label" %>
            <%= form.email_field :email, required: true, class: "field" %>
          </div>
          <div class="field-group">
            <%= form.label :phone_number, class: "field-label" %>
            <%= form.telephone_field :phone_number, placeholder: "(802) 555-0123", class: "field" %>
          </div>
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Account settings</h2>
      </div>
      <div class="card-body">
        <div class="form-grid form-grid-2">
          <div class="field-group">
            <% if permissions.assignable_roles.any? %>
              <%= form.label :role, "Access level", class: "field-label" %>
              <%= form.select :role,
                    options_for_select(permissions.assignable_roles.map { |role| [role.titleize, role] }, @user.role),
                    {},
                    class: "field" %>
            <% else %>
              <span class="field-label">Access level</span>
              <span class="field-static"><%= @user.role.titleize %></span>
              <p class="field-hint">Only a superadmin or owner can give a new user a higher access level.</p>
            <% end %>
          </div>
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Staff and organization</h2>
      </div>
      <div class="card-body space-y-4">
        <p class="field-hint">Board member, staff and contractor are roles. Give them in the Roles section of the user page after you create the account. Each role has its own grant rule.</p>
        <div class="field-group">
          <%= form.label :manager_id, "Manager", class: "field-label" %>
          <%= form.collection_select :manager_id,
                User.staff_members.or(User.contractors).order(:first_name),
                :id, :full_name,
                { include_blank: "No manager" },
                class: "field" %>
          <p class="field-hint">Only staff and contractors can be managers</p>
        </div>
      </div>
    </section>

    <div class="form-actions">
      <%= link_to "Cancel", admin_users_path, class: "btn btn-secondary" %>
      <%= form.submit "Create user", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

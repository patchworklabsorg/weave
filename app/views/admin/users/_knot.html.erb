<%# The member's Knot and program grants (see Knot and KnotGrants), on the
    admin user page. %>
<% knot = user.knot %>
<div class="space-y-2">
  <h3 class="section-title">Knot and program grants</h3>
  <% if knot.nil? %>
    <p class="record-meta">No Knot: the member has not passed identity verification. No grant can be recorded.</p>
  <% else %>
    <%# Only the identity team sees the fraud flag. A patch lead or an owner
        learns it only through the grant eligibility text below. %>
    <% if current_user.identity_team %>
      <p class="record-meta">
        Fraud flag: <%= knot.blacklisted ? "yes" : "no" %>.
        <%= link_to "Open the Knot", admin_knot_path(knot), class: "link" %>
      </p>
    <% end %>
    <div class="record-list">
      <% KnotSettings.programs.each do |program| %>
        <% received = knot.grants_received(program.key) %>
        <div class="record flex-col items-stretch gap-2">
          <p class="record-title font-normal"><%= program.name %>: <%= received %> received<%= program.grant_cap ? " of #{program.grant_cap} allowed" : ", no cap" %>.</p>
          <% if user != current_user && (current_user.owner? || KnotGrants.patch_lead?(current_user, program.key)) %>
            <% if KnotGrants.eligible?(user, program.key) %>
              <%= button_to "Record a grant", admin_user_program_grants_path(user, program: program.key), method: :post,
                    class: "btn btn-secondary btn-sm", data: { turbo_confirm: "Record a #{program.name} grant?" } %>
            <% elsif KnotGrants.eligibility(user, program.key) == :cap_reached && KnotGrants.patch_lead?(current_user, program.key) %>
              <%= form_with url: override_admin_user_program_grants_path(user), method: :post, class: "well space-y-2" do |form| %>
                <%= form.hidden_field :program, value: program.key %>
                <%= form.text_area :reason, required: true, rows: 2, placeholder: "Why this case needs a grant over the cap",
                      aria: { label: "Reason for the override" }, class: "field field-sm" %>
                <%= form.submit "Ask a board member to sign off an override", class: "btn btn-secondary btn-sm" %>
              <% end %>
            <% else %>
              <p class="record-meta"><%= t("knot.grants.#{KnotGrants.eligibility(user, program.key)}") %></p>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

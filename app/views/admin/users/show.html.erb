<div class="container mx-auto px-4 py-8">
  <% if @user.birthday.present? && @user.birthday.month == Date.current.month && @user.birthday.day == Date.current.day %>
    <div class="bg-gradient-to-r from-orchid to-grape rounded-lg p-4 mb-6">
      <div class="flex items-center">
        <div class="text-white">
          <div class="text-2xl">🎉</div>
        </div>
        <div class="ml-3">
          <h3 class="font-display text-lg font-medium text-white">Happy Birthday!</h3>
          <p class="text-white/80">It's <%= @user.first_name %>'s birthday today!</p>
        </div>
      </div>
    </div>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="font-display text-2xl font-bold text-ink"><%= @user.full_name %></h1>
      <p class="text-ink-soft">PWL ID: <%= @user.p_id %></p>
    </div>
    <div class="space-x-2">
      <%= link_to 'Edit User', edit_admin_user_path(@user), class: 'btn-stitch-ghost' %>
      <% if @user.is_impersonatable?(current_user) && !impersonating? %>
        <%= button_to 'Impersonate', impersonate_admin_user_path(@user), method: :post,
            class: 'btn-stitch',
            form: { data: { turbo: false } },
            local: true,
            data: { turbo_confirm: "Are you sure you want to impersonate #{@user.full_name}?" } %>
      <% end %>
      <%= link_to 'Back to Users', admin_users_path, class: 'btn-stitch-ghost' %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- User Details -->
    <div class="patch p-6">
      <h2 class="font-display text-lg font-bold text-ink mb-4">User Details</h2>
      <dl class="space-y-3">
        <div>
          <dt class="text-sm font-medium text-ink-faint">Full Name</dt>
          <dd class="text-sm text-ink"><%= @user.full_name %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-ink-faint">Email</dt>
          <dd class="text-sm text-ink"><%= @user.email %></dd>
        </div>
        <% if @user.birthday.present? %>
          <div>
            <dt class="text-sm font-medium text-ink-faint">Birthday</dt>
            <dd class="text-sm text-ink"><%= @user.birthday.strftime("%B %d, %Y") %></dd>
          </div>
        <% end %>
        <div>
          <dt class="text-sm font-medium text-ink-faint">P_ID</dt>
          <dd class="text-sm text-ink flex items-center justify-between">
            <span><%= @user.p_id %></span>
            <% if current_user.owner? %>
              <%= button_to 'Regenerate', regen_pid_admin_user_path(@user), method: :patch,
                  class: 'ml-2 inline-flex items-center px-2 py-1 border border-transparent text-xs font-medium rounded text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500',
                  data: { turbo_confirm: "Are you sure you want to regenerate the P_ID for #{@user.full_name}? This cannot be undone." } %>
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-ink-faint">Access Level</dt>
          <dd class="text-sm">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @user.admin? ? 'bg-orchid-soft text-orchid' : 'bg-teal-soft text-teal' %>">
              <%= @user.role.titleize %>
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-ink-faint">Email Verified</dt>
          <dd class="text-sm">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @user.email_verified? ? 'bg-teal-soft text-teal' : 'bg-orchid-soft text-orchid' %>">
              <%= @user.email_verified? ? 'Verified' : 'Unverified' %>
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-ink-faint">Status</dt>
          <dd class="text-sm">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @user.status == 'active' ? 'bg-teal-soft text-teal' : 'bg-grape-soft text-ink-soft' %>">
              <%= @user.status.titleize %>
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-ink-faint">Created At</dt>
          <dd class="text-sm text-ink"><%= @user.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-ink-faint">Last Login</dt>
          <dd class="text-sm text-ink">
            <% if @user.last_login_at %>
              <%= @user.last_login_at.strftime("%B %d, %Y at %I:%M %p") %>
            <% else %>
              Never
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-ink-faint">Last Seen</dt>
          <dd class="text-sm text-ink">
            <% if @user.last_seen_at %>
              <%= time_ago_in_words(@user.last_seen_at) %> ago
            <% else %>
              Never
            <% end %>
          </dd>
        </div>
      </dl>
    </div>

    <!-- Activity Summary -->
    <div class="patch p-6">
      <h2 class="font-display text-lg font-bold text-ink mb-4">Activity Summary</h2>
      <dl class="space-y-3">
        <div>
          <dt class="text-sm font-medium text-ink-faint">Total Sessions</dt>
          <dd class="text-sm text-ink"><%= @user.user_sessions.count %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-ink-faint">Active Sessions</dt>
          <dd class="text-sm text-ink"><%= @user.user_sessions.not_expired.count %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-ink-faint">Total Visits</dt>
          <dd class="text-sm text-ink"><%= @user.visits.count %></dd>
        </div>
      </dl>
    </div>

    <!-- Organization -->
    <div class="patch p-6">
      <h2 class="font-display text-lg font-bold text-ink mb-4">Organization</h2>
      <dl class="space-y-3">
        <div>
          <dt class="text-sm font-medium text-ink-faint">Employment Type</dt>
          <dd class="text-sm">
            <% if @user.is_board %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-teal-soft text-teal">Board</span>
            <% end %>
            <% if @user.is_staff %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-sky-soft text-sky">Staff</span>
            <% end %>
            <% if @user.is_contractor %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-violet-soft text-violet">Contractor</span>
            <% end %>
            <% unless @user.is_board || @user.is_staff || @user.is_contractor %>
              <span class="text-ink-faint">Community member</span>
            <% end %>
          </dd>
        </div>
        <% if @user.manager.present? %>
          <div>
            <dt class="text-sm font-medium text-ink-faint">Manager</dt>
            <dd class="text-sm text-ink">
              <%= link_to @user.manager.full_name, admin_user_path(@user.manager), class: "text-grape hover:text-ink font-medium underline decoration-dashed underline-offset-2" %>
            </dd>
          </div>
        <% end %>
        <% if @user.reports.any? %>
          <div>
            <dt class="text-sm font-medium text-ink-faint">Direct Reports</dt>
            <dd class="text-sm text-ink">
              <% @user.reports.each do |report| %>
                <%= link_to report.full_name, admin_user_path(report), class: "inline-block mr-2 text-grape hover:text-ink font-medium underline decoration-dashed underline-offset-2" %>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>

    <!-- Professional Information -->
    <div class="patch p-6">
      <h2 class="font-display text-lg font-bold text-ink mb-4">Professional Information</h2>
      <p class="text-xs text-ink-faint mb-3">Synced with Slack</p>
      <dl class="space-y-3">
        <% if @user.slack_title.present? %>
          <div>
            <dt class="text-sm font-medium text-ink-faint">Job Title</dt>
            <dd class="text-sm text-ink"><%= @user.slack_title %></dd>
          </div>
        <% end %>
        <% if @user.slack_department.present? %>
          <div>
            <dt class="text-sm font-medium text-ink-faint">Department</dt>
            <dd class="text-sm text-ink"><%= @user.slack_department %></dd>
          </div>
        <% end %>
        <% if @user.slack_division.present? %>
          <div>
            <dt class="text-sm font-medium text-ink-faint">Division</dt>
            <dd class="text-sm text-ink"><%= @user.slack_division %></dd>
          </div>
        <% end %>
        <% if @user.slack_organization.present? %>
          <div>
            <dt class="text-sm font-medium text-ink-faint">Organization</dt>
            <dd class="text-sm text-ink"><%= @user.slack_organization %></dd>
          </div>
        <% end %>
        <% if @user.slack_city.present? || @user.slack_state.present? || @user.slack_country.present? %>
          <div>
            <dt class="text-sm font-medium text-ink-faint">Location</dt>
            <dd class="text-sm text-ink">
              <%= [@user.slack_city, @user.slack_state, @user.slack_country].compact.join(", ") %>
            </dd>
          </div>
        <% end %>
        <% if @user.slack_cost_center.present? %>
          <div>
            <dt class="text-sm font-medium text-ink-faint">Cost Center</dt>
            <dd class="text-sm text-ink"><%= @user.slack_cost_center %></dd>
          </div>
        <% end %>
        <% if @user.slack_id.present? %>
          <div>
            <dt class="text-sm font-medium text-ink-faint">Slack ID</dt>
            <dd class="text-sm text-ink font-mono"><%= @user.slack_id %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>

  <!-- Session Locations Map -->
  <% session_map_data = @user.user_sessions.filter_map(&:map_data) %>
  <% if session_map_data.any? %>
    <div class="mt-8 patch">
      <div class="px-6 py-4 border-b-2 border-dashed border-ink-soft/30">
        <h2 class="font-display text-lg font-bold text-ink">Session Locations</h2>
        <p class="text-sm text-ink-faint">Geographic locations of this user's login sessions</p>
      </div>
      <div class="px-6 py-4">
        <%= js_map session_map_data, height: "400px", zoom: 2 %>
        <div class="mt-4 flex space-x-6 text-sm">
          <div class="flex items-center">
            <div class="w-3 h-3 bg-teal rounded-full mr-2"></div>
            <span>Active Sessions</span>
          </div>
          <div class="flex items-center">
            <div class="w-3 h-3 bg-orange-500 rounded-full mr-2"></div>
            <span>Impersonated Sessions</span>
          </div>
          <div class="flex items-center">
            <div class="w-3 h-3 bg-ink-faint rounded-full mr-2"></div>
            <span>Expired Sessions</span>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- User Sessions -->
  <div class="mt-8 patch">
    <div class="px-6 py-4 border-b-2 border-dashed border-ink-soft/30">
      <h2 class="font-display text-lg font-bold text-ink">User Sessions</h2>
      <p class="text-sm text-ink-faint">Browser fingerprint and device information for this user's sessions</p>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-ink-soft/20">
        <thead class="bg-grape-soft">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-grape uppercase tracking-wider">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-grape uppercase tracking-wider">Device</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-grape uppercase tracking-wider">OS</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-grape uppercase tracking-wider">Location</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-grape uppercase tracking-wider">Created</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-grape uppercase tracking-wider">Last Seen</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-grape uppercase tracking-wider">Fingerprint</th>
          </tr>
        </thead>
        <tbody class="bg-paper divide-y divide-ink-soft/10">
          <% if @user.user_sessions.any? %>
            <% @user.user_sessions.order(created_at: :desc).each do |session| %>
              <tr class="<%= 'bg-teal-soft/40' if !session.expired? && session.signed_out_at.nil? %>">
                <td class="px-4 py-4 whitespace-nowrap text-sm">
                  <% if session.expired? || session.signed_out_at %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-grape-soft text-ink-soft">
                      Expired
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-teal-soft text-teal">
                      Active
                    </span>
                  <% end %>
                  <% if session.impersonated? %>
                    <span class="inline-flex items-center ml-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                      Impersonated
                    </span>
                  <% end %>
                </td>
                <td class="px-4 py-4 text-sm text-ink">
                  <%= session.device_info || 'Legacy Session' %>
                </td>
                <td class="px-4 py-4 text-sm text-ink-soft">
                  <%= session.os_info || 'Legacy Session' %>
                </td>
                <td class="px-4 py-4 text-sm text-ink-soft">
                  <div>
                    <div><%= session.ip || 'Unknown' %></div>
                    <% if session.latitude.present? && session.longitude.present? %>
                      <div class="text-xs text-ink-faint">
                        <%= session.location_name %>
                      </div>
                    <% end %>
                    <% if session.timezone.present? %>
                      <div class="text-xs text-ink-faint">
                        <%= session.timezone %>
                      </div>
                    <% end %>
                  </div>
                </td>
                <td class="px-4 py-4 whitespace-nowrap text-sm text-ink-soft">
                  <%= session.created_at.strftime("%m/%d/%Y %I:%M %p") %>
                </td>
                <td class="px-4 py-4 whitespace-nowrap text-sm text-ink-soft">
                  <% if session.last_seen_at %>
                    <%= time_ago_in_words(session.last_seen_at) %> ago
                  <% else %>
                    Never
                  <% end %>
                </td>
                <td class="px-4 py-4 text-sm font-mono text-ink-soft">
                  <% if session.fingerprint %>
                    <span class="truncate block w-24" title="<%= session.fingerprint %>">
                      <%= session.fingerprint %>
                    </span>
                  <% else %>
                    <span class="text-ink-faint">Legacy Session</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="px-4 py-8 text-center text-sm text-ink-faint">
                No sessions found for this user.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

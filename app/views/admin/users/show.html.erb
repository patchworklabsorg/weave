<% content_for :title, @user.full_name %>
<% role_tone = @user.superadmin? ? :grape : (@user.admin? ? :violet : :neutral) %>

<% if @user.birthday.present? && @user.birthday.month == Date.current.month && @user.birthday.day == Date.current.day %>
  <div class="callout callout-grape mb-6">
    <%= icon(:cake, size: 18) %>
    <div class="callout-body">
      <p class="callout-title">Happy Birthday!</p>
      <p>It's <%= @user.first_name %>'s birthday today!</p>
    </div>
  </div>
<% end %>

<header class="page-header">
  <div class="flex items-center gap-4 min-w-0">
    <%= avatar(@user, size: :lg) %>
    <div class="min-w-0">
      <h1 class="page-title"><%= @user.full_name %></h1>
      <div class="page-lede flex flex-wrap items-center gap-2">
        <span>Weave ID: <span class="mono"><%= @user.p_id %></span></span>
        <%= badge @user.role.titleize, tone: role_tone %>
        <%= badge @user.status.titleize, tone: (@user.status == "active" ? :success : :neutral) %>
        <%= badge (@user.email_verified? ? "Verified" : "Unverified"), tone: (@user.email_verified? ? :success : :warning) %>
      </div>
    </div>
  </div>
  <div class="page-actions">
    <% if admin_permissions_for(@user).manage? %>
      <%= link_to edit_admin_user_path(@user), class: "btn btn-primary" do %>
        <%= icon(:pencil) %>Edit user
      <% end %>
    <% end %>
    <% if @user.is_impersonatable?(current_user) && !impersonating? %>
      <%# Turbo is off on this form (the sign-in swap must be a real
          navigation), so the confirm goes through confirm-submit. %>
      <%= button_to impersonate_admin_user_path(@user), method: :post,
            class: "btn btn-secondary",
            form: { data: { turbo: false, controller: "confirm-submit", action: "submit->confirm-submit#submit",
                            confirm_submit_message_value: "Sign in as #{@user.full_name}? Everything you do is recorded under your name." } },
            local: true do %>
        <%= icon(:eye) %>Impersonate
      <% end %>
    <% end %>
  </div>
</header>

<div class="space-y-6">
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="card stat">
      <span class="stat-label">Total sessions</span>
      <span class="stat-value"><%= @user.user_sessions.count %></span>
    </div>
    <div class="card stat">
      <span class="stat-label">Active sessions</span>
      <span class="stat-value"><%= @user.user_sessions.not_expired.count %></span>
    </div>
    <div class="card stat">
      <span class="stat-label">Total visits</span>
      <span class="stat-value"><%= @user.visits.count %></span>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Profile</h2>
      </div>
      <div class="card-body">
        <dl class="dl">
          <%= dl_row "Preferred name", @user.full_name %>
          <% if @user.legal_name? %>
            <%= dl_row "Legal name", @user.legal_full_name %>
          <% end %>
          <%= dl_row "Email", @user.email %>
          <% if @user.pronouns.present? %>
            <%= dl_row "Pronouns", @user.pronouns %>
          <% end %>
          <% if @user.birthday.present? %>
            <%= dl_row "Birthday" do %><%= time_label(@user.birthday) %><% end %>
          <% end %>
          <% if @user.referral_source.present? || @user.referral_source_detail.present? %>
            <%= dl_row "Heard about Patchwork from", [User::REFERRAL_SOURCES[@user.referral_source], @user.referral_source_detail].compact_blank.join(": ") %>
          <% end %>
          <%= dl_row("Weave ID") do %>
            <span class="flex flex-wrap items-center justify-between gap-2">
              <span class="mono"><%= @user.p_id %></span>
              <% if current_user.owner? %>
                <%= button_to "Regenerate", regen_pid_admin_user_path(@user), method: :patch,
                      class: "btn btn-danger btn-sm",
                      data: { turbo_confirm: "Give #{@user.full_name} a new Weave ID? The old ID stops working everywhere. This cannot be undone." } %>

              <% end %>
            </span>
          <% end %>
          <%= dl_row "Created" do %><%= time_label(@user.created_at, :datetime) %><% end %>
          <%= dl_row "Last sign-in" do %><%= time_label(@user.last_login_at, :datetime) || "Never" %><% end %>
          <%= dl_row "Last seen" do %><%= time_label(@user.last_seen_at, :relative) || "Never" %><% end %>
        </dl>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Access</h2>
      </div>
      <div class="card-body space-y-6">
        <dl class="dl">
          <%= dl_row("Access level") { badge @user.role.titleize, tone: role_tone } %>
        </dl>

        <div>
          <h3 class="section-title">Code of conduct</h3>
          <p class="record-meta">
            <% if @user.slack_coc_accepted_at.present? %>
              Accepted <%= time_label(@user.slack_coc_accepted_at) %>.
            <% elsif @user.code_of_conduct_exempt %>
              Not accepted. This user is exempt, so they can use apps anyway.
            <% else %>
              Not accepted. This user can only use apps that are opted out of the Code of Conduct.
            <% end %>
          </p>
          <% if current_user.superadmin? && @user.slack_coc_accepted_at.nil? %>
            <%= button_to (@user.code_of_conduct_exempt ? "Remove the exemption" : "Exempt from the Code of Conduct"),
                  code_of_conduct_exemption_admin_user_path(@user),
                  method: :patch, params: { exempt: !@user.code_of_conduct_exempt }, class: "btn btn-secondary btn-sm",
                  form: { class: "mt-2" },
                  data: { turbo_confirm: @user.code_of_conduct_exempt ? "#{@user.full_name} will lose access to apps until they accept. Continue?" : "Let #{@user.full_name} use apps without accepting the Code of Conduct?" } %>
          <% end %>
        </div>

        <%= render "guardian_consent", user: @user %>
        <%= render "verification", user: @user %>
        <%= render "knot", user: @user %>

        <div>
          <h3 class="section-title">App access</h3>
          <% restricted_apps = Doorkeeper::Application.where.not(access_policy: "everyone").order(:name) %>
          <% if restricted_apps.any? %>
            <div class="record-list">
              <% restricted_apps.each do |application| %>
                <% decision = AppAccess.explain(@user, application) %>
                <div class="record">
                  <div class="record-main">
                    <div class="record-title flex flex-wrap items-center gap-2">
                      <%= badge (decision.permitted? ? "Yes" : "No"), tone: (decision.permitted? ? :success : :danger) %>
                      <%= link_to application.name, admin_oauth_application_path(application), class: "link-quiet" %>
                    </div>
                    <div class="record-meta"><%= decision %></div>
                  </div>
                </div>
              <% end %>
            </div>
            <p class="mt-3 field-hint">Apps not listed are open to everyone who can sign in and meets the Code of Conduct requirement.</p>
          <% else %>
            <p class="record-meta">Every app is open to everyone who can sign in.</p>
          <% end %>
        </div>

        <div>
          <h3 class="section-title">App roles</h3>
          <% held_roles = ApplicationRole.held_by(@user).includes(:application).sort_by { |role| [role.application.name, role.key] } %>
          <% if held_roles.any? %>
            <div class="record-list">
              <% held_roles.each do |role| %>
                <div class="record">
                  <div class="record-main">
                    <div class="record-title">
                      <%= link_to role.application.name, admin_oauth_application_path(role.application, anchor: "roles"), class: "link-quiet" %>
                      <span class="text-ink-soft font-normal"><%= role.name %></span>
                    </div>
                    <div class="record-meta"><code class="mono"><%= role.key %></code></div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="record-meta">No roles in any app</p>
          <% end %>
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Organization</h2>
      </div>
      <div class="card-body">
        <dl class="dl">
          <%= dl_row("Employment type") do %>
            <span class="flex flex-wrap gap-1.5">
              <% if @user.is_board %>
                <%= badge "Board", tone: :teal %>
              <% end %>
              <% if @user.is_staff %>
                <%= badge "Staff", tone: :sky %>
              <% end %>
              <% if @user.is_contractor %>
                <%= badge "Contractor", tone: :violet %>
              <% end %>
              <% unless @user.is_board || @user.is_staff || @user.is_contractor %>
                <span class="text-ink-faint">Community member</span>
              <% end %>
            </span>
          <% end %>
          <% if @user.manager.present? %>
            <%= dl_row("Manager") { link_to_if admin_permissions_for(@user.manager).view?, @user.manager.full_name, admin_user_path(@user.manager), class: "link" } %>
          <% end %>
          <% if @user.reports.any? %>
            <%= dl_row("Direct reports") do %>
              <span class="flex flex-wrap gap-x-3 gap-y-1">
                <% @user.reports.each do |report| %>
                  <%= link_to_if admin_permissions_for(report).view?, report.full_name, admin_user_path(report), class: "link" %>
                <% end %>
              </span>
            <% end %>
          <% end %>
          <%= dl_row("Groups") do %>
            <% memberships = @user.active_group_memberships.includes(:group).select(&:group).sort_by { |m| m.group.name } %>
            <% if memberships.any? %>
              <ul class="space-y-1">
                <% memberships.each do |membership| %>
                  <li>
                    <%= link_to membership.group.name, admin_group_path(membership.group), class: "link" %>
                    <% if membership.expires_at %>
                      <span class="text-xs text-ink-faint">until <%= time_label(membership.expires_at) %></span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <span class="text-ink-faint">Not in any group</span>
            <% end %>
          <% end %>
          <% @user.social_profiles.order(:provider).each do |profile| %>
            <%= dl_row(profile.provider_name) { external_link(profile.username, profile.profile_url) } %>
          <% end %>
        </dl>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title">Slack</h2>
          <p class="card-lede">Professional information, synced with Slack</p>
        </div>
      </div>
      <div class="card-body">
        <dl class="dl">
          <% if @user.slack_title.present? %>
            <%= dl_row "Job title", @user.slack_title %>
          <% end %>
          <% if @user.slack_department.present? %>
            <%= dl_row "Department", @user.slack_department %>
          <% end %>
          <% if @user.slack_division.present? %>
            <%= dl_row "Division", @user.slack_division %>
          <% end %>
          <% if @user.slack_organization.present? %>
            <%= dl_row "Organization", @user.slack_organization %>
          <% end %>
          <% if @user.slack_city.present? || @user.slack_state.present? || @user.slack_country.present? %>
            <%= dl_row "Location", [@user.slack_city, @user.slack_state, @user.slack_country].compact.join(", ") %>
          <% end %>
          <% if @user.slack_cost_center.present? %>
            <%= dl_row "Cost center", @user.slack_cost_center %>
          <% end %>
          <% if @user.slack_id.present? %>
            <%= dl_row("Slack ID") { tag.span(@user.slack_id, class: "mono") } %>
          <% end %>
          <%= dl_row("Slack membership") do %>
            <span class="flex flex-wrap items-center gap-2">
              <% if @user.slack_member? %>
                <%= badge "Full member", tone: :success %>
                <% if @user.slack_coc_accepted_at.present? %>
                  <span class="text-ink-faint text-xs">accepted CoC <%= time_label(@user.slack_coc_accepted_at) %></span>
                <% else %>
                  <%= badge "CoC pending", tone: :sky %>
                  <% if @user.slack_coc_requested_at.present? %>
                    <span class="text-ink-faint text-xs">asked <%= time_label(@user.slack_coc_requested_at) %></span>
                  <% end %>
                <% end %>
              <% elsif @user.in_slack_workspace? && @user.slack_coc_accepted_at.present? %>
                <%= badge "Guest · promotion pending", tone: :orchid %>
                <span class="text-ink-faint text-xs">accepted CoC <%= time_label(@user.slack_coc_accepted_at) %></span>
              <% elsif @user.in_slack_workspace? %>
                <%= badge "Guest · CoC pending", tone: :sky %>
                <% if @user.slack_invited_at.present? %>
                  <span class="text-ink-faint text-xs">invited <%= time_label(@user.slack_invited_at) %></span>
                <% end %>
              <% elsif @user.slack_invited_at.present? %>
                <%= badge "Invited · not joined yet", tone: :sky %>
                <span class="text-ink-faint text-xs">invited <%= time_label(@user.slack_invited_at) %></span>
              <% else %>
                <span class="text-ink-faint">Not invited yet</span>
              <% end %>
            </span>
            <% unless @user.in_slack_workspace? %>
              <%= button_to(@user.slack_invited_at.present? ? "Re-invite to Slack" : "Invite to Slack",
                    invite_to_slack_admin_user_path(@user), method: :post,
                    class: "btn btn-secondary btn-sm", form_class: "mt-2") %>
            <% end %>
          <% end %>
        </dl>
      </div>
    </section>
  </div>

  <%= render "thread_count", user: @user %>

  <% session_map_data = @user.user_sessions.filter_map(&:map_data) %>
  <% if session_map_data.any? %>
    <section class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title">Session locations</h2>
          <p class="card-lede">Geographic locations of this user's login sessions</p>
        </div>
      </div>
      <div class="card-body">
        <% content_for :head, javascript_include_tag("mapkick.bundle") %>
        <%= js_map session_map_data, height: "400px", zoom: 2 %>
        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-soft">
          <span class="flex items-center gap-2"><span class="w-3 h-3 bg-teal rounded-full"></span>Active sessions</span>
          <span class="flex items-center gap-2"><span class="w-3 h-3 bg-warning rounded-full"></span>Impersonated sessions</span>
          <span class="flex items-center gap-2"><span class="w-3 h-3 bg-ink-faint rounded-full"></span>Expired sessions</span>
        </div>
      </div>
    </section>
  <% end %>

  <%= render "admin/users/roles", user: @user %>

  <%= render "admin/users/impersonations", impersonations: @impersonations, action_counts: @impersonation_action_counts %>

  <%= render "admin/users/shipping_address_reads", reads: @shipping_address_reads %>

  <section class="card card-flush">
    <div class="card-header">
      <div>
        <h2 class="card-title">Sessions</h2>
        <p class="card-lede">Browser fingerprint and device information for this user's sessions</p>
      </div>
    </div>
    <% if @user.user_sessions.any? %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Status</th>
              <th>Device</th>
              <th>OS</th>
              <th>Location</th>
              <th>Created</th>
              <th>Last seen</th>
              <th>Fingerprint</th>
            </tr>
          </thead>
          <tbody>
            <% @user.user_sessions.includes(:impersonated_by).order(created_at: :desc).each do |session| %>
              <tr class="<%= "is-current" if !session.expired? && session.signed_out_at.nil? %>">
                <td class="whitespace-nowrap">
                  <% if session.expired? || session.signed_out_at %>
                    <%= badge "Expired" %>
                  <% else %>
                    <%= badge "Active", tone: :success %>
                  <% end %>
                  <% if session.impersonated? %>
                    <%= badge "Impersonated", tone: :warning %>
                  <% end %>
                </td>
                <td><%= session.device_info || "Unknown" %></td>
                <td class="text-ink-soft"><%= session.os_info || "Unknown" %></td>
                <td class="text-ink-soft">
                  <%= session.ip || "Unknown" %>
                  <% if session.latitude.present? && session.longitude.present? %>
                    <span class="table-sub"><%= session.location_name %></span>
                  <% end %>
                  <% if session.timezone.present? %>
                    <span class="table-sub"><%= session.timezone %></span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap text-ink-soft"><%= time_label(session.created_at, :datetime) %></td>
                <td class="whitespace-nowrap text-ink-soft">
                  <%= time_label(session.last_seen_at, :relative) || "Never" %>
                </td>
                <td>
                  <% if session.fingerprint %>
                    <span class="mono truncate block w-24 text-ink-soft" title="<%= session.fingerprint %>"><%= session.fingerprint %></span>
                  <% else %>
                    <span class="text-ink-faint">Unknown</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state "No sessions found for this user.", icon: :monitor_smartphone %>
    <% end %>
  </section>
</div>

<%# The member's Thread Count, the internal trust score (see ThreadCount).
    Staff only, and never on your own page: nobody sees their own score. %>
<% if user != current_user %>
  <section class="card">
    <div class="card-header">
      <div>
        <h2 class="card-title">Thread Count</h2>
        <p class="card-lede">Internal trust score. Never share it with the member.</p>
      </div>
      <%= link_to admin_user_thread_count_path(user), class: "btn btn-secondary btn-sm" do %>
        Open Thread Count<%= icon(:arrow_right) %>
      <% end %>
    </div>
    <div class="card-body">
      <span class="stat-value"><%= thread_count_number(ThreadCount.score(user)) %></span>
    </div>
  </section>
<% end %>

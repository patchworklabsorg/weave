<%# A member's parent or guardian consent (see GuardianConsent), on the admin
    user page. Shown for members under 18 and for anyone with a consent on
    file. %>
<% consents = user.guardian_consents.order(created_at: :desc).to_a %>
<% if user.minor? || consents.any? %>
  <% current = consents.find { |consent| consent.pending? || consent.granted? } %>
  <% can_manage = admin_permissions_for(user).manage? %>
  <div class="mb-4 pb-4 border-b border-ink-soft/10">
    <p class="text-sm font-medium text-ink">Guardian consent</p>
    <p class="text-xs text-ink-faint mt-1">
      <% if !user.minor? %>
        Not needed: this member is 18 or older, or has no birthday on file.
      <% elsif current&.granted? %>
        Granted <%= current.granted_at.strftime("%b %-d, %Y") %> by <%= current.signed_name %> (<%= current.guardian_email %>)<%= current.offline? ? ", recorded offline by #{current.recorded_by&.full_name || 'a deleted user'}" : "" %>.
      <% elsif current&.pending? %>
        Requested from <%= current.guardian_name %> (<%= current.guardian_email %>) on <%= current.sent_at.strftime("%b %-d, %Y") %>.
        <%= current.link_expired? ? "The link has expired." : "Waiting for the guardian." %>
        This member can't join the Slack or use apps that require guardian consent.
      <% else %>
        Not requested yet. This member can't join the Slack or use apps that require guardian consent.
      <% end %>
    </p>

    <div class="flex flex-wrap gap-2 mt-2">
      <% if current&.pending? && can_manage %>
        <%= button_to "Send the request again", resend_admin_user_guardian_consent_path(user, current),
              class: "btn-stitch-ghost" %>
      <% end %>
      <% if current&.granted? && current_user.superadmin? && can_manage %>
        <%= button_to "Revoke consent", revoke_admin_user_guardian_consent_path(user, current), method: :patch,
              class: "btn-stitch-ghost",
              data: { turbo_confirm: "#{user.full_name} will lose access to apps that require guardian consent. Continue?" } %>
      <% end %>
    </div>

    <% if user.guardian_consent_missing? && current_user.superadmin? && can_manage && user != current_user %>
      <details class="mt-3">
        <summary class="text-xs text-grape cursor-pointer">Record consent given offline</summary>
        <%= form_with url: admin_user_guardian_consents_path(user), method: :post, class: "mt-2 space-y-2" do |form| %>
          <%= form.text_field :guardian_name, placeholder: "Guardian's full name", required: true, maxlength: 100,
                aria: { label: "Guardian's full name" }, class: "w-full px-3 py-2 rounded-lg border-2 border-neutral-300 bg-paper text-sm" %>
          <%= form.email_field :guardian_email, placeholder: "Guardian's email", required: true, maxlength: 100,
                aria: { label: "Guardian's email" }, class: "w-full px-3 py-2 rounded-lg border-2 border-neutral-300 bg-paper text-sm" %>
          <%= form.text_area :note, placeholder: "Where is the signed form?", required: true, rows: 2,
                aria: { label: "Where is the signed form?" }, class: "w-full px-3 py-2 rounded-lg border-2 border-neutral-300 bg-paper text-sm" %>
          <%= form.submit "Record consent", class: "btn-stitch-ghost",
                data: { turbo_confirm: "Record that a parent or guardian gave consent for #{user.full_name}?" } %>
        <% end %>
      </details>
    <% end %>

    <% if consents.size > 1 %>
      <details class="mt-3">
        <summary class="text-xs text-ink-faint cursor-pointer">History</summary>
        <ul class="mt-2 space-y-1 text-xs text-ink-faint">
          <% consents.each do |consent| %>
            <li><%= consent.created_at.strftime("%b %-d, %Y") %>: <%= consent.status %>, <%= consent.guardian_email %></li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </div>
<% end %>

<%# A member's parent or guardian consent (see GuardianConsent), on the admin
    user page. Shown for members under 18 and for anyone with a consent on
    file. %>
<% consents = user.guardian_consents.order(created_at: :desc).to_a %>
<% if user.minor? || consents.any? %>
  <% current = consents.find { |consent| consent.pending? || consent.granted? } %>
  <% can_manage = admin_permissions_for(user).manage? %>
  <div class="space-y-2">
    <h3 class="section-title">Guardian consent</h3>
    <p class="record-meta">
      <% if !user.minor? %>
        Not needed: this member is 18 or older, or has no birthday on file.
      <% elsif current&.granted? %>
        Granted <%= time_label(current.granted_at) %> by <%= current.signed_name %> (<%= current.guardian_email %>)<%= current.offline? ? ", recorded offline by #{current.recorded_by&.full_name || 'a deleted user'}" : "" %>.
      <% elsif current&.pending? %>
        Requested from <%= current.guardian_name %> (<%= current.guardian_email %>) on <%= time_label(current.sent_at) %>.
        <%= current.link_expired? ? "The link has expired." : "Waiting for the guardian." %>
        This member can't join the Slack or use apps that require guardian consent.
      <% else %>
        Not requested yet. This member can't join the Slack or use apps that require guardian consent.
      <% end %>
    </p>

    <% if current&.granted? %>
      <p class="record-meta">
        <% if current.verified? %>
          Verified guardian: <%= time_label(current.verified_at) %> by <%= current.verified_by&.full_name || "a deleted user" %>. <%= current.verification_note %>
        <% else %>
          Not verified. Apps that ask for a verified guardian (for example Krater budgets) will refuse this member.
        <% end %>
      </p>
      <% if !current.verified? && current_user.superadmin? && can_manage %>
        <details>
          <summary class="link text-sm cursor-pointer">Record a verified guardian</summary>
          <%= form_with url: verify_admin_user_guardian_consent_path(user, current), method: :patch, class: "well mt-2 space-y-2" do |form| %>
            <p class="field-hint">You need a signed guardian form and a call or video check with the guardian.</p>
            <%= form.text_area :note, required: true, rows: 2, placeholder: "Where is the signed form? How and when did you speak with the guardian?",
                  aria: { label: "Where is the signed form, and how did you speak with the guardian?" },
                  class: "field field-sm" %>
            <%= form.submit "Record verified guardian", class: "btn btn-secondary btn-sm",
                  data: { turbo_confirm: "Record that you have a signed form and spoke with #{current.guardian_name}?" } %>
          <% end %>
        </details>
      <% end %>
    <% end %>

    <% if current&.granted? && current.flags.any? %>
      <% if current.reviewed_at %>
        <p class="record-meta">
          Checked <%= time_label(current.reviewed_at) %> by <%= current.reviewed_by&.full_name || "a deleted user" %>: <%= current.review_note %>
        </p>
      <% else %>
        <div class="callout callout-warning">
          <%= icon(:triangle_alert, size: 18) %>
          <div class="callout-body text-sm">
            Needs a check: <%= current.flags.map { |flag| GuardianConsentSignals.describe(flag) }.join(" ") %>
            <%= link_to "Open the review queue", admin_guardian_consents_path, class: "link" %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if (current&.pending? && can_manage) || (current&.granted? && current_user.superadmin? && can_manage) %>
      <div class="btn-row">
        <% if current&.pending? && can_manage %>
          <%= button_to "Send the request again", resend_admin_user_guardian_consent_path(user, current),
                class: "btn btn-secondary btn-sm" %>
        <% end %>
        <% if current&.granted? && current_user.superadmin? && can_manage %>
          <%= button_to "Revoke consent", revoke_admin_user_guardian_consent_path(user, current), method: :patch,
                class: "btn btn-danger btn-sm",
                data: { turbo_confirm: "#{user.full_name} will lose access to apps that require guardian consent. Continue?" } %>
        <% end %>
      </div>
    <% end %>

    <% if user.guardian_consent_missing? && current_user.superadmin? && can_manage && user != current_user %>
      <details>
        <summary class="link text-sm cursor-pointer">Record consent given offline</summary>
        <%= form_with url: admin_user_guardian_consents_path(user), method: :post, class: "well mt-2 space-y-2" do |form| %>
          <%= form.text_field :guardian_name, placeholder: "Guardian's full name", required: true, maxlength: 100,
                aria: { label: "Guardian's full name" }, class: "field field-sm" %>
          <%= form.email_field :guardian_email, placeholder: "Guardian's email", required: true, maxlength: 100,
                aria: { label: "Guardian's email" }, class: "field field-sm" %>
          <%= form.text_area :note, placeholder: "Where is the signed form?", required: true, rows: 2,
                aria: { label: "Where is the signed form?" }, class: "field field-sm" %>
          <%= form.submit "Record consent", class: "btn btn-secondary btn-sm",
                data: { turbo_confirm: "Record that a parent or guardian gave consent for #{user.full_name}?" } %>
        <% end %>
      </details>
    <% end %>

    <% if consents.size > 1 %>
      <details>
        <summary class="link text-sm cursor-pointer">History</summary>
        <ul class="well mt-2 space-y-1 text-xs text-ink-soft">
          <% consents.each do |consent| %>
            <li><%= time_label(consent.created_at) %>: <%= consent.status %>, <%= consent.guardian_email %></li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </div>
<% end %>

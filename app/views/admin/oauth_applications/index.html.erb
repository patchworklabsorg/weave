<% content_for :title, "OAuth apps" %>

<%= page_header("OAuth applications", lede: "Manage OAuth 2.0 client applications") do %>
  <%= link_to new_admin_oauth_application_path, class: "btn btn-primary" do %><%= icon(:plus) %>New OAuth app<% end %>
<% end %>

<div class="card card-flush">
  <div class="card-header">
    <h2 class="card-title">All applications</h2>
    <%= render "shared/search_form", url: admin_oauth_applications_path, frame: "oauth_applications_table", placeholder: "Search applications" %>
  </div>

  <%= turbo_frame_tag "oauth_applications_table", target: "_top" do %>
    <% if params[:search].present? %>
      <p class="px-5 py-3 text-sm text-ink-soft border-b border-hairline">
        <%= pluralize(@applications.size, "application") %> <%= @applications.size == 1 ? "matches" : "match" %> “<%= params[:search] %>”
      </p>
    <% end %>

    <% if @applications.any? %>
      <div class="table-wrap overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Client ID</th>
              <th scope="col">Type</th>
              <th scope="col">Scopes</th>
              <th scope="col">Created</th>
              <th scope="col" class="actions"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @applications.each do |application| %>
              <tr>
                <td class="font-medium">
                  <%= link_to application.name, admin_oauth_application_path(application), class: "link-quiet" %>
                </td>
                <td>
                  <span class="mono block max-w-48 truncate" title="<%= application.uid %>"><%= application.uid %></span>
                </td>
                <td>
                  <div class="flex flex-wrap gap-1">
                    <%= badge(application.confidential? ? "Confidential" : "Public", tone: application.confidential? ? :info : :neutral) %>
                    <% if AppAccess.restricted?(application) %>
                      <%= badge "Restricted", tone: :orchid %>
                    <% end %>
                    <% unless application.requires_code_of_conduct %>
                      <%= badge "CoC optional", tone: :sky %>
                    <% end %>
                    <% unless application.requires_guardian_consent %>
                      <%= badge "Guardian consent optional", tone: :sky %>
                    <% end %>
                  </div>
                </td>
                <td class="min-w-48">
                  <% if application.scopes.present? %>
                    <ul class="flex flex-wrap gap-1" aria-label="Scopes">
                      <% application.scopes.all.each do |scope| %>
                        <li class="badge badge-teal"><%= scope %></li>
                      <% end %>
                    </ul>
                  <% else %>
                    <span class="text-ink-faint">Default</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap text-ink-soft">
                  <%= time_label(application.created_at, :relative) %>
                </td>
                <td class="actions">
                  <%= link_to "View", admin_oauth_application_path(application), class: "btn btn-quiet btn-sm" %>
                  <% if current_user.superadmin? %>
                    <%= link_to "Edit", edit_admin_oauth_application_path(application), class: "btn btn-quiet btn-sm" %>
                  <% end %>
                  <% if current_user.owner? %>
                    <%= button_to "Delete", admin_oauth_application_path(application), method: :delete,
                        class: "btn btn-danger btn-sm", form_class: "inline-block",
                        data: { turbo_confirm: "Delete #{application.name}? This revokes every access token for this application." } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% elsif params[:search].present? %>
      <%= empty_state("No OAuth applications match “#{params[:search]}”", body: "Search by name, client ID or redirect URI.", icon: :search) %>
    <% else %>
      <%= empty_state("No OAuth applications found",
            body: "Create your first OAuth application to allow external services to authenticate users.", icon: :shield_check) do %>
        <%= link_to "Create your first OAuth application", new_admin_oauth_application_path, class: "btn btn-secondary" %>
      <% end %>
    <% end %>
  <% end %>
</div>

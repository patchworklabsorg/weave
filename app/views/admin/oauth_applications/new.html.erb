<% content_for :title, "New OAuth app" %>

<div class="page-narrow mx-auto">
  <%= page_header("New OAuth application", lede: "Create a new OAuth 2.0 client application") %>

  <%= form_with model: @application, url: admin_oauth_applications_path, local: true, data: { turbo: false }, class: "card" do |form| %>
    <div class="card-body space-y-5">
      <%= form_errors(@application) %>

      <div class="field-group">
        <%= form.label :name, class: "field-label" %>
        <%= form.text_field :name, class: "field", placeholder: "My Application" %>
        <p class="field-hint">A human-readable name for your application.</p>
      </div>

      <div class="field-group">
        <%= form.label :redirect_uri, "Redirect URIs", class: "field-label" %>
        <%= form.text_area :redirect_uri, rows: 4, class: "field",
            placeholder: "https://yourapp.com/auth/callback\nhttps://yourapp.com/oauth/callback" %>
        <p class="field-hint">
          One URI per line. These are the only URIs your application can redirect to after authorization.
        </p>
      </div>

      <div class="field-group">
        <%= form.label :scopes, class: "field-label" %>
        <%= form.text_field :scopes, class: "field", placeholder: "profile email",
            value: form.object.scopes || "profile email" %>
        <p class="field-hint">
          Space-separated list of scopes. Available:
          <code class="code-chip">profile</code> (basic user info),
          <code class="code-chip">email</code> (user email address),
          <code class="code-chip">admin</code> (administrative access),
          <code class="code-chip">slack</code> (Slack membership and Slack ID),
          <code class="code-chip">groups</code> (the user's groups that are linked to this app),
          <code class="code-chip">roles</code> (the user's roles in this app).
          App tokens only (<code class="code-chip">client_credentials</code>):
          <code class="code-chip">directory</code> (the directory API),
          <code class="code-chip">fulfillment</code> (read a shipping address to print a label),
          <code class="code-chip">quilt</code> (the Quilt patch API),
          <code class="code-chip">introspect</code> (check the app tokens of other apps, superadmin only).
          Leave empty to use defaults.
        </p>
      </div>

      <label class="choice">
        <%= form.check_box :confidential, class: "checkbox", checked: true %>
        <span>
          Confidential Application
          <span class="choice-hint">
            Confidential applications can securely store client secrets (recommended for server-side apps).
            Uncheck for public applications like mobile apps or SPAs.
          </span>
        </span>
      </label>

      <div class="form-actions">
        <%= link_to "Cancel", admin_oauth_applications_path, class: "btn btn-secondary" %>
        <%= form.submit "Create app", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>

<% content_for :title, "Edit #{@application.name}" %>

<div class="mb-6">
  <div class="flex justify-between items-center mb-4">
    <div>
      <h2 class="font-display text-2xl font-bold text-ink">Edit OAuth Application</h2>
      <p class="text-ink-soft">Update <%= @application.name %> configuration</p>
    </div>
    <div class="flex space-x-3">
      <%= link_to "Back to Application", admin_oauth_application_path(@application), class: "btn-stitch-ghost" %>
      <%= link_to "All Applications", admin_oauth_applications_path, class: "btn-stitch-ghost" %>
    </div>
  </div>
</div>

<div class="max-w-2xl">
  <div class="patch p-6">
    <%= form_with model: @application, url: admin_oauth_application_path(@application), method: :patch, local: true, class: "space-y-6" do |form| %>
      <% if @application.errors.any? %>
        <div class="patch border-2 border-orchid bg-orchid-soft/40 text-ink p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-orchid" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-orchid">
                There were <%= pluralize(@application.errors.count, "error") %> with your submission:
              </h3>
              <div class="mt-2 text-sm text-ink">
                <ul class="list-disc pl-5 space-y-1">
                  <% @application.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div>
        <%= form.label :name, class: "block text-sm font-medium text-ink" %>
        <%= form.text_field :name,
            class: "mt-1 w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
        <p class="mt-2 text-sm text-ink-faint">A human-readable name for your application.</p>
      </div>

      <div>
        <%= form.label :redirect_uri, "Redirect URIs", class: "block text-sm font-medium text-ink" %>
        <%= form.text_area :redirect_uri,
            rows: 4,
            class: "mt-1 w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint" %>
        <p class="mt-2 text-sm text-ink-faint">
          One URI per line. These are the only URIs your application can redirect to after authorization.
        </p>
      </div>

      <div>
        <%= form.label :scopes, class: "block text-sm font-medium text-ink" %>
        <%= form.text_field :scopes,
            class: "mt-1 w-full px-4 py-3 rounded-lg border-2 border-neutral-300 bg-paper text-ink focus:ring-2 focus:ring-grape focus:border-grape transition-colors placeholder-ink-faint",
            placeholder: "profile email" %>
        <p class="mt-2 text-sm text-ink-faint">
          Space-separated list of scopes. Available: <code>profile</code>, <code>email</code>, <code>admin</code>, <code>slack</code>.
          Leave empty to use defaults.
        </p>
      </div>

      <div>
        <div class="flex items-center">
          <%= form.check_box :confidential,
              class: "h-4 w-4 rounded border-2 border-neutral-300 text-grape focus:ring-grape" %>
          <%= form.label :confidential, "Confidential Application", class: "ml-2 block text-sm text-ink" %>
        </div>
        <p class="mt-2 text-sm text-ink-faint">
          Confidential applications can securely store client secrets (recommended for server-side apps).
          Uncheck for public applications like mobile apps or SPAs.
        </p>
      </div>

      <div class="border-t-2 border-dashed border-ink-soft/30 pt-6">
        <div class="bg-amber-50 border border-amber-200 rounded-md p-4 mb-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-amber-800">
                Warning
              </h3>
              <div class="mt-2 text-sm text-amber-700">
                Changing the application configuration may affect existing integrations.
                Make sure to update your application code accordingly.
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="flex justify-end space-x-3">
        <%= link_to "Cancel", admin_oauth_application_path(@application), class: "btn-stitch-ghost" %>
        <%= form.submit "Update Application", class: "btn-stitch" %>
      </div>
    <% end %>
  </div>
</div>

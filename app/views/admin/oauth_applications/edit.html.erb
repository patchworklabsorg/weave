<% content_for :title, "Edit #{@application.name}" %>

<div class="page-narrow mx-auto">
  <header class="page-header">
    <div>
      <p class="text-sm"><%= link_to @application.name, admin_oauth_application_path(@application), class: "link-quiet text-ink-soft" %></p>
      <h1 class="page-title">Edit OAuth application</h1>
      <p class="page-lede">Update <%= @application.name %> configuration</p>
    </div>
  </header>

  <%= form_with model: @application, url: admin_oauth_application_path(@application), method: :patch, local: true, class: "card" do |form| %>
    <div class="card-body space-y-5">
      <%= form_errors(@application) %>

      <div class="field-group">
        <%= form.label :name, class: "field-label" %>
        <%= form.text_field :name, class: "field" %>
        <p class="field-hint">A human-readable name for your application.</p>
      </div>

      <div class="field-group">
        <%= form.label :redirect_uri, "Redirect URIs", class: "field-label" %>
        <%= form.text_area :redirect_uri, rows: 4, class: "field" %>
        <p class="field-hint">
          One URI per line. These are the only URIs your application can redirect to after authorization.
        </p>
      </div>

      <div class="field-group">
        <%= form.label :scopes, class: "field-label" %>
        <%= form.text_field :scopes, class: "field", placeholder: "profile email" %>
        <p class="field-hint">
          Space-separated list of scopes. Available: <code class="code-chip">profile</code>, <code class="code-chip">email</code>, <code class="code-chip">admin</code>, <code class="code-chip">slack</code>, <code class="code-chip">groups</code>, <code class="code-chip">roles</code>.
          App tokens only: <code class="code-chip">directory</code>, <code class="code-chip">quilt</code>, <code class="code-chip">introspect</code> (superadmin only).
          Leave empty to use defaults.
        </p>
      </div>

      <label class="choice">
        <%= form.check_box :confidential, class: "checkbox" %>
        <span>
          Confidential Application
          <span class="choice-hint">
            Confidential applications can securely store client secrets (recommended for server-side apps).
            Uncheck for public applications like mobile apps or SPAs.
          </span>
        </span>
      </label>

      <%= render "launcher_fields", form: form %>

      <div class="callout callout-warning">
        <%= icon(:triangle_alert, size: 18) %>
        <div class="callout-body">
          <p class="callout-title">Warning</p>
          <p>
            Changing the application configuration may affect existing integrations.
            Make sure to update your application code accordingly.
          </p>
        </div>
      </div>

      <div class="form-actions">
        <%= link_to "Cancel", admin_oauth_application_path(@application), class: "btn btn-secondary" %>
        <%= form.submit "Save changes", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>

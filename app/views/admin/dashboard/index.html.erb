<% content_for :title, "Dashboard" %>

<%= page_header "Dashboard", lede: "Accounts at a glance, and the tools you reach for most." %>

<div class="space-y-6">
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="card stat">
      <span class="stat-label">Total users</span>
      <span class="stat-value"><%= @users_count %></span>
    </div>
    <div class="card stat">
      <span class="stat-label">Admins</span>
      <span class="stat-value"><%= @admin_count %></span>
    </div>
    <div class="card stat">
      <span class="stat-label">Online now</span>
      <span class="stat-value"><%= User.currently_online.count %></span>
    </div>
  </div>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Quick actions</h2>
    </div>
    <div class="card-body">
      <div class="record-list">
        <% [
          ["Manage users", admin_users_path, :users, "Search, view, edit and impersonate accounts"],
          ["OAuth apps", admin_oauth_applications_path, :app_window, "Apps that sign in with Weave"],
          ["Query the database", "/admin/blazer", :database, "Blazer queries and dashboards"],
          ["Feature flags", "/admin/flipper", :flag, "Turn features on for users or groups"]
        ].each do |title, path, icon_name, meta| %>
          <%= link_to path, class: "record link-quiet" do %>
            <span class="flex items-center gap-3 min-w-0 flex-1">
              <span class="text-grape"><%= icon(icon_name, size: 18) %></span>
              <span class="record-main">
                <span class="record-title block"><%= title %></span>
                <span class="record-meta block"><%= meta %></span>
              </span>
            </span>
            <%= icon(:chevron_right, class: "text-ink-faint") %>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
</div>

<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-display text-2xl font-bold text-ink">Admin Dashboard</h1>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Stats Cards -->
    <div class="bg-paper overflow-hidden shadow-lg shadow-grape/10 rounded-lg border border-violet/20">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="text-lg font-medium text-ink-soft">Total Users</div>
          </div>
        </div>
        <div class="mt-1 text-3xl font-semibold text-grape">
          <%= @users_count %>
        </div>
      </div>
    </div>

    <div class="bg-paper overflow-hidden shadow-lg shadow-grape/10 rounded-lg border border-violet/20">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="text-lg font-medium text-ink-soft">Admins</div>
          </div>
        </div>
        <div class="mt-1 text-3xl font-semibold text-grape">
          <%= @admin_count %>
        </div>
      </div>
    </div>

    <div class="bg-paper overflow-hidden shadow-lg shadow-grape/10 rounded-lg border border-violet/20">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="text-lg font-medium text-ink-soft">Active Sessions</div>
          </div>
        </div>
        <div class="mt-1 text-3xl font-semibold text-grape">
          <%= User.currently_online.count %>
        </div>
      </div>
    </div>
  </div>

    <!-- Quick Actions -->
    <div class="bg-paper shadow-lg shadow-grape/10 rounded-lg border border-violet/20">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="font-display text-lg leading-6 font-medium text-ink mb-4">Quick Actions</h3>
        <div class="space-y-2">
          <%= link_to "Manage Users", admin_users_path,
              class: "block w-full text-left px-4 py-2 text-sm text-grape hover:bg-grape-soft hover:text-ink rounded transition-colors" %>
          <%= link_to "OAuth Applications", admin_oauth_applications_path,
              class: "block w-full text-left px-4 py-2 text-sm text-grape hover:bg-grape-soft hover:text-ink rounded transition-colors" %>
          <%= link_to "Query Database Data", '/admin/blazer',
              class: "block w-full text-left px-4 py-2 text-sm text-grape hover:bg-grape-soft hover:text-ink rounded transition-colors" %>
          <%= link_to "Feature Flags", '/admin/flipper',
              class: "block w-full text-left px-4 py-2 text-sm text-grape hover:bg-grape-soft hover:text-ink rounded transition-colors" %>
        </div>
      </div>
    </div>
  </div>
</div>

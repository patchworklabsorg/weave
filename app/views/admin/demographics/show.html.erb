<%# Demographics aggregates (see Admin::DemographicsController). Counts only,
    after small-count suppression. Nothing here names or links to a member. %>
<% content_for :title, "Demographics" %>

<header class="page-header">
  <div>
    <h1 class="page-title">Demographics for funder reports</h1>
    <p class="page-lede">
      Members answer these questions themselves. Weave encrypts each answer with a key that the web app does not have,
      so nobody can see one member's answers here or anywhere else. This page shows only the totals from the latest
      reporting run. Counts from 1 to <%= @threshold - 1 %> are hidden, and so is one more count when only one count
      in a question is hidden.
    </p>
    <p class="mt-2 text-sm">
      <%= link_to t("demographics.data_page_link"), Weave.data_page_url, target: "_blank", rel: "noopener noreferrer", class: "link" %>
    </p>
  </div>
</header>

<div class="space-y-6">
  <% if @report.nil? %>
    <section class="card">
      <%= empty_state("No report yet.", icon: :chart_column) %>
    </section>
  <% else %>
    <% sections = [["Current members", @report.active]] + @report.departed.map { |cohort, data| ["Members who left (#{cohort})", data] } %>
    <p class="text-sm text-ink-soft">
      Report from <%= time_label(@report.generated_at, :datetime) %>.
    </p>
    <% if @report.unreadable_count.positive? %>
      <div class="callout callout-warning">
        <%= icon(:triangle_alert, size: 18) %>
        <div class="callout-body">
          <p class="callout-title"><%= @report.unreadable_count %> envelopes could not be opened with the key of this run.</p>
        </div>
      </div>
    <% end %>

    <% sections.each do |title, data| %>
      <section class="card">
        <div class="card-header">
          <div>
            <h2 class="card-title"><%= title %></h2>
            <p class="card-lede">Respondents: <%= demographic_count(data["respondents"], @report.threshold) %></p>
          </div>
        </div>
        <div class="card-body space-y-6">
          <% data.fetch("fields", {}).each do |field, counts| %>
            <div class="table-wrap rounded-lg border border-hairline">
              <table class="table">
                <caption class="px-4 py-2 text-left text-sm font-semibold text-ink"><%= demographic_field_label(field) %></caption>
                <thead>
                  <tr>
                    <th scope="col">Answer</th>
                    <th scope="col" class="num">Count</th>
                  </tr>
                </thead>
                <tbody>
                  <% counts.each do |value, count| %>
                    <tr>
                      <td><%= demographic_option_label(field, value) %></td>
                      <td class="num"><%= demographic_count(count, @report.threshold) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>

  <section class="card">
    <div class="card-header">
      <div>
        <h2 class="card-title">Make a new report</h2>
        <p class="card-lede">
          The web app cannot make a report, because it does not have the private key. A key holder runs
          <code class="code-chip">bin/rails demographics:report</code> with the key in <code class="code-chip">WEAVE_DEMOGRAPHICS_PRIVATE_KEY_FILE</code>.
          The <%= link_to "KYC guide", "https://github.com/patchworklabsorg/weave/blob/main/docs/KYC.md", class: "link", target: "_blank", rel: "noopener noreferrer" %> has the steps.

        </p>
      </div>
    </div>
    <% if @runs.any? %>
      <div class="card-body">
        <div class="record-list">
          <% @runs.each do |generated_at, run_by| %>
            <div class="record">
              <div class="record-main text-sm text-ink-soft"><%= time_label(generated_at, :datetime) %><%= " by #{run_by}" if run_by.present? %></div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
</div>
